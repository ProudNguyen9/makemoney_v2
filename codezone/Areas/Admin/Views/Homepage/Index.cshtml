@model ScrapWebsite.Areas.Admin.ViewModels.Data.AdminSettingsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Trang chủ";
    ViewData["AdminSection"] = "homepage";
    ViewData["AdminSubSection"] = "";
}

<div class="admin-page-head">
  <h1>Cấu hình trang chủ <small>Nội dung riêng của trang chủ và ảnh thương hiệu</small></h1>
  <div class="aph-actions">
    <button class="btn btn-outline-dark" type="submit" form="homepageSettingsForm"><i class="bi bi-check-lg" aria-hidden="true"></i> Lưu nội dung</button>
    <button class="btn btn-primary" type="submit" form="brandAssetsForm"><i class="bi bi-check-lg" aria-hidden="true"></i> Lưu ảnh</button>
  </div>
</div>

<div class="admin-panel">
  <div class="panel-body">
    <p class="small text-muted mb-0">Thông tin công ty, hotline, Zalo, địa chỉ và khu vực thu mua được quản lý tại tab Cài đặt để tránh trùng dữ liệu.</p>
  </div>
</div>

<section class="admin-panel">
  <div class="panel-head"><h2>Nội dung trang chủ</h2></div>
  <form id="homepageSettingsForm" class="panel-body" action="/admin/homepage/SaveHomepageSettings" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label-tech" for="hpPriceUpdated">Dòng cập nhật bảng giá</label>
        <input class="form-control" id="hpPriceUpdated" name="PriceUpdatedText" type="text" value="@Model.PriceUpdatedText" maxlength="80">
        <small class="text-muted">Ví dụ: @DateTime.Today.ToString("dd/MM/yyyy") hoặc "hôm nay".</small>
      </div>
      <div class="col-md-6">
        <label class="form-label-tech" for="hpResponseTime">Thời gian phản hồi</label>
        <input class="form-control" id="hpResponseTime" name="ResponseTimeText" type="text" value="@Model.ResponseTimeText" maxlength="80">
        <small class="text-muted">Hiển thị trong cụm gọi/Zalo ở trang chủ.</small>
      </div>
    </div>
  </form>
</section>

<section class="admin-panel mb-0">
  <div class="panel-head"><h2>Ảnh thương hiệu</h2></div>
  <form id="brandAssetsForm" class="panel-body" action="/admin/homepage/SaveBrandAssets" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="media-grid">
      <div class="media-item">
        <span class="media-thumb"><img id="logoPreview" src="@Model.LogoUrl" alt="Logo chính" loading="lazy"></span>
        <div class="media-meta">
          <strong>Logo chính</strong>
          <input class="form-control form-control-sm mt-2 js-image-preview-input" type="file" name="LogoFile" accept="image/*" data-preview-target="logoPreview" data-name-target="logoFileName">
          <small>PNG, JPG, WebP - dùng cho header.</small>
        </div>
      </div>
      <div class="media-item">
        <span class="media-thumb"><img id="footerLogoPreview" src="@Model.FooterLogoUrl" alt="Logo footer" loading="lazy"></span>
        <div class="media-meta">
          <strong>Logo footer</strong>
          <input class="form-control form-control-sm mt-2 js-image-preview-input" type="file" name="FooterLogoFile" accept="image/*" data-preview-target="footerLogoPreview" data-name-target="footerLogoFileName">
          <small>PNG, JPG, WebP - dùng cho chân trang.</small>
        </div>
      </div>
    </div>
  </form>
</section>
