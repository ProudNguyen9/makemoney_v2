@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Menu";
    ViewData["AdminSection"] = "menu";
    ViewData["AdminSubSection"] = "";
}

<!-- backend: POST /admin/menu-items — thêm mục menu; PUT /admin/menu-items/{id} — sửa thứ tự / menu cha -->
      <div class="admin-page-head">
        <h1>Menu<small>Cấu trúc menu header &amp; footer</small></h1>
        <div class="aph-actions">
          <button class="btn btn-primary" type="submit" form="menuForm"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm mục menu</button>
        </div>
      </div>

      <form id="menuForm" action="#" method="post">
        <div class="admin-form-grid">
          <div>
            <!-- Menu Header -->
            <div class="admin-panel">
              <div class="panel-head">
                <h2>Menu Header</h2>
                <div class="panel-head-actions">
                  <span class="small text-muted">6 mục</span>
                </div>
              </div>
              <div class="table-admin-wrap">
                <table class="table table-admin align-middle">
                  <thead>
                    <tr>
                      <th>Nhãn</th>
                      <th>Link</th>
                      <th>Menu cha</th>
                      <th>Thứ tự</th>
                      <th><span class="visually-hidden">Thao tác</span></th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><strong>Trang chủ</strong></td>
                      <td><code>index.html</code></td>
                      <td>
                        <select class="form-select form-select-sm" aria-label="Menu cha của Trang chủ">
                          <option selected>—</option>
                          <option>Giới thiệu</option>
                          <option>Phế liệu thu mua</option>
                        </select>
                      </td>
                      <td><input class="form-control form-control-sm" type="number" min="0" value="1" aria-label="Thứ tự mục Trang chủ"></td>
                      <td>
                        <div class="ta-actions">
                          <button type="button" aria-label="Sửa mục Trang chủ"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                          <button class="act-danger" type="button" aria-label="Xóa mục Trang chủ"><i class="bi bi-trash" aria-hidden="true"></i></button>
                        </div>
                      </td>
                    </tr>
                    <tr>
                      <td><strong>Giới thiệu</strong></td>
                      <td><code>about.html</code></td>
                      <td>
                        <select class="form-select form-select-sm" aria-label="Menu cha của Giới thiệu">
                          <option selected>—</option>
                          <option>Giới thiệu</option>
                          <option>Phế liệu thu mua</option>
                        </select>
                      </td>
                      <td><input class="form-control form-control-sm" type="number" min="0" value="2" aria-label="Thứ tự mục Giới thiệu"></td>
                      <td>
                        <div class="ta-actions">
                          <button type="button" aria-label="Sửa mục Giới thiệu"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                          <button class="act-danger" type="button" aria-label="Xóa mục Giới thiệu"><i class="bi bi-trash" aria-hidden="true"></i></button>
                        </div>
                      </td>
                    </tr>
                    <tr>
                      <td><strong>Phế liệu thu mua</strong></td>
                      <td><code>scrap.html</code></td>
                      <td>
                        <select class="form-select form-select-sm" aria-label="Menu cha của Phế liệu thu mua">
                          <option selected>—</option>
                          <option>Giới thiệu</option>
                          <option>Phế liệu thu mua</option>
                        </select>
                      </td>
                      <td><input class="form-control form-control-sm" type="number" min="0" value="3" aria-label="Thứ tự mục Phế liệu thu mua"></td>
                      <td>
                        <div class="ta-actions">
                          <button type="button" aria-label="Sửa mục Phế liệu thu mua"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                          <button class="act-danger" type="button" aria-label="Xóa mục Phế liệu thu mua"><i class="bi bi-trash" aria-hidden="true"></i></button>
                        </div>
                      </td>
                    </tr>
                    <tr>
                      <td><strong>Dịch vụ</strong></td>
                      <td><code>services.html</code></td>
                      <td>
                        <select class="form-select form-select-sm" aria-label="Menu cha của Dịch vụ">
                          <option selected>—</option>
                          <option>Giới thiệu</option>
                          <option>Phế liệu thu mua</option>
                        </select>
                      </td>
                      <td><input class="form-control form-control-sm" type="number" min="0" value="4" aria-label="Thứ tự mục Dịch vụ"></td>
                      <td>
                        <div class="ta-actions">
                          <button type="button" aria-label="Sửa mục Dịch vụ"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                          <button class="act-danger" type="button" aria-label="Xóa mục Dịch vụ"><i class="bi bi-trash" aria-hidden="true"></i></button>
                        </div>
                      </td>
                    </tr>
                    <tr>
                      <td><strong>Bảng giá</strong></td>
                      <td><code>prices.html</code></td>
                      <td>
                        <select class="form-select form-select-sm" aria-label="Menu cha của Bảng giá">
                          <option selected>—</option>
                          <option>Giới thiệu</option>
                          <option>Phế liệu thu mua</option>
                        </select>
                      </td>
                      <td><input class="form-control form-control-sm" type="number" min="0" value="5" aria-label="Thứ tự mục Bảng giá"></td>
                      <td>
                        <div class="ta-actions">
                          <button type="button" aria-label="Sửa mục Bảng giá"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                          <button class="act-danger" type="button" aria-label="Xóa mục Bảng giá"><i class="bi bi-trash" aria-hidden="true"></i></button>
                        </div>
                      </td>
                    </tr>
                    <tr>
                      <td><strong>Liên hệ</strong></td>
                      <td><code>contact.html</code></td>
                      <td>
                        <select class="form-select form-select-sm" aria-label="Menu cha của Liên hệ">
                          <option selected>—</option>
                          <option>Giới thiệu</option>
                          <option>Phế liệu thu mua</option>
                        </select>
                      </td>
                      <td><input class="form-control form-control-sm" type="number" min="0" value="6" aria-label="Thứ tự mục Liên hệ"></td>
                      <td>
                        <div class="ta-actions">
                          <button type="button" aria-label="Sửa mục Liên hệ"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                          <button class="act-danger" type="button" aria-label="Xóa mục Liên hệ"><i class="bi bi-trash" aria-hidden="true"></i></button>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Menu Footer -->
            <div class="admin-panel mb-0">
              <div class="panel-head">
                <h2>Menu Footer</h2>
                <div class="panel-head-actions">
                  <span class="small text-muted">3 mục</span>
                </div>
              </div>
              <div class="table-admin-wrap">
                <table class="table table-admin align-middle">
                  <thead>
                    <tr>
                      <th>Nhãn</th>
                      <th>Link</th>
                      <th><span class="visually-hidden">Thao tác</span></th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><strong>Phế liệu</strong></td>
                      <td><code>scrap.html</code></td>
                      <td>
                        <div class="ta-actions">
                          <button type="button" aria-label="Sửa mục Phế liệu"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                          <button class="act-danger" type="button" aria-label="Xóa mục Phế liệu"><i class="bi bi-trash" aria-hidden="true"></i></button>
                        </div>
                      </td>
                    </tr>
                    <tr>
                      <td><strong>Dịch vụ</strong></td>
                      <td><code>services.html</code></td>
                      <td>
                        <div class="ta-actions">
                          <button type="button" aria-label="Sửa mục Dịch vụ footer"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                          <button class="act-danger" type="button" aria-label="Xóa mục Dịch vụ footer"><i class="bi bi-trash" aria-hidden="true"></i></button>
                        </div>
                      </td>
                    </tr>
                    <tr>
                      <td><strong>Khu vực</strong></td>
                      <td><code>locations.html</code></td>
                      <td>
                        <div class="ta-actions">
                          <button type="button" aria-label="Sửa mục Khu vực"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                          <button class="act-danger" type="button" aria-label="Xóa mục Khu vực"><i class="bi bi-trash" aria-hidden="true"></i></button>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <div>
            <!-- Thêm mục mới -->
            <div class="admin-panel">
              <div class="panel-head">
                <h2>Thêm mục mới</h2>
              </div>
              <div class="panel-body">
                <label class="form-label-tech" for="menuItemLabel">Nhãn<span class="required-mark">*</span></label>
                <input class="form-control" id="menuItemLabel" type="text" placeholder="VD: Dự án" required>
                <label class="form-label-tech mt-3" for="menuItemLink">Link<span class="required-mark">*</span></label>
                <input class="form-control" id="menuItemLink" type="text" placeholder="VD: projects.html" required>
                <label class="form-label-tech mt-3" for="menuPosition">Vị trí</label>
                <select class="form-select" id="menuPosition">
                  <option value="header" selected>Header</option>
                  <option value="footer">Footer</option>
                </select>
                <label class="form-label-tech mt-3" for="menuParent">Menu cha</label>
                <select class="form-select" id="menuParent">
                  <option selected>—</option>
                  <option>Trang chủ</option>
                  <option>Giới thiệu</option>
                  <option>Phế liệu thu mua</option>
                  <option>Dịch vụ</option>
                  <option>Bảng giá</option>
                  <option>Liên hệ</option>
                </select>
                <label class="form-label-tech mt-3" for="menuOrder">Thứ tự</label>
                <input class="form-control" id="menuOrder" type="number" min="0" value="7">
                <button class="btn btn-primary w-100 mt-4" type="submit"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm vào menu</button>
              </div>
            </div>

            <!-- Ghi chú -->
            <div class="admin-panel mb-0">
              <div class="panel-head">
                <h2>Ghi chú</h2>
              </div>
              <div class="panel-body">
                <p class="small text-muted mb-0">Menu 2 cấp hỗ trợ dropdown — kéo thả sắp xếp sẽ bổ sung khi tích hợp backend.</p>
              </div>
            </div>
          </div>
        </div>
      </form>
