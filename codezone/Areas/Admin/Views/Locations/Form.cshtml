@model ScrapWebsite.Areas.Admin.ViewModels.Forms.LocationFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.Id == 0 ? "Thêm khu vực" : $"Sửa khu vực: {Model.Name}";
    ViewData["AdminSection"] = "locations";
    ViewData["AdminSubSection"] = "form";
}

<div class="admin-page-head">
  <h1>@(Model.Id == 0 ? "Thêm khu vực" : $"Sửa: {Model.Name}")<small>Trang landing riêng cho một huyện / thành phố (local SEO)</small></h1>
  <div class="aph-actions">
    <a class="btn btn-outline-dark" href="/admin/locations"><i class="bi bi-arrow-left" aria-hidden="true"></i> Danh sách</a>
    <button class="btn btn-primary" type="submit" form="locationForm"><i class="bi bi-check-lg" aria-hidden="true"></i> Lưu</button>
  </div>
</div>

<form id="locationForm" action="/admin/locations/Save" method="post" enctype="multipart/form-data">
  @Html.AntiForgeryToken()
  <input type="hidden" name="Id" value="@Model.Id">
  <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
  <div class="admin-form-grid">
    <div>
      <!-- Thông tin khu vực -->
      <div class="admin-panel mb-0">
        <div class="panel-head">
          <h2>Thông tin khu vực</h2>
        </div>
        <div class="panel-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label-tech" for="locProvince">Tỉnh / Thành phố<span class="required-mark">*</span></label>
              <input class="form-control" id="locProvince" name="Province" type="text" value="@Model.Province" required maxlength="120" placeholder="Đồng Nai, TP.HCM, Bình Dương…">
              <span class="text-danger small" asp-validation-for="Province"></span>
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="locDistrict">Huyện / Thành phố</label>
              <input class="form-control" id="locDistrict" name="District" type="text" value="@Model.District" maxlength="160" placeholder="Biên Hòa, Thủ Đức…">
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="locName">Tên khu vực<span class="required-mark">*</span></label>
              <input class="form-control" id="locName" name="Name" type="text" value="@Model.Name" required maxlength="180" placeholder="Thu mua phế liệu Biên Hòa">
              <span class="text-danger small" asp-validation-for="Name"></span>
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="locSlug">Slug</label>
              <div class="input-with-suffix">
                <input class="form-control" id="locSlug" name="Slug" type="text" value="@Model.Slug" maxlength="180" placeholder="Tự sinh từ tên nếu bỏ trống">
                <span class="input-suffix">.html</span>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label-tech" for="locTeaser">Giới thiệu ngắn</label>
              <textarea class="form-control" id="locTeaser" name="Excerpt" rows="2" maxlength="600">@Model.Excerpt</textarea>
            </div>
            <div class="col-12">
              <span class="form-label-tech">Nội dung trang</span>
              <textarea class="form-control js-rich-editor" name="ContentHtml" rows="12">@Model.ContentHtml</textarea>
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="locLatitude">Vĩ độ (Latitude)</label>
              <input class="form-control" id="locLatitude" name="Latitude" type="number" step="0.0000001" min="-90" max="90" value="@Model.Latitude" aria-label="Vĩ độ">
              <span class="text-danger small" asp-validation-for="Latitude"></span>
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="locLongitude">Kinh độ (Longitude)</label>
              <input class="form-control" id="locLongitude" name="Longitude" type="number" step="0.0000001" min="-180" max="180" value="@Model.Longitude" aria-label="Kinh độ">
              <span class="text-danger small" asp-validation-for="Longitude"></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div>
      <!-- Ảnh đại diện -->
      <div class="admin-panel">
        <div class="panel-head">
          <h2>Ảnh đại diện (16:9)</h2>
        </div>
        <div class="panel-body">
          @if (!string.IsNullOrWhiteSpace(Model.CurrentCoverUrl))
          {
            <div class="mb-2">
              <img src="@Model.CurrentCoverUrl" alt="Ảnh bìa hiện tại" width="96" height="54" class="rounded border" style="object-fit:cover" loading="lazy">
              <div class="form-check mt-1">
                <input class="form-check-input" type="checkbox" name="RemoveCover" id="removeCover" value="true">
                <label class="form-check-label small" for="removeCover">Xóa ảnh bìa hiện tại</label>
              </div>
            </div>
          }
          @await Html.PartialAsync("~/Areas/Admin/Views/Shared/Partials/_UploadDrop.cshtml", new codezone.Areas.Admin.ViewModels.UploadDropViewModel("Tải ảnh lên", "JPG, PNG — tối thiểu 1600×900, tự chuyển WebP", "CoverFile", false))
        </div>
      </div>

      <!-- Cấu hình -->
      <div class="admin-panel mb-0">
        <div class="panel-head">
          <h2>Cấu hình</h2>
        </div>
        <div class="panel-body">
          <label class="form-label-tech" for="locStatus">Trạng thái</label>
          <select class="form-select" id="locStatus" name="Status">
            <option value="published" selected="@(Model.Status == "published")">Đã xuất bản</option>
            <option value="draft" selected="@(Model.Status != "published")">Bản nháp</option>
          </select>
        </div>
      </div>
    </div>
  </div>
</form>

@section Scripts {
<script>
  (function () {
    'use strict';
    var nameInput = document.getElementById('locName');
    var slugInput = document.getElementById('locSlug');
    function toSlug(value) {
      return value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '').toLowerCase();
    }
    nameInput.addEventListener('blur', function () {
      if (!slugInput.value.trim()) slugInput.value = toSlug(nameInput.value);
    });
  })();
</script>
}
