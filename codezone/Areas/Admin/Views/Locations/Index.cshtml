                <td><span class="badge-status st-published">Đã xuất bản</span></td>
                <td>
                  <div class="ta-actions">
                    <a href="/admin/locations/form" aria-label="Sửa khu vực Biên Hòa"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                    <button class="act-danger" type="button" aria-label="Xóa khu vực Biên Hòa"><i class="bi bi-trash" aria-hidden="true"></i></button>
