@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Khu vực";
    ViewData["AdminSection"] = "locations";
    ViewData["AdminSubSection"] = "";
}

<!-- backend: GET /admin/locations — danh sách khu vực thu mua -->
      <div class="admin-page-head">
        <h1>Khu vực thu mua<small>Trang landing riêng cho từng tỉnh / huyện (local SEO)</small></h1>
        <div class="aph-actions">
          <a class="btn btn-primary" href="/admin/locations/form"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm khu vực</a>
        </div>
      </div>

      <!-- backend: GET /admin/locations?province=&status=&q= -->
      <form class="admin-filter" action="#" method="get">
        <span class="admin-filter-label">Tỉnh</span>
        <select class="form-select" aria-label="Lọc theo tỉnh">
          <option value="" selected>Tất cả</option>
          <option value="dong-nai">Đồng Nai</option>
          <option value="tp-hcm">TP.HCM</option>
          <option value="binh-duong">Bình Dương</option>
          <option value="ba-ria-vung-tau">Bà Rịa – Vũng Tàu</option>
          <option value="long-an">Long An</option>
        </select>
        <span class="admin-filter-label">Trạng thái</span>
        <select class="form-select" aria-label="Lọc theo trạng thái">
          <option value="" selected>Tất cả</option>
          <option value="published">Đã xuất bản</option>
          <option value="draft">Bản nháp</option>
        </select>
        <input class="form-control" type="search" placeholder="Tìm theo huyện, slug…" aria-label="Tìm theo huyện, slug">
        <div class="spacer"></div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Tìm</button>
      </form>

      <div class="admin-panel">
        <div class="table-admin-wrap">
