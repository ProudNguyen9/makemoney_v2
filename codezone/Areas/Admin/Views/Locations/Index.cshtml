@model ScrapWebsite.Areas.Admin.ViewModels.Data.AdminLocationListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Khu vực";
    ViewData["AdminSection"] = "locations";
    ViewData["AdminSubSection"] = "";

    string StatusLabel(string status) => status == "published" ? "Đã xuất bản" : "Bản nháp";
}

<div class="admin-page-head">
  <h1>Khu vực thu mua<small>Trang landing riêng cho từng tỉnh / huyện (local SEO) — @Model.TotalCount khu vực</small></h1>
  <div class="aph-actions">
    <a class="btn btn-primary" href="/admin/locations/Form"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm khu vực</a>
  </div>
</div>

<form class="admin-filter" action="/admin/locations" method="get">
  <span class="admin-filter-label">Tỉnh</span>
  <select class="form-select" name="province" aria-label="Lọc theo tỉnh">
    <option value="" selected="@(string.IsNullOrEmpty(Model.Province))">Tất cả</option>
    @foreach (var province in Model.Provinces)
    {
      <option value="@province" selected="@(Model.Province == province)">@province</option>
    }
  </select>
  <span class="admin-filter-label">Trạng thái</span>
  <select class="form-select" name="status" aria-label="Lọc theo trạng thái">
    <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">Tất cả</option>
    <option value="published" selected="@(Model.Status == "published")">Đã xuất bản</option>
    <option value="draft" selected="@(Model.Status == "draft")">Bản nháp</option>
  </select>
  <input class="form-control" name="q" type="search" value="@Model.Query" placeholder="Tìm theo tên khu vực, slug…" aria-label="Tìm theo tên khu vực, slug">
  <div class="spacer"></div>
  <button class="btn btn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Tìm</button>
</form>

<div class="admin-panel">
  <div class="table-admin-wrap">
    <table class="table table-admin align-middle">
      <thead>
        <tr>
          <th>Ảnh</th>
          <th>Tỉnh</th>
          <th>Huyện / Thành phố</th>
          <th>Tên khu vực</th>
          <th>Slug</th>
          <th>Trạng thái</th>
          <th><span class="visually-hidden">Thao tác</span></th>
        </tr>
      </thead>
      <tbody>
      @foreach (var item in Model.Items)
      {
        <tr>
          <td class="ta-title">
            <a href="/admin/locations/Form/@item.Id"><img src="@(string.IsNullOrWhiteSpace(item.CoverImage) ? "/assets/images/company/company-yard.svg" : item.CoverImage)" alt="@item.Name" width="56" height="42" loading="lazy"></a>
          </td>
          <td><strong>@item.Province</strong></td>
          <td>@(item.District ?? "—")</td>
          <td><strong><a class="text-decoration-none" href="/admin/locations/Form/@item.Id">@item.Name</a></strong></td>
          <td><code>@item.Slug</code></td>
          <td>
            <form method="post" action="/admin/locations/ToggleStatus" data-autosubmit>
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@item.Id">
              <input type="hidden" name="province" value="@Model.Province">
              <input type="hidden" name="status" value="@Model.Status">
              <input type="hidden" name="q" value="@Model.Query">
              <input type="hidden" name="page" value="@Model.Page">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" @(item.Status == "published" ? "checked" : "") aria-label="Hiển thị @item.Name">
              </div>
            </form>
          </td>
          <td>
            <div class="ta-actions">
              <a href="/admin/locations/Form/@item.Id" aria-label="Sửa khu vực @item.Name"><i class="bi bi-pencil" aria-hidden="true"></i></a>
              <form method="post" action="/admin/locations/Delete" class="d-inline" onsubmit="return confirm('Xóa khu vực &quot;@item.Name&quot;?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id">
                <input type="hidden" name="province" value="@Model.Province">
                <input type="hidden" name="status" value="@Model.Status">
                <input type="hidden" name="q" value="@Model.Query">
                <input type="hidden" name="page" value="@Model.Page">
                <button class="act-danger" type="submit" aria-label="Xóa khu vực @item.Name"><i class="bi bi-trash" aria-hidden="true"></i></button>
              </form>
            </div>
          </td>
        </tr>
      }
      @if (Model.Items.Count == 0)
      {
        <tr>
          <td colspan="7" class="text-center text-muted py-4">Chưa có khu vực nào khớp bộ lọc.</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
  <div class="panel-foot">
    @await Html.PartialAsync("~/Areas/Admin/Views/Shared/Partials/_AdminPagination.cshtml", Model.Pager)
  </div>
</div>
