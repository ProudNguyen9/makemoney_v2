@model ScrapWebsite.Areas.Admin.ViewModels.Forms.ServiceFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.Id == 0 ? "Thêm dịch vụ" : $"Sửa dịch vụ: {Model.Title}";
    ViewData["AdminSection"] = "services";
    ViewData["AdminSubSection"] = "form";
}

<div class="admin-page-head">
  <h1>@(Model.Id == 0 ? "Thêm dịch vụ" : $"Sửa: {Model.Title}")<small>Ảnh bìa tải lên được tự động nén và chuyển sang WebP</small></h1>
  <div class="aph-actions">
    <a class="btn btn-outline-dark" href="/admin/services"><i class="bi bi-arrow-left" aria-hidden="true"></i> Danh sách</a>
    <button class="btn btn-primary" type="submit" form="serviceForm"><i class="bi bi-check-lg" aria-hidden="true"></i> Lưu</button>
  </div>
</div>

<form id="serviceForm" action="/admin/services/Save" method="post" enctype="multipart/form-data">
  @Html.AntiForgeryToken()
  <input type="hidden" name="Id" value="@Model.Id">
  <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
  <div class="admin-form-grid">
    <div>
      <!-- Thông tin dịch vụ -->
      <div class="admin-panel mb-0">
        <div class="panel-head">
          <h2>Thông tin dịch vụ</h2>
        </div>
        <div class="panel-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label-tech" for="serviceName">Tên dịch vụ<span class="required-mark">*</span></label>
              <input class="form-control" id="serviceName" name="Title" type="text" value="@Model.Title" required maxlength="220">
              <span class="text-danger small" asp-validation-for="Title"></span>
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="serviceSlug">Slug</label>
              <div class="input-with-suffix">
                <input class="form-control" id="serviceSlug" name="Slug" type="text" value="@Model.Slug" maxlength="180" placeholder="Tự sinh từ tên nếu bỏ trống">
                <span class="input-suffix">.html</span>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label-tech" for="serviceTeaser">Mô tả ngắn</label>
              <textarea class="form-control" id="serviceTeaser" name="Excerpt" rows="2" maxlength="600">@Model.Excerpt</textarea>
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="serviceIcon">Icon (Bootstrap Icons)</label>
              <select class="form-select" id="serviceIcon" name="IconCss">
                @{
                    var icons = new (string Value, string Label)[]
                    {
                        ("bi-truck", "bi-truck — Vận chuyển tận nơi"),
                        ("bi-buildings", "bi-buildings — Nhà xưởng, doanh nghiệp"),
                        ("bi-gear", "bi-gear — Máy móc"),
                        ("bi-tools", "bi-tools — Tháo dỡ, lắp đặt"),
                        ("bi-recycle", "bi-recycle — Thu gom tái chế"),
                        ("bi-calendar-check", "bi-calendar-check — Định kỳ"),
                        ("bi-house-gear", "bi-house-gear — Nhà xưởng"),
                        ("bi-cone-striped", "bi-cone-striped — Công trình")
                    };
                    var currentIcon = Model.IconCss;
                }
                @foreach (var icon in icons)
                {
                    <option value="@icon.Value" selected="@(currentIcon == icon.Value)">@icon.Label</option>
                }
                @if (!string.IsNullOrEmpty(currentIcon) && icons.All(icon => icon.Value != currentIcon))
                {
                    <option value="@currentIcon" selected>@currentIcon</option>
                }
              </select>
            </div>
            <div class="col-12">
              <span class="form-label-tech">Nội dung</span>
              <textarea class="form-control js-rich-editor" name="ContentHtml" rows="12">@Model.ContentHtml</textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- Tối ưu SEO -->
      <div class="admin-panel mt-3 mb-0">
        <div class="panel-head">
          <h2>Tối ưu SEO</h2>
        </div>
        <div class="panel-body">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label-tech" for="serviceSeoKeywords">Từ khóa SEO (meta keywords)</label>
              <input class="form-control" id="serviceSeoKeywords" name="SeoKeywords" type="text" value="@Model.SeoKeywords" maxlength="255" placeholder="VD: thu mua phế liệu tận nơi, thanh lý nhà xưởng, thu gom định kỳ">
              <p class="small text-muted mt-1 mb-0">Các từ khóa cách nhau bằng dấu phẩy. Từ khóa này được gắn vào thẻ &lt;meta name="keywords"&gt; của trang chi tiết dịch vụ.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div>
      <!-- Ảnh đại diện -->
      <div class="admin-panel">
        <div class="panel-head">
          <h2>Ảnh đại diện (16:10)</h2>
        </div>
        <div class="panel-body">
          @if (!string.IsNullOrWhiteSpace(Model.CurrentCoverUrl))
          {
            <div class="mb-2">
              <img src="@Model.CurrentCoverUrl" alt="Ảnh bìa hiện tại" width="96" height="60" class="rounded border" style="object-fit:cover" loading="lazy">
              <div class="form-check mt-1">
                <input class="form-check-input" type="checkbox" name="RemoveCover" id="removeCover" value="true">
                <label class="form-check-label small" for="removeCover">Xóa ảnh bìa hiện tại</label>
              </div>
            </div>
          }
          @await Html.PartialAsync("~/Areas/Admin/Views/Shared/Partials/_UploadDrop.cshtml", new codezone.Areas.Admin.ViewModels.UploadDropViewModel("Tải ảnh lên", "PNG, JPG — tối thiểu 1600×1000, tự chuyển WebP", "CoverFile", false))
        </div>
      </div>

      <!-- Cấu hình -->
      <div class="admin-panel mb-0">
        <div class="panel-head">
          <h2>Cấu hình</h2>
        </div>
        <div class="panel-body">
          <label class="form-label-tech" for="serviceStatus">Trạng thái</label>
          <select class="form-select" id="serviceStatus" name="Status">
            <option value="published" selected="@(Model.Status == "published")">Đang hiển thị</option>
            <option value="draft" selected="@(Model.Status != "published")">Ẩn</option>
          </select>
          <label class="form-label-tech mt-3" for="serviceOrder">Vị trí hiển thị</label>
          <input class="form-control" id="serviceOrder" name="SortOrder" type="number" min="1" max="9999" value="@Model.SortOrder" title="1 = đầu danh sách. Lưu sẽ tự dồn vị trí các dịch vụ khác.">
          <p class="small text-muted mt-1 mb-0">Số nhỏ hiện trước. Lưu sẽ tự động chèn vào đúng vị trí và đánh lại số liên tục (không trùng).</p>
        </div>
      </div>
    </div>
  </div>
</form>

@section Scripts {
<script>
  (function () {
    'use strict';
    var nameInput = document.getElementById('serviceName');
    var slugInput = document.getElementById('serviceSlug');
    function toSlug(value) {
      return value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '').toLowerCase();
    }
    nameInput.addEventListener('blur', function () {
      if (!slugInput.value.trim()) slugInput.value = toSlug(nameInput.value);
    });
  })();
</script>
}
