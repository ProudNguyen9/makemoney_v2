@model ScrapWebsite.Areas.Admin.ViewModels.Data.AdminServiceListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dịch vụ";
    ViewData["AdminSection"] = "services";
    ViewData["AdminSubSection"] = "";

    string StatusLabel(string status) => status == "published" ? "Đang hiển thị" : status == "draft" ? "Ẩn" : status;
}

<div class="admin-page-head">
  <h1>Dịch vụ<small>Các nhóm dịch vụ thu mua — @Model.TotalCount dịch vụ</small></h1>
  <div class="aph-actions">
    <a class="btn btn-primary" href="/admin/services/Form"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Thêm dịch vụ</a>
  </div>
</div>

<form class="admin-filter" action="/admin/services" method="get">
  <span class="admin-filter-label">Trạng thái</span>
  <select class="form-select" name="status" aria-label="Lọc theo trạng thái">
    <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">Tất cả</option>
    <option value="published" selected="@(Model.Status == "published")">Đang hiển thị</option>
    <option value="draft" selected="@(Model.Status == "draft")">Ẩn</option>
  </select>
  <input class="form-control" name="q" type="search" value="@Model.Query" placeholder="Tìm theo tên dịch vụ, slug…" aria-label="Tìm theo tên dịch vụ, slug">
  <div class="spacer"></div>
  <button class="btn btn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Tìm</button>
</form>

<section class="admin-panel">
  <div class="panel-head">
    <h2>Danh sách dịch vụ</h2>
    <div class="panel-head-actions">
      <span class="small text-muted">@Model.TotalCount dịch vụ</span>
    </div>
  </div>
  <div class="table-admin-wrap">
    <table class="table table-admin align-middle">
      <thead>
        <tr>
          <th scope="col">Ảnh</th>
          <th scope="col">Tên dịch vụ</th>
          <th scope="col">Slug</th>
          <th scope="col">Trạng thái</th>
          <th scope="col">Vị trí</th>
          <th scope="col">Thao tác</th>
        </tr>
      </thead>
      <tbody>
      @foreach (var item in Model.Items)
      {
        <tr>
          <td>
            <span class="ta-title"><img src="@(string.IsNullOrWhiteSpace(item.CoverImage) ? "/assets/images/company/company-warehouse.svg" : item.CoverImage)" alt="@item.Title" width="40" height="30" loading="lazy"></span>
          </td>
          <td><span class="ta-title"><a href="/admin/services/Form/@item.Id">@item.Title</a></span></td>
          <td class="text-muted">@item.Slug</td>
          <td>
            <form method="post" action="/admin/services/ToggleStatus" data-autosubmit>
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@item.Id">
              <input type="hidden" name="status" value="@Model.Status">
              <input type="hidden" name="q" value="@Model.Query">
              <input type="hidden" name="page" value="@Model.Page">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" @(item.Status == "published" ? "checked" : "") aria-label="Hiển thị @item.Title">
              </div>
            </form>
          </td>
          <td>
            <form method="post" action="/admin/services/UpdateSort" class="d-flex gap-1" style="max-width:110px">
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@item.Id">
              <input type="hidden" name="status" value="@Model.Status">
              <input type="hidden" name="q" value="@Model.Query">
              <input type="hidden" name="page" value="@Model.Page">
              <input class="form-control form-control-sm" type="number" min="1" max="9999" name="sortOrder" value="@item.SortOrder" title="Vị trí hiển thị (1 = đầu danh sách). Lưu sẽ tự dồn các dòng khác." aria-label="Vị trí @item.Title">
              <button class="btn btn-outline-dark btn-sm" type="submit" aria-label="Lưu vị trí @item.Title"><i class="bi bi-check" aria-hidden="true"></i></button>
            </form>
          </td>
          <td>
            <div class="ta-actions">
              <a href="/admin/services/Form/@item.Id" aria-label="Sửa @item.Title"><i class="bi bi-pencil" aria-hidden="true"></i></a>
              <form method="post" action="/admin/services/Delete" class="d-inline" onsubmit="return confirm('Xóa dịch vụ &quot;@item.Title&quot;?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id">
                <input type="hidden" name="status" value="@Model.Status">
                <input type="hidden" name="q" value="@Model.Query">
                <input type="hidden" name="page" value="@Model.Page">
                <button class="act-danger" type="submit" aria-label="Xóa @item.Title"><i class="bi bi-trash" aria-hidden="true"></i></button>
              </form>
            </div>
          </td>
        </tr>
      }
      @if (Model.Items.Count == 0)
      {
        <tr>
          <td colspan="6" class="text-center text-muted py-4">Chưa có dịch vụ nào khớp bộ lọc.</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
  <div class="panel-foot">
    @await Html.PartialAsync("~/Areas/Admin/Views/Shared/Partials/_AdminPagination.cshtml", Model.Pager)
  </div>
</section>
