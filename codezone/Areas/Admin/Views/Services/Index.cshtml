@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dịch vụ";
    ViewData["AdminSection"] = "services";
    ViewData["AdminSubSection"] = "";
}

<!-- backend: GET /admin/services — danh sách nhóm dịch vụ thu mua -->
      <div class="admin-page-head">
        <h1>Dịch vụ <small>Các nhóm dịch vụ thu mua hiển thị trên website</small></h1>
        <div class="aph-actions">
          <a class="btn btn-primary" href="/admin/services/form"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Thêm dịch vụ</a>
        </div>
      </div>

      <!-- Bộ lọc: trạng thái + từ khóa -->
      <form class="admin-filter" action="#" method="get">
        <span class="admin-filter-label">Trạng thái</span>
        <select class="form-select" aria-label="Lọc theo trạng thái">
          <option value="" selected>Tất cả</option>
          <option value="published">Đang hiển thị</option>
          <option value="hidden">Ẩn</option>
        </select>
        <input class="form-control" type="search" placeholder="Tìm theo tên dịch vụ, slug…" aria-label="Tìm theo tên dịch vụ, slug">
        <div class="spacer"></div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Tìm</button>
      </form>

      <section class="admin-panel">
        <div class="panel-head">
          <h2>Danh sách dịch vụ</h2>
          <div class="panel-head-actions">
            <span class="small text-muted">6 dịch vụ</span>
          </div>
        </div>
        <!-- BACKEND: 6 dịch vụ, sắp theo Thứ tự tăng dần -->
        <div class="table-admin-wrap">
          <table class="table table-admin align-middle">
            <thead>
              <tr>
                <th scope="col">Ảnh</th>
                <th scope="col">Tên dịch vụ</th>
                <th scope="col">Slug</th>
                <th scope="col">Trạng thái</th>
                <th scope="col">Thứ tự</th>
                <th scope="col">Thao tác</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <span class="ta-title"><img src="~/assets/images/company/company-warehouse.svg" alt="Ảnh dịch vụ thu mua phế liệu tận nơi" width="40" height="30"></span>
                </td>
                <td><span class="ta-title"><a href="/admin/services/form">Thu mua phế liệu tận nơi</a></span></td>
                <td class="text-muted">thu-mua-phe-lieu-tan-noi</td>
                <td><span class="badge-status st-published">Đang hiển thị</span></td>
                <td>
                  <!-- backend: cập nhật thứ tự hiển thị (POST /admin/services/reorder) -->
                  <input class="form-control form-control-sm" type="number" min="1" value="1" aria-label="Thứ tự dịch vụ Thu mua phế liệu tận nơi">
                </td>
                <td>
                  <div class="ta-actions">
                    <a href="/admin/services/form" aria-label="Sửa dịch vụ Thu mua phế liệu tận nơi"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                    <button class="act-danger" type="button" aria-label="Xóa dịch vụ Thu mua phế liệu tận nơi"><i class="bi bi-trash" aria-hidden="true"></i></button>
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  <span class="ta-title"><img src="~/assets/images/hero/hero-01.svg" alt="Ảnh dịch vụ thu mua phế liệu doanh nghiệp" width="40" height="30"></span>
                </td>
                <td><span class="ta-title"><a href="/admin/services/form">Thu mua phế liệu doanh nghiệp</a></span></td>
                <td class="text-muted">thu-mua-phe-lieu-doanh-nghiep</td>
                <td><span class="badge-status st-published">Đang hiển thị</span></td>
                <td>
                  <input class="form-control form-control-sm" type="number" min="1" value="2" aria-label="Thứ tự dịch vụ Thu mua phế liệu doanh nghiệp">
                </td>
                <td>
                  <div class="ta-actions">
                    <a href="/admin/services/form" aria-label="Sửa dịch vụ Thu mua phế liệu doanh nghiệp"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                    <button class="act-danger" type="button" aria-label="Xóa dịch vụ Thu mua phế liệu doanh nghiệp"><i class="bi bi-trash" aria-hidden="true"></i></button>
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  <span class="ta-title"><img src="~/assets/images/projects/project-01-cover.svg" alt="Ảnh dịch vụ thu mua và thanh lý nhà xưởng" width="40" height="30"></span>
                </td>
                <td><span class="ta-title"><a href="/admin/services/form">Thu mua &amp; thanh lý nhà xưởng</a></span></td>
                <td class="text-muted">thu-mua-thanh-ly-nha-xuong</td>
                <td><span class="badge-status st-published">Đang hiển thị</span></td>
                <td>
                  <input class="form-control form-control-sm" type="number" min="1" value="3" aria-label="Thứ tự dịch vụ Thu mua và thanh lý nhà xưởng">
                </td>
                <td>
                  <div class="ta-actions">
                    <a href="/admin/services/form" aria-label="Sửa dịch vụ Thu mua và thanh lý nhà xưởng"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                    <button class="act-danger" type="button" aria-label="Xóa dịch vụ Thu mua và thanh lý nhà xưởng"><i class="bi bi-trash" aria-hidden="true"></i></button>
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  <span class="ta-title"><img src="~/assets/images/projects/project-02-cover.svg" alt="Ảnh dịch vụ thu mua phế liệu công trình" width="40" height="30"></span>
                </td>
                <td><span class="ta-title"><a href="/admin/services/form">Thu mua phế liệu công trình</a></span></td>
                <td class="text-muted">thu-mua-phe-lieu-cong-trinh</td>
                <td><span class="badge-status st-published">Đang hiển thị</span></td>
                <td>
                  <input class="form-control form-control-sm" type="number" min="1" value="4" aria-label="Thứ tự dịch vụ Thu mua phế liệu công trình">
                </td>
                <td>
                  <div class="ta-actions">
                    <a href="/admin/services/form" aria-label="Sửa dịch vụ Thu mua phế liệu công trình"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                    <button class="act-danger" type="button" aria-label="Xóa dịch vụ Thu mua phế liệu công trình"><i class="bi bi-trash" aria-hidden="true"></i></button>
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  <span class="ta-title"><img src="~/assets/images/scrap/scrap-motor.svg" alt="Ảnh dịch vụ thu mua máy móc cũ" width="40" height="30"></span>
                </td>
                <td><span class="ta-title"><a href="/admin/services/form">Thu mua máy móc cũ</a></span></td>
                <td class="text-muted">thu-mua-may-moc-cu</td>
                <td><span class="badge-status st-published">Đang hiển thị</span></td>
                <td>
                  <input class="form-control form-control-sm" type="number" min="1" value="5" aria-label="Thứ tự dịch vụ Thu mua máy móc cũ">
                </td>
                <td>
                  <div class="ta-actions">
                    <a href="/admin/services/form" aria-label="Sửa dịch vụ Thu mua máy móc cũ"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                    <button class="act-danger" type="button" aria-label="Xóa dịch vụ Thu mua máy móc cũ"><i class="bi bi-trash" aria-hidden="true"></i></button>
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  <span class="ta-title"><img src="~/assets/images/company/company-yard.svg" alt="Ảnh dịch vụ thu gom phế liệu định kỳ" width="40" height="30"></span>
                </td>
                <td><span class="ta-title"><a href="/admin/services/form">Thu gom định kỳ</a></span></td>
                <td class="text-muted">thu-gom-dinh-ky</td>
                <td><span class="badge-status st-published">Đang hiển thị</span></td>
                <td>
                  <input class="form-control form-control-sm" type="number" min="1" value="6" aria-label="Thứ tự dịch vụ Thu gom định kỳ">
                </td>
                <td>
                  <div class="ta-actions">
                    <a href="/admin/services/form" aria-label="Sửa dịch vụ Thu gom định kỳ"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                    <button class="act-danger" type="button" aria-label="Xóa dịch vụ Thu gom định kỳ"><i class="bi bi-trash" aria-hidden="true"></i></button>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="panel-foot">
          <span class="admin-pagination">Hiển thị 1–6 / 6</span>
          <nav aria-label="Phân trang dịch vụ">
            <ul class="pagination pagination-sm mb-0">
              <li class="page-item disabled"><a class="page-link" href="#" tabindex="-1" aria-disabled="true"><i class="bi bi-chevron-left" aria-hidden="true"></i></a></li>
              <li class="page-item active" aria-current="page"><a class="page-link" href="#">1</a></li>
              <li class="page-item disabled"><a class="page-link" href="#" tabindex="-1" aria-disabled="true"><i class="bi bi-chevron-right" aria-hidden="true"></i></a></li>
            </ul>
          </nav>
        </div>
      </section>
