@model ScrapWebsite.Areas.Admin.ViewModels.Forms.ProjectFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.Id == 0 ? "Thêm dự án" : $"Sửa dự án: {Model.Title}";
    ViewData["AdminSection"] = "projects";
    ViewData["AdminSubSection"] = "form";
    var galleryIndex = 0;
}

<div class="admin-page-head">
  <h1>@(Model.Id == 0 ? "Thêm dự án" : $"Sửa: {Model.Title}")<small>Ảnh tải lên được tự động nén và chuyển sang WebP</small></h1>
  <div class="aph-actions">
    <a class="btn btn-outline-dark" href="/admin/projects"><i class="bi bi-arrow-left" aria-hidden="true"></i> Danh sách</a>
    <button class="btn btn-primary" type="submit" form="projectForm"><i class="bi bi-check-lg" aria-hidden="true"></i> Lưu</button>
  </div>
</div>

<form id="projectForm" action="/admin/projects/Save" method="post" enctype="multipart/form-data">
  @Html.AntiForgeryToken()
  <input type="hidden" name="Id" value="@Model.Id">
  <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
  <div class="admin-form-grid">
    <div>
      <!-- Thông tin dự án -->
      <div class="admin-panel mb-0">
        <div class="panel-head">
          <h2>Thông tin dự án</h2>
        </div>
        <div class="panel-body">
          <div class="row g-3">
            <div class="col-md-8">
              <label class="form-label-tech" for="projectName">Tên dự án<span class="required-mark">*</span></label>
              <input class="form-control" id="projectName" name="Title" type="text" value="@Model.Title" required maxlength="255">
              <span class="text-danger small" asp-validation-for="Title"></span>
            </div>
            <div class="col-md-4">
              <label class="form-label-tech" for="projectLocation">Địa điểm</label>
              <input class="form-control" id="projectLocation" name="LocationText" type="text" value="@Model.LocationText" maxlength="255" placeholder="Biên Hòa, Đồng Nai">
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="projectType">Loại</label>
              <input class="form-control" id="projectType" name="ProjectType" type="text" value="@Model.ProjectType" maxlength="120" list="projectTypeOptions" placeholder="Nhà xưởng, Công trình, Máy móc…">
              <datalist id="projectTypeOptions">
                <option value="Nhà xưởng"></option>
                <option value="Công trình"></option>
                <option value="Máy móc"></option>
                <option value="Đồng"></option>
                <option value="Sắt"></option>
                <option value="Khác"></option>
              </datalist>
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="projectDate">Ngày hoàn thành</label>
              <input class="form-control" id="projectDate" name="CompletedAt" type="date" value="@(Model.CompletedAt?.ToString("yyyy-MM-dd"))">
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="projectQuantity">Khối lượng / Sản lượng</label>
              <input class="form-control" id="projectQuantity" name="QuantityText" type="text" value="@Model.QuantityText" maxlength="120" placeholder="45 tấn sắt thép">
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="projectDuration">Thời gian thi công</label>
              <input class="form-control" id="projectDuration" name="DurationText" type="text" value="@Model.DurationText" maxlength="120" placeholder="7 ngày">
            </div>
            <div class="col-12">
              <label class="form-label-tech" for="projectTeaser">Mô tả ngắn</label>
              <textarea class="form-control" id="projectTeaser" name="Excerpt" rows="2" maxlength="700">@Model.Excerpt</textarea>
            </div>
            <div class="col-12">
              <span class="form-label-tech">Nội dung</span>
              <textarea class="form-control js-rich-editor" name="ContentHtml" rows="12">@Model.ContentHtml</textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- Tối ưu SEO -->
      <div class="admin-panel mt-3 mb-0">
        <div class="panel-head">
          <h2>Tối ưu SEO</h2>
        </div>
        <div class="panel-body">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label-tech" for="projectSeoKeywords">Từ khóa SEO (meta keywords)</label>
              <input class="form-control" id="projectSeoKeywords" name="SeoKeywords" type="text" value="@Model.SeoKeywords" maxlength="255" placeholder="VD: thanh lý nhà xưởng đồng nai, thu mua sắt thép công trình">
              <p class="small text-muted mt-1 mb-0">Các từ khóa cách nhau bằng dấu phẩy. Từ khóa này được gắn vào thẻ &lt;meta name="keywords"&gt; của trang chi tiết dự án.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div>
      <!-- Ảnh cover -->
      <div class="admin-panel">
        <div class="panel-head">
          <h2>Ảnh cover (16:10)</h2>
        </div>
        <div class="panel-body">
          @if (!string.IsNullOrWhiteSpace(Model.CurrentCoverUrl))
          {
            <div class="mb-2">
              <img src="@Model.CurrentCoverUrl" alt="Ảnh cover hiện tại" width="96" height="60" class="rounded border" style="object-fit:cover" loading="lazy">
              <div class="form-check mt-1">
                <input class="form-check-input" type="checkbox" name="RemoveCover" id="removeCover" value="true">
                <label class="form-check-label small" for="removeCover">Xóa ảnh cover hiện tại</label>
              </div>
            </div>
          }
          @await Html.PartialAsync("~/Areas/Admin/Views/Shared/Partials/_UploadDrop.cshtml", new codezone.Areas.Admin.ViewModels.UploadDropViewModel("Tải ảnh lên", "PNG, JPG — tối thiểu 1600×1000, tự chuyển WebP", "CoverFile", false))
        </div>
      </div>

      <!-- Thư viện ảnh dự án -->
      <div class="admin-panel">
        <div class="panel-head">
          <h2>Thư viện ảnh dự án</h2>
        </div>
        <div class="panel-body">
          @if (Model.Gallery.Count > 0)
          {
            <div class="table-admin-wrap mb-3">
              <table class="table table-admin align-middle">
                <thead>
                  <tr>
                    <th>Ảnh</th>
                    <th>Mô tả ảnh (alt)</th>
                    <th>Thứ tự</th>
                    <th>Xóa</th>
                  </tr>
                </thead>
                <tbody>
                @foreach (var image in Model.Gallery)
                {
                  <tr>
                    <td class="ta-title">
                      <img src="@image.ImageUrl" alt="Ảnh gallery @(galleryIndex + 1)" width="56" height="42" loading="lazy">
                      <input type="hidden" name="Gallery[@galleryIndex].Id" value="@image.Id">
                      <input type="hidden" name="Gallery[@galleryIndex].ImageUrl" value="@image.ImageUrl">
                    </td>
                    <td><input class="form-control form-control-sm" type="text" name="Gallery[@galleryIndex].AltText" value="@image.AltText" maxlength="255" aria-label="Mô tả ảnh @(galleryIndex + 1)"></td>
                    <td><input class="form-control form-control-sm" type="number" min="0" max="9999" name="Gallery[@galleryIndex].SortOrder" value="@image.SortOrder" style="max-width:80px" aria-label="Thứ tự ảnh @(galleryIndex + 1)"></td>
                    <td>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="Gallery[@galleryIndex].Remove" value="true" id="galleryRemove@(galleryIndex)" aria-label="Xóa ảnh @(galleryIndex + 1)">
                      </div>
                    </td>
                  </tr>
                  galleryIndex++;
                }
                </tbody>
              </table>
            </div>
          }
          @await Html.PartialAsync("~/Areas/Admin/Views/Shared/Partials/_UploadDrop.cshtml", new codezone.Areas.Admin.ViewModels.UploadDropViewModel("Tải nhiều ảnh lên", "Chọn nhiều file — PNG, JPG, tối đa 20 ảnh, tự chuyển WebP", "GalleryFiles", true))
        </div>
      </div>

      <!-- Cấu hình -->
      <div class="admin-panel mb-0">
        <div class="panel-head">
          <h2>Cấu hình</h2>
        </div>
        <div class="panel-body">
          <label class="form-label-tech" for="projectStatus">Trạng thái</label>
          <select class="form-select" id="projectStatus" name="Status">
            <option value="published" selected="@(Model.Status == "published")">Đang hiển thị</option>
            <option value="draft" selected="@(Model.Status != "published")">Ẩn</option>
          </select>
          <label class="form-label-tech mt-3" for="projectOrder">Vị trí hiển thị</label>
          <input class="form-control" id="projectOrder" name="SortOrder" type="number" min="1" max="9999" value="@Model.SortOrder" title="1 = đầu danh sách. Lưu sẽ tự dồn vị trí các dự án khác.">
          <p class="small text-muted mt-1 mb-0">Số nhỏ hiện trước. Lưu sẽ tự động chèn vào đúng vị trí và đánh lại số liên tục (không trùng).</p>
        </div>
      </div>
    </div>
  </div>
</form>
