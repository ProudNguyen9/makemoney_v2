@model ScrapWebsite.Areas.Admin.ViewModels.Data.AdminProjectListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dự án";
    ViewData["AdminSection"] = "projects";
    ViewData["AdminSubSection"] = "";
}

<div class="admin-page-head">
  <h1>Dự án<small>Hợp đồng thu mua, tháo dỡ đã thực hiện — @Model.TotalCount dự án</small></h1>
  <div class="aph-actions">
    <a class="btn btn-primary" href="/admin/projects/Form"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Thêm dự án</a>
  </div>
</div>

<form class="admin-filter" action="/admin/projects" method="get">
  <span class="admin-filter-label">Loại</span>
  <select class="form-select" name="type" aria-label="Lọc theo loại dự án">
    <option value="" selected="@(string.IsNullOrEmpty(Model.ProjectType))">Tất cả</option>
    @foreach (var projectType in Model.ProjectTypes)
    {
      <option value="@projectType" selected="@(Model.ProjectType == projectType)">@projectType</option>
    }
  </select>
  <select class="form-select" name="status" aria-label="Lọc theo trạng thái">
    <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">Tất cả</option>
    <option value="published" selected="@(Model.Status == "published")">Đang hiển thị</option>
    <option value="draft" selected="@(Model.Status == "draft")">Ẩn</option>
  </select>
  <input class="form-control" name="q" type="search" value="@Model.Query" placeholder="Tìm theo tên dự án, địa điểm…" aria-label="Tìm theo tên dự án, địa điểm">
  <div class="spacer"></div>
  <button class="btn btn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Tìm</button>
</form>

<section class="admin-panel">
  <div class="panel-head">
    <h2>Danh sách dự án</h2>
    <div class="panel-head-actions">
      <span class="small text-muted">@Model.TotalCount dự án</span>
    </div>
  </div>
  <div class="table-admin-wrap">
    <table class="table table-admin align-middle">
      <thead>
        <tr>
          <th scope="col">Ảnh</th>
          <th scope="col">Tên dự án</th>
          <th scope="col">Địa điểm</th>
          <th scope="col">Loại</th>
          <th scope="col">Ngày</th>
          <th scope="col">Trạng thái</th>
          <th scope="col">Vị trí</th>
          <th scope="col">Thao tác</th>
        </tr>
      </thead>
      <tbody>
      @foreach (var item in Model.Items)
      {
        <tr>
          <td>
            <span class="ta-title"><img src="@(string.IsNullOrWhiteSpace(item.CoverImage) ? "/assets/images/projects/project-01-cover.svg" : item.CoverImage)" alt="@item.Title" width="40" height="30" loading="lazy"></span>
          </td>
          <td><span class="ta-title"><a href="/admin/projects/Form/@item.Id">@item.Title</a></span></td>
          <td>@(item.LocationText ?? "—")</td>
          <td><span class="tag-min">@(item.ProjectType ?? "Khác")</span></td>
          <td class="text-nowrap">@(item.CompletedAt?.ToString("dd/MM/yyyy") ?? "—")</td>
          <td>
            <form method="post" action="/admin/projects/ToggleStatus" data-autosubmit>
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@item.Id">
              <input type="hidden" name="type" value="@Model.ProjectType">
              <input type="hidden" name="status" value="@Model.Status">
              <input type="hidden" name="q" value="@Model.Query">
              <input type="hidden" name="page" value="@Model.Page">
              <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" @(item.Status == "published" ? "checked" : "") aria-label="Hiển thị @item.Title">
              </div>
            </form>
          </td>
          <td>
            <form method="post" action="/admin/projects/UpdateSort" class="d-flex gap-1" style="max-width:110px">
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@item.Id">
              <input type="hidden" name="type" value="@Model.ProjectType">
              <input type="hidden" name="status" value="@Model.Status">
              <input type="hidden" name="q" value="@Model.Query">
              <input type="hidden" name="page" value="@Model.Page">
              <input class="form-control form-control-sm" type="number" min="1" max="9999" name="sortOrder" value="@item.SortOrder" title="Vị trí hiển thị (1 = đầu danh sách). Lưu sẽ tự dồn các dòng khác." aria-label="Vị trí @item.Title">
              <button class="btn btn-outline-dark btn-sm" type="submit" aria-label="Lưu vị trí @item.Title"><i class="bi bi-check" aria-hidden="true"></i></button>
            </form>
          </td>
          <td>
            <div class="ta-actions">
              <a href="/admin/projects/Form/@item.Id" aria-label="Sửa dự án @item.Title"><i class="bi bi-pencil" aria-hidden="true"></i></a>
              <form method="post" action="/admin/projects/ToggleFeatured" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id">
                <input type="hidden" name="type" value="@Model.ProjectType">
                <input type="hidden" name="status" value="@Model.Status">
                <input type="hidden" name="q" value="@Model.Query">
                <input type="hidden" name="page" value="@Model.Page">
                <button type="submit" class="@(item.IsFeatured ? "act-featured" : "")" aria-label="Nổi bật @item.Title" title="@(item.IsFeatured ? "Bỏ nổi bật" : "Nổi bật")"><i class="bi bi-star@(item.IsFeatured ? "-fill" : "")" aria-hidden="true"></i></button>
              </form>
              <form method="post" action="/admin/projects/Delete" class="d-inline" onsubmit="return confirm('Xóa dự án &quot;@item.Title&quot;?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id">
                <input type="hidden" name="type" value="@Model.ProjectType">
                <input type="hidden" name="status" value="@Model.Status">
                <input type="hidden" name="q" value="@Model.Query">
                <input type="hidden" name="page" value="@Model.Page">
                <button class="act-danger" type="submit" aria-label="Xóa dự án @item.Title"><i class="bi bi-trash" aria-hidden="true"></i></button>
              </form>
            </div>
          </td>
        </tr>
      }
      @if (Model.Items.Count == 0)
      {
        <tr>
          <td colspan="8" class="text-center text-muted py-4">Chưa có dự án nào khớp bộ lọc.</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
  <div class="panel-foot">
    @await Html.PartialAsync("~/Areas/Admin/Views/Shared/Partials/_AdminPagination.cshtml", Model.Pager)
  </div>
</section>
