@inject ScrapWebsite.Services.Interfaces.ISiteChromeService SiteChromeService
@{
    var title = ViewData["Title"]?.ToString() ?? "Admin";
    var chrome = await SiteChromeService.GetAsync(Context.RequestAborted);
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - Quản trị</title>
    <link rel="icon" href="@chrome.FaviconUrl" />
    <link rel="stylesheet" href="~/assets/vendor/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/assets/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        @await Html.PartialAsync("~/Areas/Admin/Views/Shared/Partials/_AdminSidebar.cshtml")
        <div class="admin-overlay" aria-hidden="true"></div>

        <div class="admin-main">
            @await Html.PartialAsync("~/Areas/Admin/Views/Shared/Partials/_AdminTopbar.cshtml")

            <div class="admin-content">
                @await Html.PartialAsync("~/Areas/Admin/Views/Shared/Partials/_Alerts.cshtml")
                @RenderBody()
            </div>
        </div>
    </div>

    @await Html.PartialAsync("~/Areas/Admin/Views/Shared/Partials/_AdminScripts.cshtml")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
