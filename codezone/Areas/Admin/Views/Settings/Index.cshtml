@model ScrapWebsite.Areas.Admin.ViewModels.Data.AdminSettingsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cài đặt";
    ViewData["AdminSection"] = "settings";
    ViewData["AdminSubSection"] = "";
}

<div class="admin-page-head">
  <h1>Cài đặt công ty <small>Thông tin liên hệ hiển thị toàn website</small></h1>
  <div class="aph-actions">
    <button class="btn btn-outline-dark" type="submit" form="companySettingsForm"><i class="bi bi-check-lg" aria-hidden="true"></i> Lưu thông tin</button>
    <button class="btn btn-primary" type="submit" form="smtpForm"><i class="bi bi-envelope-check" aria-hidden="true"></i> Lưu email (SMTP)</button>
    <button class="btn btn-outline-dark" type="submit" form="faviconForm"><i class="bi bi-check-lg" aria-hidden="true"></i> Lưu favicon</button>
  </div>
</div>

<div class="admin-form-grid">
  <div>
    <div class="admin-panel">
      <div class="panel-head"><h2>Thông tin chung</h2></div>
      <form id="companySettingsForm" class="panel-body" action="/admin/settings/SaveCompany" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label-tech" for="setName">Tên công ty</label>
            <input class="form-control" id="setName" name="CompanyName" type="text" value="@Model.CompanyName" maxlength="160" required>
          </div>
          <div class="col-md-4">
            <label class="form-label-tech" for="setTax">Mã số thuế</label>
            <input class="form-control" id="setTax" name="TaxCode" type="text" value="@Model.TaxCode" maxlength="60">
          </div>
          <div class="col-12">
            <label class="form-label-tech" for="setAddress">Địa chỉ</label>
            <input class="form-control" id="setAddress" name="Address" type="text" value="@Model.Address" maxlength="300">
          </div>
          <div class="col-md-6">
            <label class="form-label-tech" for="setHotline">Hotline</label>
            <input class="form-control" id="setHotline" name="Hotline" type="tel" value="@Model.Hotline" maxlength="40">
          </div>
          <div class="col-md-6">
            <label class="form-label-tech" for="setZalo">Zalo</label>
            <input class="form-control" id="setZalo" name="Zalo" type="text" value="@Model.Zalo" maxlength="80">
          </div>
          <div class="col-md-6">
            <label class="form-label-tech" for="setEmail">Email</label>
            <input class="form-control" id="setEmail" name="Email" type="email" value="@Model.Email" maxlength="160">
          </div>
          <div class="col-md-6">
            <label class="form-label-tech" for="setHours">Giờ làm việc</label>
            <input class="form-control" id="setHours" name="WorkingHours" type="text" value="@Model.WorkingHours" maxlength="120">
          </div>
          <div class="col-12">
            <label class="form-label-tech" for="setAreas">Khu vực thu mua</label>
            <input class="form-control" id="setAreas" name="PurchaseAreas" type="text" value="@Model.PurchaseAreas" maxlength="300">
            <small class="text-muted">Nhập các khu vực cách nhau bằng dấu phẩy.</small>
          </div>
          <div class="col-md-6">
            <label class="form-label-tech">Màu SĐT overlay trên ảnh</label>
            <div class="d-flex gap-2 align-items-center flex-wrap">
              <span class="hop-color-btn" title="Bấm để chọn màu">
                <span class="hop-color-dot" id="setHotlineOverlayDot"></span>
                <span class="hop-color-text">Chọn màu</span>
                <i class="bi bi-palette2" aria-hidden="true"></i>
                <input type="color" id="setHotlineOverlayColorPicker" value="@(string.IsNullOrWhiteSpace(Model.HotlineOverlayColor) ? "#E4570F" : Model.HotlineOverlayColor)" aria-label="Chọn màu SĐT overlay trên ảnh">
              </span>
              <button type="button" class="hop-color-reset" id="setHotlineOverlayReset" title="Trả về màu cam mặc định">
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Mặc định
              </button>
            </div>
            <input type="hidden" id="setHotlineOverlayColor" name="HotlineOverlayColor" value="@Model.HotlineOverlayColor">
            <small class="text-muted">Bấm "Chọn màu" để đổi màu số điện thoại hiển thị trên các ảnh (card, bài viết). "Mặc định" trả về màu cam chủ đạo.</small>
          </div>
        </div>
        <hr class="my-4">
        <h3 class="form-label-tech mb-3">Liên hệ nhanh</h3>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label-tech" for="setFacebook">Messenger / Facebook</label>
            <input class="form-control" id="setFacebook" name="Facebook" type="text" value="@Model.Facebook" maxlength="300" placeholder="https://m.me/... hoặc https://facebook.com/...">
            <small class="text-muted">Dùng cho nút Messenger nổi trên website.</small>
          </div>
          <div class="col-md-6">
            <label class="form-label-tech" for="setWhatsapp">WhatsApp</label>
            <input class="form-control" id="setWhatsapp" name="WhatsApp" type="text" value="@Model.WhatsApp" maxlength="80" placeholder="0985565323 hoặc https://wa.me/...">
            <small class="text-muted">Dùng cho nút WhatsApp nổi trên website (mặc định lấy theo hotline nếu để trống).</small>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div>
    <div class="admin-panel">
      <div class="panel-head"><h2>Favicon</h2></div>
      <form id="faviconForm" class="panel-body" action="/admin/settings/SaveFavicon" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="media-item mb-3">
          <span class="media-thumb"><img id="faviconPreview" src="@Model.FaviconUrl" alt="Favicon" loading="lazy"></span>
          <div class="media-meta">
            <strong id="faviconFileName">@Model.FaviconUrl</strong>
            <small>Icon nhỏ hiển thị trên tab trình duyệt. Nên dùng ảnh vuông, tối thiểu 512x512.</small>
          </div>
        </div>
        <label class="form-label-tech" for="faviconFile">Ảnh favicon mới</label>
        <input class="form-control js-image-preview-input" id="faviconFile" type="file" name="FaviconFile" accept="image/*" data-preview-target="faviconPreview" data-name-target="faviconFileName">
      </form>
    </div>

    <div class="admin-panel">
      <div class="panel-head"><h2>Email gửi thông báo liên hệ (SMTP)</h2></div>
      <form id="smtpForm" class="panel-body" action="/admin/settings/SaveSmtp" method="post">
        @Html.AntiForgeryToken()
        <p class="small text-muted">Mỗi khi khách gửi form liên hệ / báo giá nhanh, website sẽ dùng máy chủ SMTP này để gửi email thông báo tới địa chỉ nhận. Nếu bỏ trống, hệ thống dùng cấu hình mặc định trong file cấu hình.</p>
        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label-tech" for="smtpHost">Máy chủ SMTP (Host)</label>
            <input class="form-control" id="smtpHost" name="Host" type="text" value="@Model.SmtpHost" maxlength="160" placeholder="smtp.gmail.com">
          </div>
          <div class="col-md-4">
            <label class="form-label-tech" for="smtpPort">Cổng (Port)</label>
            <input class="form-control" id="smtpPort" name="Port" type="number" min="1" max="65535" value="@Model.SmtpPort">
          </div>
          <div class="col-12">
            <div class="form-check form-switch">
              <input class="form-check-input" id="smtpSsl" name="EnableSsl" type="checkbox" value="true" @(Model.SmtpEnableSsl ? "checked" : "")>
              <label class="form-check-label" for="smtpSsl">Bật SSL/TLS</label>
            </div>
          </div>
          <div class="col-md-6">
            <label class="form-label-tech" for="smtpUser">Tên đăng nhập SMTP</label>
            <input class="form-control" id="smtpUser" name="UserName" type="text" value="@Model.SmtpUserName" maxlength="160" autocomplete="off" placeholder="thường là địa chỉ email gửi">
          </div>
          <div class="col-md-6">
            <label class="form-label-tech" for="smtpPassword">Mật khẩu / App password</label>
            <input class="form-control" id="smtpPassword" name="Password" type="password" maxlength="200" autocomplete="new-password" placeholder="@(Model.SmtpHasPassword ? "•••••••• (đã lưu — bỏ trống để giữ nguyên)" : "Nhập mật khẩu ứng dụng")">
            <small class="text-muted">Vì bảo mật, mật khẩu không hiển thị lại. Bỏ trống nếu không muốn đổi. Với Gmail hãy dùng App Password.</small>
          </div>
          <div class="col-md-6">
            <label class="form-label-tech" for="smtpFromEmail">Email người gửi (From)</label>
            <input class="form-control" id="smtpFromEmail" name="FromEmail" type="email" value="@Model.SmtpFromEmail" maxlength="160">
          </div>
          <div class="col-md-6">
            <label class="form-label-tech" for="smtpFromName">Tên hiển thị người gửi</label>
            <input class="form-control" id="smtpFromName" name="FromName" type="text" value="@Model.SmtpFromName" maxlength="160">
          </div>
          <div class="col-12">
            <label class="form-label-tech" for="smtpToEmail">Email nhận thông báo liên hệ</label>
            <input class="form-control" id="smtpToEmail" name="ToEmail" type="email" value="@Model.SmtpToEmail" maxlength="200">
            <small class="text-muted">Địa chỉ email của admin sẽ nhận thư mỗi khi có yêu cầu mới từ website.</small>
          </div>
        </div>
      </form>
    </div>

    <div class="admin-panel">
      <div class="panel-head"><h2>Gửi email thử nghiệm</h2></div>
      <form class="panel-body" action="/admin/settings/SendSmtpTest" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-2 align-items-end">
          <div class="col-sm-8">
            <label class="form-label-tech" for="smtpTestEmail">Gửi tới</label>
            <input class="form-control" id="smtpTestEmail" name="testEmail" type="email" value="@Model.SmtpToEmail" maxlength="200">
          </div>
          <div class="col-sm-4">
            <button class="btn btn-primary w-100" type="submit"><i class="bi bi-send" aria-hidden="true"></i> Gửi thử</button>
          </div>
        </div>
        <small class="text-muted d-block mt-2">Dùng cấu hình SMTP đã lưu để kiểm tra kết nối. Hãy bấm "Lưu email (SMTP)" trước khi gửi thử.</small>
      </form>
    </div>

    <div class="admin-panel mb-0">
      <div class="panel-head"><h2>Trạng thái</h2></div>
      <div class="panel-body">
        <p class="small text-muted mb-0"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>Cache website hiện đặt @Model.CacheMinutes phút. Sau khi lưu, cache thông tin header/footer được làm mới ngay.</p>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        (function () {
            var picker = document.getElementById('setHotlineOverlayColorPicker');
            var hidden = document.getElementById('setHotlineOverlayColor');
            var dot = document.getElementById('setHotlineOverlayDot');
            var reset = document.getElementById('setHotlineOverlayReset');
            if (!picker || !hidden || !dot || !reset) return;
            var DEFAULT_COLOR = '#E4570F';
            function applyDot(value) { dot.style.background = value || DEFAULT_COLOR; }
            picker.addEventListener('input', function () {
                hidden.value = this.value;
                applyDot(this.value);
            });
            reset.addEventListener('click', function () {
                hidden.value = '';
                picker.value = DEFAULT_COLOR;
                applyDot('');
            });
            applyDot(hidden.value);
        })();
    </script>
}
