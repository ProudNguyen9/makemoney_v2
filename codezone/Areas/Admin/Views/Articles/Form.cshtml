@model ScrapWebsite.Areas.Admin.ViewModels.Forms.PostFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.Id == 0 ? "Viết bài mới" : $"Sửa bài viết: {Model.Title}";
    ViewData["AdminSection"] = "articles";
    ViewData["AdminSubSection"] = "form";

    var publishedAtValue = (Model.PublishedAt ?? DateTime.UtcNow).ToLocalTime().ToString("yyyy-MM-ddTHH:mm");
}

<div class="admin-page-head">
  <h1>@(Model.Id == 0 ? "Soạn bài viết" : $"Sửa: {Model.Title}")<small>Tin tức, bảng giá và kiến thức phế liệu</small></h1>
  <div class="aph-actions">
    <a class="btn btn-outline-dark" href="/admin/articles"><i class="bi bi-arrow-left" aria-hidden="true"></i> Danh sách</a>
    @if (Model.Id > 0)
    {
      <a class="btn btn-outline-dark" href="/tin-tuc/@Model.Slug" target="_blank" rel="noopener"><i class="bi bi-eye" aria-hidden="true"></i> Xem trước</a>
    }
    <button class="btn btn-primary" type="submit" form="articleForm"><i class="bi bi-check-lg" aria-hidden="true"></i> Lưu</button>
  </div>
</div>

<form id="articleForm" action="/admin/articles/Save" method="post" enctype="multipart/form-data">
  @Html.AntiForgeryToken()
  <input type="hidden" name="Id" value="@Model.Id">
  <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
  <div class="admin-form-grid">
    <div>
      <div class="admin-panel mb-0">
        <div class="panel-head">
          <h2>Nội dung</h2>
        </div>
        <div class="panel-body">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label-tech" for="articleTitle">Tiêu đề<span class="required-mark">*</span></label>
              <input class="form-control" id="articleTitle" name="Title" type="text" value="@Model.Title" required maxlength="255">
              <span class="text-danger small" asp-validation-for="Title"></span>
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="articleSlug">Slug</label>
              <input class="form-control" id="articleSlug" name="Slug" type="text" value="@Model.Slug" maxlength="255">
              <p class="small text-muted mt-1 mb-0">Bỏ trống sẽ tự sinh từ tiêu đề, tự động tránh trùng.</p>
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="articleCategory">Chuyên mục<span class="required-mark">*</span></label>
              <select class="form-select" id="articleCategory" name="PostCategoryId" required>
                <option value="">— Chọn chuyên mục —</option>
                @foreach (var category in Model.Categories)
                {
                  <option value="@category.Id" selected="@(Model.PostCategoryId == category.Id)">@category.Name</option>
                }
              </select>
              <span class="text-danger small" asp-validation-for="PostCategoryId"></span>
            </div>
            <div class="col-12">
              <label class="form-label-tech" for="articleTeaser">Trích dẫn</label>
              <textarea class="form-control" id="articleTeaser" name="Excerpt" rows="2" maxlength="700">@Model.Excerpt</textarea>
            </div>
            <div class="col-12">
              <label class="form-label-tech" for="articleContent">Nội dung bài viết (HTML)</label>
              <textarea class="form-control js-rich-editor" id="articleContent" name="Content" rows="14">@Model.Content</textarea>
              <p class="small text-muted mt-1 mb-0">Soạn bằng trình editor, xuất HTML raw cho trang client.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div>
      <div class="admin-panel mb-0">
        <div class="panel-head">
          <h2>Xuất bản</h2>
        </div>
        <div class="panel-body">
          <label class="form-label-tech" for="articleStatus">Trạng thái</label>
          <select class="form-select" id="articleStatus" name="Status">
            <option value="published" selected="@(Model.Status == "published")">Xuất bản</option>
            <option value="draft" selected="@(Model.Status != "published")">Bản nháp</option>
          </select>
          <label class="form-label-tech mt-3" for="articlePublishAt">Ngày đăng</label>
          <input class="form-control" id="articlePublishAt" name="PublishedAt" type="datetime-local" value="@publishedAtValue">
          <label class="form-label-tech mt-3" for="articleOrder">Thứ tự</label>
          <input class="form-control" id="articleOrder" name="SortOrder" type="number" min="0" max="9999" value="@Model.SortOrder">
          <div class="form-check form-switch mt-3">
            <input class="form-check-input" type="checkbox" id="articleFeatured" name="IsFeatured" value="true" checked="@(Model.IsFeatured)">
            <label class="form-check-label" for="articleFeatured">Nổi bật</label>
          </div>
        </div>
      </div>

      <div class="admin-panel mb-0">
        <div class="panel-head">
          <h2>Sản phẩm liên kết</h2>
        </div>
        <div class="panel-body">
          <div class="linked-product-list">
            @foreach (var product in Model.ProductOptions)
            {
              <label class="form-check linked-product-item">
                <input class="form-check-input" type="checkbox" name="LinkedProductIds" value="@product.Id" checked="@(Model.LinkedProductIds.Contains(product.Id))">
                <span class="form-check-label">
                  <strong>@product.Name</strong>
                  <small>@product.Slug</small>
                </span>
              </label>
            }
          </div>
          <p class="small text-muted mt-2 mb-0">Chọn nhiều sản phẩm để bài viết nhúng khối liên kết SEO ở trang client.</p>
        </div>
      </div>
    </div>
  </div>
</form>
