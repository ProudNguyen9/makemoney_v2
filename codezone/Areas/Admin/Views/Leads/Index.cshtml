          <button class="btn btn-outline-dark" type="button"><i class="bi bi-funnel" aria-hidden="true"></i> Xuất Excel</button>
        </div>
      </div>

      <!-- backend: GET /admin/leads?status=&amp;scrap=&amp;area=&amp;from=&amp;q= -->
      <form class="admin-filter" action="#" method="get">
        <span class="admin-filter-label">Lọc</span>
        <select class="form-select" aria-label="Lọc theo trạng thái">
          <option value="" selected>Tất cả</option>
          <option value="new">Mới</option>
          <option value="processing">Đang xử lý</option>
          <option value="done">Hoàn tất</option>
          <option value="cancel">Đã hủy</option>
        </select>
        <select class="form-select" aria-label="Lọc theo loại phế liệu">
          <option value="" selected>Tất cả</option>
          <option value="dong">Nhóm đồng</option>
          <option value="sat">Sắt</option>
          <option value="nhom">Nhôm</option>
          <option value="inox">Inox</option>
          <option value="may-moc">Máy móc</option>
        </select>
        <select class="form-select" aria-label="Lọc theo khu vực">
          <option value="" selected>Tất cả</option>
          <option value="dong-nai">Đồng Nai</option>
          <option value="tp-hcm">TP.HCM</option>
          <option value="binh-duong">Bình Dương</option>
        </select>
        <input class="form-control" type="date" aria-label="Lọc từ ngày">
        <input class="form-control" type="search" placeholder="Tìm SĐT, tên…" aria-label="Tìm SĐT, tên">
        <div class="spacer"></div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Tìm</button>
      </form>

