<!-- backend: GET /admin/leads — danh sách yêu cầu báo giá -->
      <div class="admin-page-head">
        <h1>Yêu cầu báo giá<small>Quản lý lead từ form, hotline và Zalo</small></h1>
        <div class="aph-actions">
