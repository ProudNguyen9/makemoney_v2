@model ScrapWebsite.Areas.Admin.ViewModels.Data.AdminLeadDetailDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Chi tiết yêu cầu {Model.Code}";
    ViewData["AdminSection"] = "leads";
    ViewData["AdminSubSection"] = "detail";

    string SourceLabel(string source) => source switch
    {
        "quick_quote" => "Form báo giá nhanh",
        "contact" => "Form liên hệ",
        _ => source
    };

    var zaloDigits = new string((Model.Zalo ?? Model.Phone).Where(char.IsDigit).ToArray());
    var statusClass = Model.Status == "contacted" ? "st-done" : "st-processing";
    var statusLabel = Model.Status == "contacted" ? "Đã liên hệ" : "Mới";
}

<!-- LEAD-004: GET /admin/leads/detail/{id} — chi tiết một lead đọc từ DB -->
<div class="admin-page-head">
  <h1>Yêu cầu báo giá #@Model.Code<small>Tiếp nhận @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · Nguồn: @SourceLabel(Model.SourceForm)</small></h1>
  <div class="aph-actions">
    <a class="btn btn-primary" href="tel:@Model.Phone"><i class="bi bi-telephone-fill" aria-hidden="true"></i> Gọi khách</a>
    <a class="btn btn-outline-dark" href="https://zalo.me/@zaloDigits" target="_blank" rel="noopener"><i class="bi bi-chat-dots-fill" aria-hidden="true"></i> Mở Zalo</a>
    <a class="btn btn-outline-dark" href="/admin/leads"><i class="bi bi-arrow-left" aria-hidden="true"></i> Danh sách</a>
  </div>
</div>

<div class="admin-form-grid">
  <div>
    <!-- Thông tin khách hàng -->
    <div class="admin-panel">
      <div class="panel-head">
        <h2>Thông tin khách hàng</h2>
      </div>
      <div class="panel-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label-tech" for="leadName">Họ tên</label>
            <input class="form-control" id="leadName" type="text" value="@Model.CustomerName" readonly>
          </div>
          <div class="col-md-6">
            <label class="form-label-tech" for="leadPhone">Số điện thoại</label>
            <input class="form-control" id="leadPhone" type="tel" value="@Model.Phone" readonly>
          </div>
          <div class="col-md-6">
            <label class="form-label-tech" for="leadZalo">Zalo</label>
            <input class="form-control" id="leadZalo" type="tel" value="@Model.Zalo" readonly>
          </div>
          <div class="col-md-6">
            <label class="form-label-tech" for="leadEmail">Email</label>
            <input class="form-control" id="leadEmail" type="email" value="@Model.Email" readonly>
          </div>
          <div class="col-md-6">
            <label class="form-label-tech" for="leadArea">Khu vực</label>
            <input class="form-control" id="leadArea" type="text" value="@Model.Area" readonly>
          </div>
          <div class="col-md-6">
            <label class="form-label-tech" for="leadStatus">Trạng thái</label>
            <input class="form-control" id="leadStatus" type="text" value="@statusLabel" readonly>
          </div>
          <div class="col-12">
            <label class="form-label-tech" for="leadNoteCustomer">Nội dung khách gửi</label>
            <textarea class="form-control" id="leadNoteCustomer" rows="3" readonly>@Model.Message</textarea>
          </div>
          @if (Model.Status != "contacted")
          {
            <div class="col-12">
              <form action="/admin/leads/MarkContacted" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id">
                <button class="btn btn-primary" type="submit"><i class="bi bi-check2-circle" aria-hidden="true"></i> Đánh dấu đã liên hệ</button>
              </form>
            </div>
          }
        </div>
      </div>
    </div>

    <!-- Hình ảnh khách gửi -->
    @if (Model.ImageUrls.Count > 0)
    {
      <div class="admin-panel">
        <div class="panel-head">
          <h2>Hình ảnh khách gửi</h2>
          <div class="panel-head-actions">
            <span class="admin-pagination">@Model.ImageUrls.Count ảnh</span>
          </div>
        </div>
        <div class="panel-body">
          <div class="lead-gallery">
            @for (var i = 0; i < Model.ImageUrls.Count; i++)
            {
              var index = i + 1;
              <a href="@Model.ImageUrls[i]" target="_blank" rel="noopener">
                <img src="@Model.ImageUrls[i]" alt="Ảnh @index — phế liệu khách chụp gửi" width="96" height="72" loading="lazy">
              </a>
            }
          </div>
          <p class="small text-muted mb-0 mt-2"><i class="bi bi-zoom-in" aria-hidden="true"></i> Click để xem ảnh gốc.</p>
        </div>
      </div>
    }
  </div>

  <div>
    <!-- Thông tin lô hàng -->
    <div class="admin-panel">
      <div class="panel-head">
        <h2>Thông tin lô hàng</h2>
      </div>
      <div class="panel-body">
        <span class="form-label-tech">Loại phế liệu chính</span>
        <p class="mb-3">@(string.IsNullOrWhiteSpace(Model.ScrapType) ? "Chưa chọn" : Model.ScrapType)</p>
        <span class="form-label-tech">Số lượng ước tính</span>
        <p class="mb-3">@(string.IsNullOrWhiteSpace(Model.QuantityText) ? "—" : Model.QuantityText)</p>
        <span class="form-label-tech">Khu vực</span>
        <p class="mb-3">@(string.IsNullOrWhiteSpace(Model.Area) ? "—" : Model.Area)</p>
        <span class="form-label-tech">Trạng thái hiện tại</span>
        <p class="mb-0"><span class="badge-status @statusClass">@statusLabel</span></p>
      </div>
    </div>

    <!-- Nguồn & theo dõi -->
    <div class="admin-panel mb-0">
      <div class="panel-head">
        <h2>Nguồn &amp; theo dõi</h2>
      </div>
      <div class="panel-body">
        <dl class="row small mb-0">
          <dt class="col-5 fw-normal text-muted">Nguồn form</dt>
          <dd class="col-7">@SourceLabel(Model.SourceForm)</dd>
          <dt class="col-5 fw-normal text-muted">Trang nguồn</dt>
          <dd class="col-7">@(string.IsNullOrWhiteSpace(Model.SourceUrl) ? "—" : Model.SourceUrl)</dd>
          <dt class="col-5 fw-normal text-muted">Tiếp nhận lúc</dt>
          <dd class="col-7">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
      </div>
    </div>
  </div>
</div>
