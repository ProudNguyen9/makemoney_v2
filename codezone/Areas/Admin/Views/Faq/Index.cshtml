@model ScrapWebsite.Areas.Admin.ViewModels.Data.AdminFaqListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Hỏi đáp";
    ViewData["AdminSection"] = "faq";
    ViewData["AdminSubSection"] = "";

    string AssignLabel(string value) => value switch
    {
        "home" => "Trang chủ",
        "scrap" => "Loại phế liệu",
        "services" => "Dịch vụ",
        "service" => "Dịch vụ",
        "location" => "Khu vực",
        "referral" => "Hoa hồng",
        _ => value
    };
}

<div class="admin-page-head">
  <h1>Câu hỏi thường gặp<small>Gán câu hỏi cho từng trang — @Model.TotalCount câu hỏi</small></h1>
  <div class="aph-actions">
    <a class="btn btn-primary" href="/admin/faq/form"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm câu hỏi</a>
  </div>
</div>

<form class="admin-filter" action="/admin/faq" method="get">
  <span class="admin-filter-label">Gán vào</span>
  <select class="form-select" name="assign" aria-label="Lọc theo trang gán FAQ">
    <option value="" selected="@(string.IsNullOrEmpty(Model.EntityType))">Tất cả</option>
    <option value="home" selected="@(Model.EntityType == "home")">Trang chủ</option>
    <option value="scrap" selected="@(Model.EntityType == "scrap")">Loại phế liệu</option>
    <option value="services" selected="@(Model.EntityType == "services" || Model.EntityType == "service")">Dịch vụ</option>
    <option value="location" selected="@(Model.EntityType == "location")">Khu vực</option>
    <option value="referral" selected="@(Model.EntityType == "referral")">Hoa hồng</option>
  </select>
  <input class="form-control" name="q" type="search" value="@Model.Query" placeholder="Tìm theo câu hỏi..." aria-label="Tìm theo câu hỏi">
  <div class="spacer"></div>
  <button class="btn btn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Tìm</button>
</form>

<section class="admin-panel">
  <div class="table-admin-wrap">
    <table class="table table-admin align-middle">
      <thead>
        <tr>
          <th>Câu hỏi</th>
          <th>Gán vào</th>
          <th>Thứ tự</th>
          <th>Trạng thái</th>
          <th><span class="visually-hidden">Thao tác</span></th>
        </tr>
      </thead>
      <tbody>
      @foreach (var item in Model.Items)
      {
        <tr>
          <td><strong><a href="/admin/faq/Form/@item.Id">@item.Question</a></strong></td>
          <td><span class="tag-min">@AssignLabel(item.EntityType)</span></td>
          <td>
            <form method="post" action="/admin/faq/UpdateSort" class="d-flex gap-1" style="max-width:110px">
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@item.Id">
              <input type="hidden" name="assign" value="@Model.EntityType">
              <input type="hidden" name="q" value="@Model.Query">
              <input type="hidden" name="page" value="@Model.Page">
              <input class="form-control form-control-sm" type="number" min="1" max="9999" name="sortOrder" value="@item.SortOrder" title="Vị trí trong nhóm FAQ (1 = đầu danh sách). Lưu sẽ tự dồn các dòng khác." aria-label="Thứ tự @item.Question">
              <button class="btn btn-outline-dark btn-sm" type="submit" aria-label="Lưu thứ tự @item.Question"><i class="bi bi-check" aria-hidden="true"></i></button>
            </form>
          </td>
          <td>
            <form method="post" action="/admin/faq/ToggleStatus" data-autosubmit>
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@item.Id">
              <input type="hidden" name="assign" value="@Model.EntityType">
              <input type="hidden" name="q" value="@Model.Query">
              <input type="hidden" name="page" value="@Model.Page">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" @(item.Status == "published" ? "checked" : "") aria-label="Hiển thị @item.Question">
              </div>
            </form>
          </td>
          <td>
            <div class="ta-actions">
              <a href="/admin/faq/Form/@item.Id" aria-label="Sửa @item.Question"><i class="bi bi-pencil" aria-hidden="true"></i></a>
              <form method="post" action="/admin/faq/Delete" class="d-inline" onsubmit="return confirm('Xóa FAQ &quot;@item.Question&quot;?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id">
                <input type="hidden" name="assign" value="@Model.EntityType">
                <input type="hidden" name="q" value="@Model.Query">
                <input type="hidden" name="page" value="@Model.Page">
                <button class="act-danger" type="submit" aria-label="Xóa @item.Question"><i class="bi bi-trash" aria-hidden="true"></i></button>
              </form>
            </div>
          </td>
        </tr>
      }
      @if (Model.Items.Count == 0)
      {
        <tr>
          <td colspan="5" class="text-center text-muted py-4">Chưa có câu hỏi nào khớp bộ lọc.</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
  <div class="panel-foot">
    @await Html.PartialAsync("~/Areas/Admin/Views/Shared/Partials/_AdminPagination.cshtml", Model.Pager)
  </div>
</section>
