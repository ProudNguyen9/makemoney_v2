@model ScrapWebsite.Areas.Admin.ViewModels.Data.AdminScrapListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Loại phế liệu";
    ViewData["AdminSection"] = "scrap";
    ViewData["AdminSubSection"] = "index";

    string StatusLabel(string status) => status == "published" ? "Đang hiển thị" : status == "draft" ? "Ẩn" : status;
}

<div class="admin-page-head">
  <h1>Loại phế liệu<small>Quản lý @Model.TotalCount loại phế liệu — bấm vào tên hoặc biểu tượng bút chì để sửa</small></h1>
  <div class="aph-actions">
    <a class="btn btn-primary" href="/admin/scrap/Form"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm loại phế liệu</a>
  </div>
</div>

<form class="admin-filter" action="/admin/scrap" method="get">
  <span class="admin-filter-label">Nhóm</span>
  <select class="form-select" name="group" aria-label="Lọc theo nhóm">
    <option value="">Tất cả</option>
    @foreach (var category in Model.Categories)
    {
      <option value="@category.Slug" selected="@(Model.Group == category.Slug)">@category.Name</option>
    }
  </select>
  <select class="form-select" name="status" aria-label="Lọc theo trạng thái">
    <option value="">Tất cả</option>
    <option value="published" selected="@(Model.Status == "published")">Đang hiển thị</option>
    <option value="draft" selected="@(Model.Status == "draft")">Ẩn</option>
  </select>
  <input class="form-control" name="q" type="search" value="@Model.Query" placeholder="Tìm theo tên, slug..." aria-label="Tìm theo tên, slug">
  <div class="spacer"></div>
  <button class="btn btn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Tìm</button>
</form>

<div class="admin-panel">
  <div class="table-admin-wrap">
    <table class="table table-admin align-middle">
      <thead>
        <tr>
          <th>Ảnh</th>
          <th>Tên</th>
          <th>Nhóm</th>
          <th>Slug</th>
          <th>Giá tham khảo</th>
          <th>Trạng thái</th>
          <th>Vị trí</th>
          <th><span class="visually-hidden">Thao tác</span></th>
        </tr>
      </thead>
      <tbody>
      @foreach (var item in Model.Items)
      {
        <tr>
          <td class="ta-title">
            <a href="/admin/scrap/Form/@item.Id"><img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/assets/images/imported/brand/banner-1.jpg" : item.ImageUrl)" alt="@item.Name" width="56" height="42" loading="lazy"></a>
          </td>
          <td><strong><a class="text-decoration-none" href="/admin/scrap/Form/@item.Id">@item.Name</a></strong></td>
          <td>@item.CategoryName</td>
          <td><code>@item.Slug</code></td>
          <td>@item.PriceText</td>
          <td>
            <form method="post" action="/admin/scrap/ToggleStatus" data-autosubmit>
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@item.Id">
              <input type="hidden" name="group" value="@Model.Group">
              <input type="hidden" name="status" value="@Model.Status">
              <input type="hidden" name="q" value="@Model.Query">
              <input type="hidden" name="page" value="@Model.Page">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" @(item.Status == "published" ? "checked" : "") aria-label="Hiển thị @item.Name">
              </div>
            </form>
          </td>
          <td>
            <form method="post" action="/admin/scrap/UpdateSort" class="d-flex gap-1" style="max-width:110px">
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@item.Id">
              <input type="hidden" name="group" value="@Model.Group">
              <input type="hidden" name="status" value="@Model.Status">
              <input type="hidden" name="q" value="@Model.Query">
              <input type="hidden" name="page" value="@Model.Page">
              <input class="form-control form-control-sm" type="number" min="1" max="9999" name="sortOrder" value="@item.SortOrder" title="Vị trí hiển thị (1 = đầu danh sách). Lưu sẽ tự dồn các dòng khác." aria-label="Vị trí @item.Name">
              <button class="btn btn-outline-dark btn-sm" type="submit" aria-label="Lưu vị trí @item.Name"><i class="bi bi-check" aria-hidden="true"></i></button>
            </form>
          </td>
          <td>
            <div class="ta-actions">
              <a href="/admin/scrap/Form/@item.Id" aria-label="Sửa @item.Name"><i class="bi bi-pencil" aria-hidden="true"></i></a>
              <form method="post" action="/admin/scrap/Delete" class="d-inline" onsubmit="return confirm('Xóa loại phế liệu &quot;@item.Name&quot; kèm dòng giá và ảnh?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id">
                <input type="hidden" name="group" value="@Model.Group">
                <input type="hidden" name="status" value="@Model.Status">
                <input type="hidden" name="q" value="@Model.Query">
                <input type="hidden" name="page" value="@Model.Page">
                <button class="act-danger" type="submit" aria-label="Xóa @item.Name"><i class="bi bi-trash" aria-hidden="true"></i></button>
              </form>
            </div>
          </td>
        </tr>
      }
      @if (Model.Items.Count == 0)
      {
        <tr>
          <td colspan="8" class="text-center text-muted py-4">Chưa có loại phế liệu nào khớp bộ lọc.</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
  <div class="panel-foot">
    @await Html.PartialAsync("~/Areas/Admin/Views/Shared/Partials/_AdminPagination.cshtml", Model.Pager)
  </div>
</div>
