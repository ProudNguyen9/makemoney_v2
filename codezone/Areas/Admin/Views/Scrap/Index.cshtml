@model ScrapWebsite.Areas.Admin.ViewModels.Data.AdminScrapListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Loại phế liệu";
    ViewData["AdminSection"] = "scrap";
    ViewData["AdminSubSection"] = "index";

    string StatusLabel(string status) => status == "published" ? "Đang hiển thị" : status == "draft" ? "Ẩn" : status;
    string StatusClass(string status) => status == "published" ? "st-published" : status == "draft" ? "st-draft" : "st-processing";
}

<div class="admin-page-head">
  <h1>Loại phế liệu<small>Đọc dữ liệu thật từ database hiện có</small></h1>
  <div class="aph-actions">
    <button class="btn btn-primary" type="button" disabled title="Phase sau mới mở thêm mới"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm loại phế liệu</button>
  </div>
</div>

<form class="admin-filter" action="/admin/scrap" method="get">
  <span class="admin-filter-label">Nhóm</span>
  <select class="form-select" name="group" aria-label="Lọc theo nhóm">
    <option value="">Tất cả</option>
    @foreach (var category in Model.Categories)
    {
      <option value="@category.Slug" selected="@(Model.Group == category.Slug)">@category.Name</option>
    }
  </select>
  <select class="form-select" name="status" aria-label="Lọc theo trạng thái">
    <option value="">Tất cả</option>
    <option value="published" selected="@(Model.Status == "published")">Đang hiển thị</option>
    <option value="draft" selected="@(Model.Status == "draft")">Ẩn</option>
  </select>
  <input class="form-control" name="q" type="search" value="@Model.Query" placeholder="Tìm theo tên, slug..." aria-label="Tìm theo tên, slug">
  <div class="spacer"></div>
  <button class="btn btn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Tìm</button>
</form>

<div class="admin-panel">
  <div class="table-admin-wrap">
    <table class="table table-admin align-middle">
      <thead>
        <tr>
          <th>Ảnh</th>
          <th>Tên</th>
          <th>Nhóm</th>
          <th>Slug</th>
          <th>Giá tham khảo</th>
          <th>Nổi bật</th>
          <th>Trạng thái</th>
          <th>Thứ tự</th>
          <th><span class="visually-hidden">Thao tác</span></th>
        </tr>
      </thead>
      <tbody>
      @foreach (var item in Model.Items)
      {
        <tr>
          <td class="ta-title">
            <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/assets/images/imported/brand/banner-1.jpg" : item.ImageUrl)" alt="@item.Name" width="56" height="42" loading="lazy">
          </td>
          <td><strong>@item.Name</strong></td>
          <td>@item.CategoryName</td>
          <td><code>@item.Slug</code></td>
          <td>@item.PriceText</td>
          <td><span class="tag-min @(item.IsFeatured ? "tag-min--primary" : "")">@(item.IsFeatured ? "Nổi bật" : "Thường")</span></td>
          <td><span class="badge-status @StatusClass(item.Status)">@StatusLabel(item.Status)</span></td>
          <td><input class="form-control form-control-sm" type="number" min="0" value="@item.SortOrder" aria-label="Thứ tự @item.Name" disabled></td>
          <td>
            <div class="ta-actions">
              <button type="button" disabled aria-label="Sửa @item.Name"><i class="bi bi-pencil" aria-hidden="true"></i></button>
              <button class="act-danger" type="button" disabled aria-label="Xóa @item.Name"><i class="bi bi-trash" aria-hidden="true"></i></button>
            </div>
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
  <div class="panel-foot">
    <div class="admin-pagination">Hiển thị @Model.Items.Count / @Model.TotalCount loại</div>
    <span class="small text-muted">Read-only phase: dữ liệu lấy từ ScrapWebsiteLocal, chưa mở lưu thay đổi.</span>
  </div>
</div>
