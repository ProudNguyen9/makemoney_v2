@model ScrapWebsite.Areas.Admin.ViewModels.Forms.ScrapItemFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.Id == 0 ? "Thêm loại phế liệu" : $"Sửa loại phế liệu: {Model.Name}";
    ViewData["AdminSection"] = "scrap";
    ViewData["AdminSubSection"] = "form";
    var rowNumber = 0;
}

<div class="admin-page-head">
  <h1>@(Model.Id == 0 ? "Thêm loại phế liệu" : $"Sửa: {Model.Name}")<small>Ảnh tải lên được tự động nén và chuyển sang WebP để tiết kiệm ổ đĩa</small></h1>
  <div class="aph-actions">
    @if (Model.Id > 0)
    {
      <a class="btn btn-outline-dark" href="/phe-lieu/@Model.Slug" target="_blank" rel="noopener"><i class="bi bi-eye" aria-hidden="true"></i> Xem trang công khai</a>
    }
    <a class="btn btn-outline-dark" href="/admin/scrap"><i class="bi bi-arrow-left" aria-hidden="true"></i> Danh sách</a>
    <button class="btn btn-primary" type="submit" form="scrapTypeForm"><i class="bi bi-check-lg" aria-hidden="true"></i> Lưu</button>
  </div>
</div>

<form id="scrapTypeForm" action="/admin/scrap/Save" method="post" enctype="multipart/form-data">
  @Html.AntiForgeryToken()
  <input type="hidden" name="Id" value="@Model.Id">
  <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
  <div class="admin-form-grid">
    <div>
      <!-- Thông tin chính -->
      <div class="admin-panel">
        <div class="panel-head">
          <h2>Thông tin chính</h2>
        </div>
        <div class="panel-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label-tech" for="scrapGroup">Nhóm<span class="required-mark">*</span></label>
              <select class="form-select" id="scrapGroup" name="CategoryId" required>
                <option value="">— Chọn nhóm —</option>
                @foreach (var category in Model.Categories)
                {
                  <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
                }
              </select>
              <span class="text-danger small" asp-validation-for="CategoryId"></span>
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="scrapName">Tên loại phế liệu<span class="required-mark">*</span></label>
              <input class="form-control" id="scrapName" name="Name" type="text" value="@Model.Name" required maxlength="255">
              <span class="text-danger small" asp-validation-for="Name"></span>
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="scrapSlug">Slug</label>
              <div class="input-with-suffix">
                <input class="form-control" id="scrapSlug" name="Slug" type="text" value="@Model.Slug" maxlength="255" placeholder="Tự sinh từ tên nếu bỏ trống">
                <span class="input-suffix">.html</span>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label-tech" for="scrapPriceRef">Giá tham khảo (hiển thị ở danh sách)</label>
              <input class="form-control" id="scrapPriceRef" name="PriceLabel" type="text" value="@Model.PriceLabel" maxlength="255" placeholder="VD: 75.000 – 95.000đ/kg (bỏ trống để tự lấy giá thấp nhất)">
            </div>
            <div class="col-12">
              <label class="form-label-tech" for="scrapTeaser">Mô tả ngắn</label>
              <textarea class="form-control" id="scrapTeaser" name="ShortDescription" rows="2" maxlength="500">@Model.ShortDescription</textarea>
            </div>
            <div class="col-12">
              <span class="form-label-tech">Nội dung trang</span>
              <textarea class="form-control js-rich-editor" name="Description" rows="12">@Model.Description</textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- Bảng giá áp dụng -->
      <div class="admin-panel mb-0">
        <div class="panel-head">
          <h2>Bảng giá áp dụng</h2>
        </div>
        <div class="panel-body">
          <div class="table-admin-wrap">
            <table class="table table-admin align-middle" id="priceRowsTable">
              <thead>
                <tr>
                  <th>Phân loại</th>
                  <th>Giá (đ)</th>
                  <th>Đơn vị</th>
                  <th><span class="visually-hidden">Thao tác</span></th>
                </tr>
              </thead>
              <tbody>
              @foreach (var row in Model.PriceRows)
              {
                  <tr>
                    <td>
                      <input type="hidden" name="PriceRows.Index" value="@rowNumber">
                      <input class="form-control form-control-sm" type="text" name="PriceRows[@rowNumber].Label" value="@row.Label" placeholder="Sạch, Loại 1..." aria-label="Phân loại dòng @(rowNumber + 1)">
                    </td>
                    <td><input class="form-control form-control-sm" type="number" min="0" step="any" name="PriceRows[@rowNumber].PriceValue" value="@(row.PriceValue?.ToString("0") ?? "")" aria-label="Giá dòng @(rowNumber + 1)"></td>
                    <td>
                      <select class="form-select form-select-sm" name="PriceRows[@rowNumber].Unit" aria-label="Đơn vị dòng @(rowNumber + 1)">
                        @foreach (var unit in new[] { "kg", "tấn", "cái", "m", "lô" })
                        {
                          <option value="@unit" selected="@(row.Unit == unit)">@unit</option>
                        }
                      </select>
                    </td>
                    <td>
                      <div class="ta-actions">
                        <button class="act-danger" type="button" data-row-remove aria-label="Xóa phân loại dòng @(rowNumber + 1)"><i class="bi bi-trash" aria-hidden="true"></i></button>
                      </div>
                    </td>
                  </tr>
                  rowNumber++;
              }
              </tbody>
            </table>
          </div>
          <button class="btn btn-outline-dark btn-sm mt-3" type="button" id="addPriceRow"><i class="bi bi-plus" aria-hidden="true"></i> Thêm phân loại</button>
          <p class="small text-muted mt-2 mb-0">Lưu ý: lưu form sẽ thay thế toàn bộ dòng giá cũ của loại này; mỗi lần đổi giá được ghi lịch sử.</p>
        </div>
      </div>
    </div>

    <div>
      <!-- Hình ảnh -->
      <div class="admin-panel">
        <div class="panel-head">
          <h2>Hình ảnh</h2>
        </div>
        <div class="panel-body">
          @if (!string.IsNullOrWhiteSpace(Model.CurrentThumbUrl))
          {
            <div class="mb-2">
              <img src="@Model.CurrentThumbUrl" alt="Ảnh đại diện hiện tại" width="96" height="72" class="rounded border" style="object-fit:cover" loading="lazy">
              <div class="form-check mt-1">
                <input class="form-check-input" type="checkbox" name="RemoveThumb" id="removeThumb" value="true">
                <label class="form-check-label small" for="removeThumb">Xóa ảnh đại diện hiện tại</label>
              </div>
            </div>
          }
          <span class="form-label-tech">Ảnh đại diện (4:3)</span>
          @await Html.PartialAsync("~/Areas/Admin/Views/Shared/Partials/_UploadDrop.cshtml", new codezone.Areas.Admin.ViewModels.UploadDropViewModel("Tải ảnh lên", "PNG, JPG — tối thiểu 800×600, tự chuyển WebP", "ThumbFile", false))
          @if (!string.IsNullOrWhiteSpace(Model.CurrentBannerUrl))
          {
            <div class="mb-2 mt-3">
              <img src="@Model.CurrentBannerUrl" alt="Ảnh banner hiện tại" width="96" height="60" class="rounded border" style="object-fit:cover" loading="lazy">
              <div class="form-check mt-1">
                <input class="form-check-input" type="checkbox" name="RemoveBanner" id="removeBanner" value="true">
                <label class="form-check-label small" for="removeBanner">Xóa ảnh banner hiện tại</label>
              </div>
            </div>
          }
          <span class="form-label-tech mt-3">Ảnh banner (16:10)</span>
          @await Html.PartialAsync("~/Areas/Admin/Views/Shared/Partials/_UploadDrop.cshtml", new codezone.Areas.Admin.ViewModels.UploadDropViewModel("Tải ảnh lên", "PNG, JPG — tối thiểu 1600×1000, tự chuyển WebP", "BannerFile", false))
        </div>
      </div>

      <!-- Cấu hình hiển thị -->
      <div class="admin-panel">
        <div class="panel-head">
          <h2>Cấu hình hiển thị</h2>
        </div>
        <div class="panel-body">
          <label class="form-label-tech" for="scrapStatus">Trạng thái</label>
          <select class="form-select" id="scrapStatus" name="Status">
            <option value="published" selected="@(Model.Status == "published")">Đang hiển thị</option>
            <option value="draft" selected="@(Model.Status != "published")">Ẩn</option>
          </select>
          <label class="form-label-tech mt-3" for="scrapOrder">Vị trí hiển thị</label>
          <input class="form-control" id="scrapOrder" name="SortOrder" type="number" min="0" max="9999" value="@Math.Max(Model.SortOrder, 1)" title="1 = đầu danh sách. Nhập nhỏ hơn 1 sẽ tự về vị trí đầu. Lưu sẽ tự dồn vị trí các loại khác.">
          <span class="text-danger small" asp-validation-for="SortOrder"></span>
          <p class="small text-muted mt-1 mb-0">Số nhỏ hiện trước. Lưu sẽ tự động chèn vào đúng vị trí và đánh lại số liên tục (không trùng).</p>
        </div>
      </div>
    </div>
  </div>
</form>

@section Scripts {
<script>
  (function () {
    'use strict';
    var nextIndex = @Model.PriceRows.Count;

    document.getElementById('addPriceRow').addEventListener('click', function () {
      var tbody = document.querySelector('#priceRowsTable tbody');
      var tr = document.createElement('tr');
      var index = nextIndex++;
      tr.innerHTML =
        '<td>' +
          '<input type="hidden" name="PriceRows.Index" value="' + index + '">' +
          '<input class="form-control form-control-sm" type="text" name="PriceRows[' + index + '].Label" placeholder="Sạch, Loại 1...">' +
        '</td>' +
        '<td><input class="form-control form-control-sm" type="number" min="0" step="any" name="PriceRows[' + index + '].PriceValue"></td>' +
        '<td><select class="form-select form-select-sm" name="PriceRows[' + index + '].Unit">' +
          '<option value="kg">kg</option><option value="tấn">tấn</option><option value="cái">cái</option><option value="m">m</option><option value="lô">lô</option>' +
        '</select></td>' +
        '<td><div class="ta-actions"><button class="act-danger" type="button" data-row-remove><i class="bi bi-trash" aria-hidden="true"></i></button></div></td>';
      tbody.appendChild(tr);
    });

    // Tự sinh slug từ tên khi bỏ trống
    var nameInput = document.getElementById('scrapName');
    var slugInput = document.getElementById('scrapSlug');
    function toSlug(value) {
      return value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '').toLowerCase();
    }
    nameInput.addEventListener('blur', function () {
      if (!slugInput.value.trim()) slugInput.value = toSlug(nameInput.value);
    });
  })();
</script>
}
