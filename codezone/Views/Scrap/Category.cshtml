@model ScrapCategoryPageViewModel
@inject ScrapWebsite.Services.Interfaces.ISiteChromeService SiteChromeService
@{
    ViewData["Title"] = Model.Seo.Title;
    var current = Model.Current;
    var chrome = await SiteChromeService.GetAsync(Context.RequestAborted);
}
<main>
  <section class="page-hero" aria-label="Danh mục phế liệu thu mua">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="~/assets/images/scrap/scrap-misc.svg" alt="" width="1600" height="900" loading="lazy">
    </div>
    <div class="container">
      <div class="page-hero-inner">
        <span class="tech-label">Phế liệu thu mua</span>
        @if (current is null)
        {
          <h1>Danh mục phế liệu theo nhóm</h1>
          <p class="page-hero-desc">Chọn một nhóm chất liệu để xem tất cả các loại đang thu mua cùng giá tham khảo theo kg.</p>
        }
        else
        {
          <h1>Thu mua phế liệu @current.Name giá cao</h1>
          <p class="page-hero-desc">@current.ItemCount loại @current.Name.ToLower() đang thu mua — giá tham khảo theo kg, chốt giá chính xác sau khi xem hình hoặc khảo sát tận nơi.</p>
        }
        <ol class="breadcrumb-line">
          <li><a href="/">Trang chủ</a></li>
          <li><a href="/phe-lieu">Phế liệu thu mua</a></li>
          @if (current is null)
          {
            <li aria-current="page">Danh mục theo nhóm</li>
          }
          else
          {
            <li aria-current="page">@current.Name</li>
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="group-title">
    <div class="container">
      @if (current is null)
      {
        <!-- Filter bar thiết kế đẹp, vừa khít -->
        <div class="cat-filter-bar reveal" style="display:flex; gap:0.75rem; flex-wrap:wrap; align-items:center; background:linear-gradient(180deg,#FFFFFF 0%,#FFFBF5 100%); border:1px solid #F0E6D8; border-radius:14px; padding:0.85rem 1rem; box-shadow:0 10px 28px rgba(228,87,15,0.07), 0 2px 8px rgba(22,24,28,0.04); margin-bottom:1.5rem;">
          <span style="display:inline-flex; align-items:center; gap:0.5rem; font-family:Oswald; font-size:0.8rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:#E4570F; flex:0 0 auto;"><i class="bi bi-sliders" aria-hidden="true" style="font-size:1rem;"></i> Bộ lọc</span>
          <span style="width:1px; height:28px; background:#E3E1DC; flex:0 0 auto;" class="d-none d-sm-block" aria-hidden="true"></span>
          <div style="position:relative; flex:1 1 220px; min-width:180px;">
            <i class="bi bi-search" aria-hidden="true" style="position:absolute; left:0.9rem; top:50%; transform:translateY(-50%); color:#9AA3AE; font-size:0.95rem;"></i>
            <input id="catSearch" type="search" class="form-control" placeholder="Tìm nhóm: Đồng, Nhôm, Sắt..." style="padding-left:2.5rem; height:42px; border-radius:10px; border:1px solid #E8E0D6; background:#FFFFFF; font-size:0.92rem; box-shadow:inset 0 1px 2px rgba(22,24,28,0.04);">
          </div>
          <select id="catGroupFilter" class="form-select" style="flex:3 1 0; min-width:0; height:42px; border-radius:10px; border:1px solid #E8E0D6; background-color:#FFFFFF; font-size:0.92rem;">
            <option value="">Tất cả</option>
            @foreach (var group in Model.Groups)
            {
              <option value="@group.Slug" selected="@(current?.Slug == group.Slug)">@group.Name — @group.ItemCount loại</option>
            }
          </select>
          <button id="catFilterBtn" class="btn btn-primary" type="button" style="height:42px; padding:0 1.35rem; border-radius:10px; font-weight:600; letter-spacing:0.02em; white-space:nowrap; box-shadow:0 4px 12px rgba(228,87,15,0.25);"><i class="bi bi-funnel-fill" aria-hidden="true"></i> Lọc</button>
        </div>
        <div class="scrap-card-grid scrap-card-grid--3" style="margin-top:2rem">
          @foreach (var group in Model.Groups)
          {
            <a class="scrap-card" href="/phe-lieu/nhom/@group.Slug" aria-label="@group.Name — @group.ItemCount loại phế liệu">
              <span class="scrap-card-media">
                <img src="@AssetHelper.NormalizePath(group.ImageUrl)" alt="@group.Name" width="400" height="300" loading="lazy">
                <partial name="~/Views/Shared/Partials/Public/_MediaHotlineOverlay.cshtml" model="chrome.Hotline" />
              </span>
              <span class="scrap-card-body">
                <span class="scrap-card-cat"><i class="bi bi-tag-fill" aria-hidden="true"></i> @group.ItemCount loại</span>
                <h3>@group.Name</h3>
                @if (!string.IsNullOrWhiteSpace(group.SampleText))
                {
                  <p class="scrap-card-desc">@group.SampleText</p>
                }
                <span class="scrap-card-foot">
                  <span class="scrap-card-price">@(group.MinPriceFrom.HasValue ? $"từ {group.MinPriceFrom.Value:N0}đ/kg" : "Liên hệ báo giá")</span>
                  <span class="scrap-card-cta">Xem nhóm <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                </span>
              </span>
            </a>
          }
        </div>
      }
      else
      {
        <div class="sec-head reveal">
          @* <span class="sec-label">Bảng giá @(current.Name.ToLower())</span> *@
          <h2 class="sec-title">Giá thu mua @(current.Name.ToLower()) hôm nay</h2>
          @if (!string.IsNullOrWhiteSpace(Model.CurrentDescription))
          {
            <p class="sec-desc">@Model.CurrentDescription</p>
          }
        </div>
        <!-- Thanh lọc một hàng trên như các trang còn lại -->
        <div class="cat-filter-bar reveal" style="display:flex; gap:0.6rem; flex-wrap:wrap; align-items:center; background:linear-gradient(180deg,#FFFFFF 0%,#FFFBF5 100%); border:1px solid #F0E6D8; border-radius:12px; padding:0.75rem 0.9rem; box-shadow:0 8px 20px rgba(228,87,15,0.06); margin-bottom:1.25rem;">
          <div style="position:relative; flex:1 1 260px; min-width:180px;">
            <i class="bi bi-search" aria-hidden="true" style="position:absolute; left:0.85rem; top:50%; transform:translateY(-50%); color:#9AA3AE;"></i>
            <input id="priceSearch" type="search" class="form-control" placeholder="Tìm trong bảng giá @(current.Name.ToLower())..." style="padding-left:2.4rem; height:40px; border-radius:10px; border:1px solid #E8E0D6;">
          </div>
          <button id="priceFilterBtn" class="btn btn-primary" type="button" style="height:40px; padding:0 1.2rem; border-radius:10px; white-space:nowrap;"><i class="bi bi-funnel-fill" aria-hidden="true"></i> Lọc</button>
        </div>

        <div class="price-board">
          <div class="price-board-head reveal d-none d-md-flex">
            <span class="price-updated">
              <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
              Cập nhật <strong>@DateTime.Today.ToString("dd/MM/yyyy")</strong> — @Model.Items.Count loại, giá theo thực tế từng lô
            </span>
            @if (current.MinPriceFrom.HasValue)
            {
              <span class="price-updated">
                <i class="bi bi-tags-fill" aria-hidden="true"></i>
                Nhận từ <strong>@($"{current.MinPriceFrom.Value:N0}đ/kg")</strong>
              </span>
            }
          </div>

          <div class="table-scroll reveal">
            <table class="table table-price align-middle">
              <caption class="visually-hidden">Bảng giá thu mua phế liệu @(current.Name.ToLower()) theo từng loại, đơn vị tính theo kg</caption>
              <thead>
                <tr>
                  <th scope="col">Loại phế liệu</th>
                  <th scope="col">Mô tả phân loại</th>
                  <th scope="col" class="text-end">Giá thu mua</th>
                  <th scope="col" class="text-end">Chi tiết</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var item in Model.Items)
                {
                  <tr class="position-relative">
                    <td class="mat-name">
                      <a class="mat-name-link d-flex align-items-center gap-3 text-decoration-none text-reset stretched-link" asp-area="" asp-controller="Scrap" asp-action="Detail" asp-route-slug="@item.Slug">
                        <span class="mat-thumb">
                          <img src="@AssetHelper.NormalizePath(item.ImageUrl)" alt="@item.Name" width="96" height="72" loading="lazy">
                        </span>
                        <span class="mat-name-text">
                          <strong>@item.Name.Replace("Thu mua ", string.Empty)</strong>
                          <small>@item.CategoryName</small>
                        </span>
                      </a>
                    </td>
                    <td class="mat-type">@(string.IsNullOrWhiteSpace(item.ShortDescription) ? "Liên hệ mô tả hàng để báo giá chính xác." : item.ShortDescription)</td>
                    <td class="text-end"><span class="price-value position-relative" style="z-index: 2;">@item.PriceText</span></td>
                    <td class="text-end"><a class="link-arrow position-relative" style="z-index: 2;" asp-area="" asp-controller="Scrap" asp-action="Detail" asp-route-slug="@item.Slug">Xem chi tiết <i class="bi bi-arrow-right" aria-hidden="true"></i></a></td>
                  </tr>
                }
              </tbody>
            </table>
          </div>

          <div class="d-flex flex-wrap align-items-center gap-3 mt-4 reveal">
            <button class="btn btn-primary" type="button" data-quote-open>
              <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình chốt giá @(current.Name.ToLower())
            </button>
            <a class="btn btn-outline-dark" href="tel:0985565323">
              <i class="bi bi-telephone-fill" aria-hidden="true"></i>Gọi 0985565323
            </a>
          </div>
        </div>
      }
    </div>
  </section>
  <script>
    (function(){
      var search = document.getElementById('catSearch');
      var select = document.getElementById('catGroupFilter');
      var btn = document.getElementById('catFilterBtn');
      var priceSearch = document.getElementById('priceSearch');
      var priceBtn = document.getElementById('priceFilterBtn');
      function doFilter(){
        var q = (search && search.value || '').toLowerCase().trim();
        var g = select ? select.value : '';
        if (g && g !== '@(current?.Slug ?? "")') {
          location.href = g ? '/phe-lieu/nhom/' + g : '/phe-lieu/nhom';
          return;
        }
        document.querySelectorAll('.scrap-card-grid .scrap-card').forEach(function(card){
          var name = (card.textContent || '').toLowerCase();
          var ok = !q || name.indexOf(q) !== -1;
          card.style.display = ok ? '' : 'none';
        });
      }
      function doPriceFilter(){
        var q = (priceSearch && priceSearch.value || '').toLowerCase().trim();
        document.querySelectorAll('.price-board tbody tr').forEach(function(tr){
          if(tr.classList.contains('price-section-row')) return;
          var txt = (tr.textContent || '').toLowerCase();
          var ok = !q || txt.indexOf(q) !== -1;
          tr.style.display = ok ? '' : 'none';
        });
      }
      if(btn) btn.addEventListener('click', doFilter);
      if(search) search.addEventListener('keydown', function(e){ if(e.key==='Enter'){ e.preventDefault(); doFilter(); }});
      if(search) search.addEventListener('input', function(){ if(!search.value) doFilter(); });
      if(select) select.addEventListener('change', doFilter);
      if(priceBtn) priceBtn.addEventListener('click', doPriceFilter);
      if(priceSearch) priceSearch.addEventListener('keydown', function(e){ if(e.key==='Enter'){ e.preventDefault(); doPriceFilter(); }});
      if(priceSearch) priceSearch.addEventListener('input', function(){ doPriceFilter(); });
    })();
  </script>

  <section class="cta-final" aria-labelledby="cat-cta-title">
    <div class="cta-final-bg" aria-hidden="true">
      <img src="~/assets/images/hero/hero-02.svg" alt="" width="1280" height="800" loading="lazy">
    </div>
    <div class="container">
      <div class="cta-final-inner">
        <span class="tech-label">Bán phế liệu ngay hôm nay</span>
        <h2 id="cat-cta-title">Bạn đang có phế liệu cần thanh lý?</h2>
        <p>Gửi hình cho chúng tôi để nhận báo giá nhanh — hoặc gọi điện, chat Zalo nếu cần gấp.</p>
        <div class="cta-actions">
          <button class="btn btn-primary btn-lg" type="button" data-quote-open>
            <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình nhận giá
          </button>
          <a class="btn btn-outline-light btn-lg" href="tel:0985565323">
            <i class="bi bi-telephone-fill" aria-hidden="true"></i>0985565323
          </a>
        </div>
      </div>
    </div>
  </section>
</main>
