@model ScrapDetailViewModel?
@{
    ViewData["Title"] = Model?.Seo.Title ?? "Chi tiết phế liệu";
}

@if (Model is null)
{
  <main>
    <section class="section">
      <div class="container">
        <h1>Không tìm thấy phế liệu</h1>
        <a class="link-arrow" href="/phe-lieu">Quay lại danh sách <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
    </section>
  </main>
  return;
}

<main>
  <section class="scrap-hero" aria-label="@Model.Item.Name">
    <div class="container">
      <ol class="breadcrumb-line">
        <li><a href="/">Trang chủ</a></li>
        <li><a href="/phe-lieu">Phế liệu thu mua</a></li>
        <li aria-current="page">@Model.Item.Name</li>
      </ol>
      <div class="scrap-hero-grid">
        <div class="scrap-hero-media">
          <img src="@AssetHelper.NormalizePath(Model.Item.ImageUrl)" alt="@Model.Item.Name" width="1200" height="750" loading="lazy">
        </div>
        <div class="scrap-hero-info">
          <span class="tech-label">@Model.Item.CategoryName</span>
          <h1>@Model.Item.Name</h1>
          <p class="lead-2">@Model.Item.ShortDescription</p>
          <div class="price-highlight">
            <span class="ph-label">Giá thu mua tham khảo</span>
            <span class="ph-value"><strong>@Model.Item.PriceText</strong></span>
            <p class="ph-note">Giá thay đổi theo chất lượng hàng, số lượng và vị trí thu gom.</p>
          </div>
          <div class="scrap-hero-actions d-flex gap-2 gap-sm-3">
            <button class="btn btn-primary btn-lg flex-fill" type="button" data-quote-open><i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình báo giá</button>
            <a class="btn btn-outline-dark btn-lg flex-fill" href="/lien-he"><i class="bi bi-telephone-fill" aria-hidden="true"></i>Liên hệ</a>
          </div>
        </div>
      </div>
    </div>
  </section>



  @if (Model.Item.GalleryImages.Count > 0)
  {
    var shortName = Model.Item.Name.Replace("Thu mua ", string.Empty);
    <section class="section section--surface" aria-labelledby="gallery-title">
      <div class="container">
        <div class="sec-head reveal">
          <span class="sec-label">Hình ảnh thực tế</span>
          <h2 class="sec-title" id="gallery-title">Ảnh @shortName.ToLower() đã thu mua</h2>
          <p class="sec-desc">Hình ảnh từ các lô hàng thực tế — hàng của bạn sẽ được báo giá theo tình trạng cụ thể sau khi xem hình.</p>
        </div>
        <div class="detail-gallery reveal">
          @foreach (var image in Model.Item.GalleryImages)
          {
            <figure class="dg-item">
              <img src="@AssetHelper.NormalizePath(image.ImageUrl)" alt="@shortName" width="600" height="450" loading="lazy">
            </figure>
          }
        </div>
      </div>
    </section>
  }

  <section class="section section--paper" aria-labelledby="related-title">
    <div class="container">
      <div class="sec-head sec-head--row reveal">
        <div>
          <span class="sec-label">Loại phế liệu khác</span>
          <h2 class="sec-title" id="related-title">Cũng đang thu mua</h2>
        </div>
        <a class="link-arrow" href="/phe-lieu">Xem tất cả <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
      <div class="scrap-card-grid reveal">
        @foreach (var item in Model.RelatedItems)
        {
          <a class="scrap-card" asp-area="" asp-controller="Scrap" asp-action="Detail" asp-route-slug="@item.Slug">
            <span class="scrap-card-media">
              <img src="@AssetHelper.NormalizePath(item.ImageUrl)" alt="@item.Name" width="400" height="300" loading="lazy">
            </span>
            <span class="scrap-card-body">
              <span class="scrap-card-cat"><i class="bi bi-tag-fill" aria-hidden="true"></i> @item.CategoryName</span>
              <h3>@item.Name</h3>
              @if (!string.IsNullOrWhiteSpace(item.ShortDescription))
              {
                <p class="scrap-card-desc">@item.ShortDescription</p>
              }
              <span class="scrap-card-foot">
                <span class="scrap-card-price">@item.PriceText</span>
                <span class="scrap-card-cta">Xem chi tiết <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
              </span>
            </span>
          </a>
        }
      </div>
    </div>
  </section>
</main>

@section Schema {
<!script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Product",
  "name": "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Item.Name))",
  "image": [
    "@(Model.Item.ImageUrl != null ? (Model.Item.ImageUrl.StartsWith("http") ? Model.Item.ImageUrl : $"{Context.Request.Scheme}://{Context.Request.Host}{Model.Item.ImageUrl}") : "")"
  ],
  "description": "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Item.ShortDescription ?? Model.Item.Name))",
  "category": "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Item.CategoryName))",
  "offers": {
    "@@type": "Offer",
    "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/phe-lieu/{Model.Item.Slug}")",
    "priceCurrency": "VND",
    "price": "0",
    "priceSpecification": {
      "@@type": "UnitPriceSpecification",
      "priceCurrency": "VND",
      "unitText": "@(Model.Item.Unit ?? "kg")"
    },
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/UsedCondition"
  }
}
</!script>
}
