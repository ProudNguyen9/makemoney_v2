@model ScrapIndexViewModel
@{
    ViewData["Title"] = Model.Seo.Title;
    var pager = Model.Page;
}

<main>
  <section class="page-hero" aria-label="Danh mục phế liệu thu mua">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="~/assets/images/scrap/scrap-misc.svg" alt="" width="1600" height="900" loading="lazy">
    </div>
    <div class="container">
      <div class="page-hero-inner">
        <span class="tech-label">Phế liệu thu mua</span>
        <h1>Tất cả phế liệu chúng tôi thu mua</h1>
        <p class="page-hero-desc">Đồng, sắt thép, nhôm, inox, dây điện, giấy, nhựa, máy móc cũ — @pager.TotalItems loại đang mua với giá tham khảo theo kg. Gọi điện hoặc gửi hình, báo giá trong 30 phút.</p>
        <ol class="breadcrumb-line">
          <li><a href="/">Trang chủ</a></li>
          <li aria-current="page">Phế liệu thu mua</li>
        </ol>
      </div>
    </div>
  </section>
