  <section class="section section--paper" aria-labelledby="scrap-list-title">
    <div class="container">
      <div class="sec-head reveal">
        <div>
          @* <span class="sec-label">Danh mục thu mua</span> *@
          <h2 class="sec-title" id="scrap-list-title">Tất cả phế liệu chúng tôi thu mua</h2>
          <p class="sec-desc">
            Giá trong từng loại là mức "từ", tính theo kg với hàng tương đối sạch. Hàng dính tạp, ẩm hoặc
            trộn nhiều loại sẽ được định giá lại theo thực tế sau khi xem hình.
          </p>
        </div>
      </div>
      <!-- Filter sản phẩm - đồng bộ trang chủ, tham khảo Shopee/Alibaba mobile -->
      <div class="cat-filter-bar reveal" style="display:flex; gap:0.6rem; flex-wrap:wrap; align-items:center; background:linear-gradient(180deg,#FFFFFF 0%,#FFFBF5 100%); border:1px solid #F0E6D8; border-radius:12px; padding:0.75rem 0.9rem; box-shadow:0 8px 20px rgba(228,87,15,0.06); margin-bottom:1.25rem;">
        <div style="position:relative; flex:7 1 0; min-width:0;">
          <i class="bi bi-search" style="position:absolute; left:0.85rem; top:50%; transform:translateY(-50%); color:#9AA3AE;"></i>
          <input id="productSearch" type="search" class="form-control" placeholder="Tìm sản phẩm..." style="padding-left:2.4rem; height:40px; border-radius:10px; border:1px solid #E8E0D6; width:100%;">
        </div>
        <select id="productCategoryFilter" class="form-select" style="flex:3 1 0; min-width:0; height:40px; border-radius:10px; border:1px solid #E8E0D6;">
          <option value="">Tất cả</option>
          <option value="Đồng">Đồng</option>
          <option value="Sắt thép">Sắt thép</option>
          <option value="Nhôm">Nhôm</option>
          <option value="Inox">Inox</option>
          <option value="Giấy">Giấy</option>
          <option value="Nhựa">Nhựa</option>
          <option value="Máy móc">Máy móc</option>
        </select>
        <button id="productFilterBtn" class="btn btn-primary" type="button" style="height:40px; padding:0 1.2rem; border-radius:10px;"><i class="bi bi-funnel-fill"></i> Lọc</button>
      </div>

      @if (pager.Items.Count == 0)
      {
        <p class="text-center py-5">Hiện chưa có mặt hàng phế liệu nào được đăng tải. Vui lòng quay lại sau.</p>
      }
      else
      {
        <div class="scrap-card-grid reveal" id="productGrid">
          @foreach (var item in pager.Items)
          {
            var shortDesc = string.IsNullOrWhiteSpace(item.ShortDescription) ? "" : (item.ShortDescription.Length > 85 ? item.ShortDescription.Substring(0,85).Trim() + "…" : item.ShortDescription);
            <a class="scrap-card" asp-area="" asp-controller="Scrap" asp-action="Detail" asp-route-slug="@item.Slug" data-name="@item.Name.ToLower()" data-category="@item.CategoryName.ToLower()">
              <span class="scrap-card-media">
                <img src="@AssetHelper.NormalizePath(item.ImageUrl)" alt="@item.Name" width="400" height="300" loading="lazy">
              </span>
              <span class="scrap-card-body">
                <span class="scrap-card-cat"><i class="bi bi-tag-fill" aria-hidden="true"></i> @item.CategoryName</span>
                <h3 style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; min-height:2.6em;">@item.Name</h3>
                @if (!string.IsNullOrWhiteSpace(shortDesc))
                {
                  <p class="scrap-card-desc" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; min-height:2.8em;">@shortDesc</p>
                }
                <span class="scrap-card-foot">
                  <span class="scrap-card-price">@item.PriceText</span>
                  <span class="scrap-card-cta">Xem chi tiết <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                </span>
              </span>
            </a>
          }
        </div>
        <div class="text-center mt-4">
          <a class="btn btn-outline-dark" href="/bang-gia">Xem bảng giá <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </div>
      }

  <script>
  (function(){
    var search=document.getElementById('productSearch');
    var sel=document.getElementById('productCategoryFilter');
    var btn=document.getElementById('productFilterBtn');
    function filter(){
      var q=(search.value||'').toLowerCase().trim();
      var cat=(sel.value||'').toLowerCase().trim();
      document.querySelectorAll('#productGrid .scrap-card').forEach(function(c){
        var name=c.getAttribute('data-name')||'';
        var ccat=c.getAttribute('data-category')||'';
        var okName=!q||name.indexOf(q)!==-1;
        var okCat=!cat||ccat.indexOf(cat)!==-1;
        c.style.display=(okName&&okCat)?'':'none';
      });
    }
    if(btn) btn.addEventListener('click',filter);
    if(search) search.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();filter();}});
    if(search) search.addEventListener('input',function(){if(!search.value) filter();});
    if(sel) sel.addEventListener('change',filter);
  })();
  </script>
      @if (pager.TotalPages > 1)
      {
        <nav class="scrap-pagination" aria-label="Phân trang danh mục phế liệu">
          <ul class="pagination pagination-industrial">
            <li class="page-item @(pager.HasPrevious ? "" : "disabled")">
              @if (pager.HasPrevious)
              {
                <a class="page-link" asp-area="" asp-controller="Scrap" asp-action="Index" asp-route-page="@(pager.PageNumber - 1)" aria-label="Trang trước">« Trước</a>
              }
              else
              {
                <span class="page-link" aria-hidden="true">« Trước</span>
              }
            </li>
            @for (var p = 1; p <= pager.TotalPages; p++)
            {
              <li class="page-item @(p == pager.PageNumber ? "active" : "")">
                @if (p == pager.PageNumber)
                {
                  <span class="page-link" aria-current="page">@p</span>
                }
                else
                {
                  <a class="page-link" asp-area="" asp-controller="Scrap" asp-action="Index" asp-route-page="@p">@p</a>
                }
              </li>
            }
            <li class="page-item @(pager.HasNext ? "" : "disabled")">
              @if (pager.HasNext)
              {
                <a class="page-link" asp-area="" asp-controller="Scrap" asp-action="Index" asp-route-page="@(pager.PageNumber + 1)" aria-label="Trang sau">Sau »</a>
              }
              else
              {
                <span class="page-link" aria-hidden="true">Sau »</span>
              }
            </li>
          </ul>
        </nav>
      }
    </div>
  </section>
</main>
