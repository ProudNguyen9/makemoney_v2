@model ScrapIndexViewModel
@{
    ViewData["Title"] = Model.Seo.Title;
    var pager = Model.Page;
}

<main>
  <section class="page-hero" aria-label="Danh mục phế liệu thu mua">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="~/assets/images/scrap/scrap-misc.svg" alt="" width="1600" height="900" loading="lazy">
    </div>
    <div class="container">
      <div class="page-hero-inner">
        <span class="tech-label">Phế liệu thu mua</span>
        <h1>Tất cả phế liệu chúng tôi thu mua</h1>
        <p class="page-hero-desc">Đồng, sắt thép, nhôm, inox, dây điện, giấy, nhựa, máy móc cũ — @pager.TotalItems loại đang mua với giá tham khảo theo kg. Gọi điện hoặc gửi hình, báo giá trong 30 phút.</p>
        <ol class="breadcrumb-line">
          <li><a href="/">Trang chủ</a></li>
          <li aria-current="page">Phế liệu thu mua</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="scrap-intro" aria-label="Giới thiệu danh mục">
    <div class="container">
      <div class="scrap-intro-grid">
        <div class="scrap-intro-text">
          <p>
            Danh mục chia theo nhóm chất liệu với giá tham khảo theo kg — hàng dính tạp, ẩm hoặc trộn nhiều loại sẽ được định giá lại theo thực tế sau khi xem hình.
            Chụp vài tấm hình gửi Zalo hoặc gọi <a href="tel:0974640626">0974 640 626</a> để nhận báo giá cụ thể trong 30 phút, cân tận nơi — thanh toán ngay.
          </p>
        </div>
        <div class="scrap-intro-stats">
          <div class="sis-item">
            <span class="num-display">@pager.TotalItems</span>
            <span class="sis-label">Loại phế liệu</span>
          </div>
          <div class="sis-item">
            <span class="num-display">5</span>
            <span class="sis-label">Tỉnh thành phủ sóng</span>
          </div>
          <div class="sis-item">
            <span class="num-display">500+</span>
            <span class="sis-label">Lô hàng đã thu mua</span>
          </div>
          <div class="sis-item">
            <span class="num-display">15</span>
            <span class="sis-label">Phương tiện vận tải</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="scrap-list-title">
    <div class="container">
      <div class="sec-head sec-head--row reveal">
        <div>
          <span class="sec-label">Danh mục thu mua</span>
          <h2 class="sec-title" id="scrap-list-title">Tất cả phế liệu chúng tôi thu mua</h2>
          <p class="sec-desc">
            Giá trong từng loại là mức "từ", tính theo kg với hàng tương đối sạch. Hàng dính tạp, ẩm hoặc
            trộn nhiều loại sẽ được định giá lại theo thực tế sau khi xem hình.
          </p>
        </div>
        <a class="link-arrow" href="/bang-gia">Xem bảng giá <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>

      @if (pager.Items.Count == 0)
      {
        <p class="text-center py-5">Hiện chưa có mặt hàng phế liệu nào được đăng tải. Vui lòng quay lại sau.</p>
      }
      else
      {
        <div class="scrap-card-grid reveal">
          @foreach (var item in pager.Items)
          {
            <a class="scrap-card" asp-area="" asp-controller="Scrap" asp-action="Detail" asp-route-slug="@item.Slug">
              <span class="scrap-card-media">
                <img src="@AssetHelper.NormalizePath(item.ImageUrl)" alt="@item.Name" width="400" height="300" loading="lazy">
              </span>
              <span class="scrap-card-body">
                <span class="scrap-card-cat"><i class="bi bi-tag-fill" aria-hidden="true"></i> @item.CategoryName</span>
                <h3>@item.Name</h3>
                @if (!string.IsNullOrWhiteSpace(item.ShortDescription))
                {
                  <p class="scrap-card-desc">@item.ShortDescription</p>
                }
                <span class="scrap-card-foot">
                  <span class="scrap-card-price">@item.PriceText</span>
                  <span class="scrap-card-cta">Xem chi tiết <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                </span>
              </span>
            </a>
          }
        </div>
      }

      @if (pager.TotalPages > 1)
      {
        <nav class="scrap-pagination" aria-label="Phân trang danh mục phế liệu">
          <ul class="pagination pagination-industrial">
            <li class="page-item @(pager.HasPrevious ? "" : "disabled")">
              @if (pager.HasPrevious)
              {
                <a class="page-link" asp-area="" asp-controller="Scrap" asp-action="Index" asp-route-page="@(pager.PageNumber - 1)" aria-label="Trang trước">« Trước</a>
              }
              else
              {
                <span class="page-link" aria-hidden="true">« Trước</span>
              }
            </li>
            @for (var p = 1; p <= pager.TotalPages; p++)
            {
              <li class="page-item @(p == pager.PageNumber ? "active" : "")">
                @if (p == pager.PageNumber)
                {
                  <span class="page-link" aria-current="page">@p</span>
                }
                else
                {
                  <a class="page-link" asp-area="" asp-controller="Scrap" asp-action="Index" asp-route-page="@p">@p</a>
                }
              </li>
            }
            <li class="page-item @(pager.HasNext ? "" : "disabled")">
              @if (pager.HasNext)
              {
                <a class="page-link" asp-area="" asp-controller="Scrap" asp-action="Index" asp-route-page="@(pager.PageNumber + 1)" aria-label="Trang sau">Sau »</a>
              }
              else
              {
                <span class="page-link" aria-hidden="true">Sau »</span>
              }
            </li>
          </ul>
        </nav>
      }
    </div>
  </section>
</main>
