@{
    ViewData["Title"] = "Khu vực";
}

<main>

  <!-- ============================ PAGE HERO START ============================ -->
  <section class="page-hero" aria-labelledby="loc-hero-title">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="~/assets/images/locations/location-map.svg" alt="" width="1600" height="900" fetchpriority="high">
    </div>
    <div class="container">
      <div class="page-hero-inner">
        <span class="tech-label">Khu vực hoạt động</span>
        <h1 id="loc-hero-title">Thu mua phế liệu tận nơi tại [5] tỉnh thành</h1>
        <p class="page-hero-desc">
          Đội xe phủ sóng Đồng Nai, TP. Hồ Chí Minh, Bình Dương, Bà Rịa – Vũng Tàu và Long An.
          Chọn khu vực của bạn để xem chi tiết và bảng giá áp dụng.
        </p>
        <ol class="breadcrumb-line">
          <li><a href="/">Trang chủ</a></li>
          <li aria-current="page">Khu vực</li>
        </ol>
      </div>
    </div>
  </section>
  <!-- ============================ PAGE HERO END ============================ -->

  <!-- ============================ LOC MAP BAND START ============================ -->
  <section class="loc-map-band" aria-labelledby="locmap-title">
    <div class="loc-map-img" aria-hidden="true">
      <img src="~/assets/images/locations/location-map.svg" alt="" width="1600" height="900" loading="lazy">
    </div>
    <div class="container">
      <div class="loc-map-inner">
        <div class="reveal">
          <h2 id="locmap-title">Phủ sóng các khu công nghiệp trọng điểm</h2>
          <p>
            Từ Biên Hòa, Long Thành tới Dĩ An, Thuận An và cụm KCN Phú Mỹ — xe tải và nhân công
            của chúng tôi chạy hằng ngày giữa các nhà xưởng, công trình đang thanh lý.
            Báo giá sáng, xe tới chiều: đây là nhịp làm việc bình thường của đội thu gom.
          </p>
        </div>
        <div class="stats-band">
          <div class="stats-grid">
            <div class="stat-cell">
              <span class="num-display">[30+]</span>
              <span class="stat-label">KCN phục vụ</span>
              <span class="stat-desc">Biên Hòa, Amata, Long Đức, Nhơn Trạch…</span>
            </div>
            <div class="stat-cell">
              <span class="num-display">[15]</span>
              <span class="stat-label">Phương tiện</span>
              <span class="stat-desc">Xe tải nhiều tải trọng, có xe cẩu</span>
            </div>
            <div class="stat-cell">
              <span class="num-display">[24h]</span>
              <span class="stat-label">Tiếp nhận yêu cầu</span>
              <span class="stat-desc">Hotline &amp; Zalo, phản hồi nhanh trong [30 phút]</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ LOC MAP BAND END ============================ -->

  <!-- ============================ LOC DIRECTORY START ============================ -->
  <section class="section" aria-labelledby="locdir-title">
    <div class="container">
      <div class="sec-head reveal">
        <span class="sec-label">Danh sách khu vực</span>
        <h2 class="sec-title" id="locdir-title">Chọn tỉnh thành của bạn</h2>
        <p class="sec-desc">Bấm vào huyện thị để xem trang khu vực chi tiết: loại phế liệu nhận thu mua, bảng giá áp dụng và các khu công nghiệp được phục vụ tại chỗ.</p>
      </div>

      <div class="loc-directory reveal">
        <div class="loc-group">
          <h3 class="loc-province">Đồng Nai <span class="loc-province-note">phủ toàn tỉnh</span></h3>
          <div class="loc-districts">
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Biên Hòa</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Long Thành</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Nhơn Trạch</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Trảng Bom</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Vĩnh Cửu</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Long Khánh</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Xuân Lộc</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Định Quán</a>
          </div>
        </div>
        <div class="loc-group">
          <h3 class="loc-province">TP. Hồ Chí Minh</h3>
          <div class="loc-districts">
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Thủ Đức</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Quận 7</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Quận 12</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Bình Tân</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Bình Thạnh</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Gò Vấp</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Hóc Môn</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Củ Chi</a>
          </div>
        </div>
        <div class="loc-group">
          <h3 class="loc-province">Bình Dương</h3>
          <div class="loc-districts">
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Dĩ An</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Thuận An</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Bến Cát</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Tân Uyên</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Bàu Bàng</a>
          </div>
        </div>
        <div class="loc-group">
          <h3 class="loc-province">Bà Rịa – Vũng Tàu</h3>
          <div class="loc-districts">
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Vũng Tàu</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Bà Rịa</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Phú Mỹ</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Đất Đỏ</a>
          </div>
        </div>
        <div class="loc-group">
          <h3 class="loc-province">Long An</h3>
          <div class="loc-districts">
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Tân An</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Bến Lức</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Cần Giuộc</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ LOC DIRECTORY END ============================ -->

  <!-- ============================ OTHER AREAS START ============================ -->
  <section class="section section--surface section--bordered" aria-labelledby="other-areas-title">
    <div class="container">
      <h2 class="visually-hidden" id="other-areas-title">Khu vực khác</h2>
      <div class="empty-state reveal">
        <i class="bi bi-geo-alt" aria-hidden="true"></i>
        <h3>Chưa có khu vực của bạn?</h3>
        <p>
          Chúng tôi vẫn nhận lô hàng lớn tại các tỉnh lân cận — Tây Ninh, Bình Phước, Đồng Tháp, Tiền Giang…
          Gọi <a href="tel:[HOTLINE]"><strong>[HOTLINE]</strong></a> để kiểm tra lịch xe qua khu vực của bạn.
        </p>
        <a class="btn btn-outline-dark" href="tel:[HOTLINE]">
          <i class="bi bi-telephone-fill" aria-hidden="true"></i>Gọi [HOTLINE]
        </a>
      </div>
    </div>
  </section>
  <!-- ============================ OTHER AREAS END ============================ -->

  <!-- ============================ FINAL CTA START ============================ -->
  <section class="cta-final" aria-labelledby="cta-title">
    <div class="cta-final-bg" aria-hidden="true">
      <img src="~/assets/images/hero/hero-02.svg" alt="" width="1280" height="800" loading="lazy">
    </div>
    <div class="container">
      <div class="cta-final-inner">
        <span class="tech-label">Bán phế liệu ngay hôm nay</span>
        <h2 id="cta-title">Bạn đang có phế liệu cần thanh lý?</h2>
        <p>Gửi hình cho chúng tôi để nhận báo giá nhanh — hoặc gọi điện, chat Zalo nếu cần gấp.</p>
        <div class="cta-actions">
          <button class="btn btn-primary btn-lg" type="button" data-quote-open>
            <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình nhận giá
          </button>
          <a class="btn btn-outline-light btn-lg" href="tel:[HOTLINE]">
            <i class="bi bi-telephone-fill" aria-hidden="true"></i>[HOTLINE]
          </a>
          <a class="btn btn-outline-light btn-lg" href="https://zalo.me/[ZALO]" target="_blank" rel="noopener">
            <i class="bi bi-chat-dots-fill" aria-hidden="true"></i>Chat Zalo
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ FINAL CTA END ============================ -->

</main>
