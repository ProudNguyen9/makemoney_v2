@{
    ViewData["Title"] = "Liên hệ";
}

<main>

  @await Html.PartialAsync("~/Views/Shared/Partials/Public/_PageHero.cshtml", new codezone.ViewModels.Shared.PageHeroViewModel(
    "Liên hệ",
    "Liên hệ nhận báo giá thu mua",
    "Gọi hotline, nhắn Zalo hoặc gửi hình phế liệu — nhân viên tiếp nhận và báo giá nhanh trong [30 phút].",
    "~/assets/images/hero/hero-02.svg",
    "contact-hero-title",
    new List<(string Text, string? Url)> { ("Trang chủ", "/"), ("Liên hệ", null) }))

  <!-- ============================ CONTACT INFO + FORM START ============================ -->
  <section class="section section--surface" aria-labelledby="contact-info-title">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-5 reveal">
          <div class="sec-head">
            <span class="sec-label">Kênh liên hệ</span>
            <h2 class="sec-title" id="contact-info-title">Thông tin liên hệ</h2>
            <p class="sec-desc">Bộ phận báo giá làm việc cả tuần — gọi trực tiếp là nhanh nhất.</p>
          </div>

          <ul class="contact-info-list">
            <li>
              <span class="ci-icon"><i class="bi bi-telephone-fill" aria-hidden="true"></i></span>
              <span class="ci-body">
                <small>Hotline báo giá</small>
                <strong><a href="tel:[HOTLINE]">[HOTLINE]</a></strong>
              </span>
            </li>
            <li>
              <span class="ci-icon"><i class="bi bi-chat-dots-fill" aria-hidden="true"></i></span>
              <span class="ci-body">
                <small>Zalo</small>
                <strong>[ZALO]</strong>
                <span>Gửi hình phế liệu — phản hồi trong [30 phút]</span>
              </span>
            </li>
            <li>
              <span class="ci-icon"><i class="bi bi-envelope-fill" aria-hidden="true"></i></span>
              <span class="ci-body">
                <small>Email</small>
                <strong><a href="mailto:[EMAIL]">[EMAIL]</a></strong>
                <span>Gửi báo giá, hợp đồng, đề nghị thanh lý số lượng lớn</span>
              </span>
            </li>
            <li>
              <span class="ci-icon"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i></span>
              <span class="ci-body">
                <small>Địa chỉ kho</small>
                <strong>[ĐỊA CHỈ]</strong>
                <span>Có thể mang phế liệu đến cân trực tiếp</span>
              </span>
            </li>
            <li>
              <span class="ci-icon"><i class="bi bi-clock-fill" aria-hidden="true"></i></span>
              <span class="ci-body">
                <small>Giờ làm việc</small>
                <strong>T2–CN: [GIỜ LÀM VIỆC]</strong>
                <span>Tin nhắn gửi ngoài giờ — sáng hôm sau gọi lại ngay</span>
              </span>
            </li>
          </ul>

          <div class="map-placeholder mt-4">
            <img src="~/assets/images/locations/location-map.svg" alt="Sơ đồ khu vực kho thu mua phế liệu" width="1600" height="900" loading="lazy">
            <p class="map-note">
              <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Google Map embed — backend thay bằng iframe
            </p>
          </div>
        </div>

        <div class="col-lg-7 reveal">
          <div class="quote-panel">
            <h3 class="quote-panel-title">Gửi hình — nhận báo giá nhanh</h3>
            <p class="quote-panel-sub">Điền thông tin, chúng tôi gọi lại chốt giá trong [30 phút].</p>

            <!-- QUICK QUOTE FORM START -->
            @await Html.PartialAsync("~/Views/Shared/Partials/Public/_QuickQuoteForm.cshtml", new codezone.ViewModels.Shared.QuickQuoteFormViewModel(IdSuffix: "contact", ShowTitle: false))
            <!-- QUICK QUOTE FORM END -->
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ CONTACT INFO + FORM END ============================ -->

  <!-- ============================ QUICK GUIDE START ============================ -->
  <section class="section section--md" aria-labelledby="contact-steps-title">
    <div class="container">
      <div class="sec-head reveal">
        <span class="sec-label">Hướng dẫn nhanh</span>
        <h2 class="sec-title" id="contact-steps-title">Bán phế liệu qua 3 bước</h2>
      </div>

      <div class="trust-strip reveal">
        <div class="trust-strip-inner">
          <div class="trust-item">
            <i class="bi bi-telephone-fill" aria-hidden="true"></i>
            <div class="trust-text">
              <strong>Bấm Gọi/Zalo</strong>
              <small>Hotline [HOTLINE] — Zalo [ZALO]</small>
            </div>
          </div>
          <div class="trust-item">
            <i class="bi bi-camera-fill" aria-hidden="true"></i>
            <div class="trust-text">
              <strong>Gửi hình phế liệu</strong>
              <small>Chụp gần từng loại để báo giá đúng</small>
            </div>
          </div>
          <div class="trust-item">
            <i class="bi bi-cash-coin" aria-hidden="true"></i>
            <div class="trust-text">
              <strong>Nhận báo giá — chốt lịch thu gom</strong>
              <small>Phản hồi trong [30 phút], xe tới tận nơi</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ QUICK GUIDE END ============================ -->

  @await Html.PartialAsync("~/Views/Shared/Partials/Public/_FinalCta.cshtml", new codezone.ViewModels.Shared.FinalCtaViewModel(
    "Bán phế liệu ngay hôm nay",
    "Bạn đang có phế liệu cần thanh lý?",
    "Gửi hình cho chúng tôi để nhận báo giá nhanh — hoặc gọi điện, chat Zalo nếu cần gấp."))

</main>
