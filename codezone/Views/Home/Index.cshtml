@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
    var heroImages = Model.HeroImageUrls.Count > 0
        ? Model.HeroImageUrls
        : new List<string> { Model.HeroBanner.ImageUrl ?? "/assets/images/imported/brand/banner-1.jpg" };
    var heroImage = AssetHelper.NormalizePath(heroImages.ElementAtOrDefault(0) ?? "/assets/images/imported/brand/banner-1.jpg");
    var heroImage2 = AssetHelper.NormalizePath(heroImages.ElementAtOrDefault(1) ?? heroImage);
    var heroImage3 = AssetHelper.NormalizePath(heroImages.ElementAtOrDefault(2) ?? heroImage);
    var featuredScrap = Model.FeaturedScrapItems;
    var latestPosts = Model.LatestPosts;
    string ScrapImage(int index, string fallback)
    {
        var image = featuredScrap.ElementAtOrDefault(index)?.ImageUrl;
        return AssetHelper.NormalizePath(string.IsNullOrWhiteSpace(image) ? fallback : image);
    }
    string PostImage(int index, string fallback)
    {
        var image = latestPosts.ElementAtOrDefault(index)?.CoverImage;
        return AssetHelper.NormalizePath(string.IsNullOrWhiteSpace(image) ? fallback : image);
    }
    string PostUrl(int index, string fallback)
    {
        var slug = latestPosts.ElementAtOrDefault(index)?.Slug;
        return string.IsNullOrWhiteSpace(slug) ? fallback : $"/tin-tuc/{slug}";
    }
    string PostTitle(int index, string fallback)
    {
        return latestPosts.ElementAtOrDefault(index)?.Title ?? fallback;
    }
    string PostCategory(int index, string fallback)
    {
        return latestPosts.ElementAtOrDefault(index)?.CategoryName ?? fallback;
    }
    string PostDate(int index)
    {
        var post = latestPosts.ElementAtOrDefault(index);
        return post is null ? DateTime.Today.ToString("dd/MM/yyyy") : post.PublishedAt.ToString("dd/MM/yyyy");
    }
    string PostExcerpt(int index, string fallback)
    {
        return latestPosts.ElementAtOrDefault(index)?.Excerpt ?? fallback;
    }
    var priceRows = featuredScrap.Take(5).ToList();
}

<main>

  <!-- ============================ HERO START ============================ -->
  <section class="hero-home" aria-label="Giới thiệu nhanh">
    <div class="hero-grid">
      <div class="hero-copy">
          <p class="hero-kicker">Doanh nghiệp &amp; cá nhân — thanh lý toàn bộ</p>
          <h1 class="hero-title">
            Thu mua phế liệu<br>
            <span class="hero-title-accent">giá tốt — tận nơi</span>
          </h1>
          <p class="hero-sub">
            Chúng tôi mua phế liệu đồng, sắt, nhôm, inox, dây điện, máy móc cũ… của cá nhân,
            nhà xưởng và công trình. Khảo sát nhanh, cân minh bạch, thanh toán ngay tại kho khách hàng.
          </p>
          <div class="hero-actions">
            <button class="btn btn-primary btn-lg" type="button" data-quote-open>
              <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình báo giá
            </button>
            <a class="hero-hotline" href="@Model.Chrome.HotlineHref">
              <span class="hl-ring"><i class="bi bi-telephone-fill" aria-hidden="true"></i></span>
              <span>
                <small>Gọi ngay</small>
                <strong>@Model.Chrome.Hotline</strong>
              </span>
            </a>
          </div>
          <div class="hero-meta">
            <span class="hero-meta-item"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>@string.Join(" · ", Model.Chrome.PurchaseAreas)</span>
            <span class="hero-meta-item"><i class="bi bi-truck" aria-hidden="true"></i>Có xe &amp; nhân công đến tận nơi</span>
            <span class="hero-meta-item"><i class="bi bi-cash-coin" aria-hidden="true"></i>Thanh toán ngay sau cân</span>
          </div>
        </div>
        <div class="hero-media">
          <div id="heroMainCarousel" class="carousel slide hero-carousel" data-bs-ride="carousel" data-bs-interval="4200" data-bs-touch="true">
            <div class="carousel-indicators">
              <button type="button" data-bs-target="#heroMainCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Ảnh sân kho"></button>
              <button type="button" data-bs-target="#heroMainCarousel" data-bs-slide-to="1" aria-label="Ảnh thu gom tận nơi"></button>
              <button type="button" data-bs-target="#heroMainCarousel" data-bs-slide-to="2" aria-label="Ảnh xử lý nhà xưởng"></button>
            </div>
            <div class="carousel-inner">
              <div class="carousel-item active">
                <img src="@heroImage" alt="Sân kho phân loại phế liệu với xe tải và công nhân" width="1600" height="1000" fetchpriority="high">
              </div>
              <div class="carousel-item">
                <img src="@heroImage2" alt="Đội xe thu gom phế liệu tận nơi" width="1600" height="1000" loading="lazy">
              </div>
              <div class="carousel-item">
                <img src="@heroImage3" alt="Công nhân xử lý phế liệu tại nhà xưởng" width="1600" height="1000" loading="lazy">
              </div>
            </div>
          </div>
          <div class="hero-img-badge">
            <small>Bảng giá hôm nay</small>
            <strong>Đồng đỏ: 75–95k/kg</strong>
            <span>Giá tham khảo — gọi để chốt giá chính xác theo hình</span>
          </div>
        </div>
      </div>
  </section>
  <!-- ============================ HERO END ============================ -->

  <!-- ============================ TRUST STRIP START ============================ -->
  <section class="trust-strip" aria-label="Cam kết">
    <div class="container">
      <div class="trust-strip-inner">
        <div class="trust-item">
          <i class="bi bi-lightning-charge-fill" aria-hidden="true"></i>
          <div class="trust-text">
            <strong>Báo giá nhanh</strong>
            <small>Trong @Model.Chrome.ResponseTimeText qua Zalo/điện thoại</small>
          </div>
        </div>
        <div class="trust-item">
          <i class="bi bi-truck" aria-hidden="true"></i>
          <div class="trust-text">
            <strong>Thu gom tận nơi</strong>
            <small>Có xe tải &amp; nhân công</small>
          </div>
        </div>
        <div class="trust-item">
          <i class="bi bi-scale" aria-hidden="true"></i>
          <div class="trust-text">
            <strong>Cân minh bạch</strong>
            <small>Cân điện tử trước mặt khách</small>
          </div>
        </div>
        <div class="trust-item">
          <i class="bi bi-cash-coin" aria-hidden="true"></i>
          <div class="trust-text">
            <strong>Thanh toán ngay</strong>
            <small>Tiền mặt hoặc chuyển khoản</small>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ TRUST STRIP END ============================ -->

  <!-- ============================ CATEGORY MOSAIC START ============================ -->
  <section class="section section--surface" aria-labelledby="cat-title">
    <div class="container">
      <div class="sec-head sec-head--row reveal">
        <div>
          <span class="sec-label">Phế liệu thu mua</span>
          <h2 class="sec-title" id="cat-title">Các loại phế liệu chúng tôi thu mua</h2>
        </div>
      </div>

      <!-- CATEGORY CAROUSEL — 4 card/hàng, vuốt hoặc bấm mũi tên, dữ liệu nhóm lấy từ database -->
      <div class="swiper cat-swiper reveal">
        <div class="swiper-wrapper">
          @foreach (var group in Model.CategoryGroups)
          {
            <div class="swiper-slide">
              <a class="scrap-card" href="/phe-lieu/nhom/@group.Slug" aria-label="@group.Name — @group.ItemCount loại phế liệu">
                <span class="scrap-card-media">
                  <img src="@AssetHelper.NormalizePath(group.ImageUrl)" alt="@group.Name" width="400" height="300" loading="lazy">
                </span>
                <span class="scrap-card-body">
                  <span class="scrap-card-cat"><i class="bi bi-tag-fill" aria-hidden="true"></i> @group.ItemCount loại</span>
                  <h3>@group.Name</h3>
                  @if (!string.IsNullOrWhiteSpace(group.SampleText))
                  {
                    <p class="scrap-card-desc">@group.SampleText</p>
                  }
                  <span class="scrap-card-foot">
                    <span class="scrap-card-price">@(group.MinPriceFrom.HasValue ? $"từ {group.MinPriceFrom.Value:N0}đ/kg" : "Liên hệ báo giá")</span>
                    <span class="scrap-card-cta">Xem nhóm <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                  </span>
                </span>
              </a>
            </div>
          }
        </div>
        <div class="swiper-button-prev" aria-label="Xem các nhóm trước" role="button" tabindex="0"></div>
        <div class="swiper-button-next" aria-label="Xem các nhóm sau" role="button" tabindex="0"></div>
      </div>
      <!-- CATEGORY CAROUSEL END -->
    </div>
  </section>
  <!-- ============================ CATEGORY MOSAIC END ============================ -->

  <!-- ============================ PRICE BOARD START ============================ -->
  <section class="section section--paper" aria-labelledby="price-title">
    <div class="container">
      <div class="price-board">
        <div class="price-board-head reveal">
          <div class="sec-head mb-0">
            <span class="sec-label">Bảng giá tham khảo</span>
            <h2 class="sec-title" id="price-title">Bảng giá phế liệu hôm nay</h2>
          </div>
          <span class="price-updated">
            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
            Cập nhật <strong>@Model.Chrome.PriceUpdatedText</strong> — thay đổi theo thị trường
          </span>
        </div>

        <div class="table-scroll reveal">
          <table class="table table-price align-middle">
            <caption class="visually-hidden">Bảng giá thu mua một số loại phế liệu phổ biến, đơn vị tính theo kg</caption>
            <thead>
              <tr>
                <th scope="col">Loại</th>
                <th scope="col">Phân loại</th>
                <th scope="col" class="text-end">Giá thu mua (đ/kg)</th>
                <th scope="col" class="text-end">Xu hướng</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var item in priceRows)
              {
                <tr>
                  <td class="mat-name"><span class="mat-swatch" style="background:#B87333"></span>@item.CategoryName</td>
                  <td class="mat-type"><a href="/phe-lieu/@item.Slug">@item.Name</a></td>
                  <td class="text-end"><span class="price-value">@item.PriceText</span></td>
                  <td class="text-end"><span class="price-trend flat"><i class="bi bi-dash-lg" aria-hidden="true"></i>Liên hệ</span></td>
                </tr>
              }
            </tbody>
          </table>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3 mt-4 reveal">
          <button class="btn btn-primary" type="button" data-quote-open>
            <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình để nhận giá chính xác
          </button>
          <a class="link-arrow" href="/bang-gia">Xem bảng giá đầy đủ <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ PRICE BOARD END ============================ -->

  <!-- ============================ REFERRAL BAND START ============================ -->
  <section class="referral-band" aria-labelledby="referral-title">
    <div class="referral-img" aria-hidden="true">
      <img src="@AssetHelper.NormalizePath(Model.Chrome.ReferralImage)" alt="" width="1200" height="800" loading="lazy">
    </div>
    <div class="container">
      <div class="referral-inner">
        <div class="referral-copy reveal">
          <span class="tech-label">Chính sách hoa hồng</span>
          <h2 id="referral-title">Giới thiệu nguồn phế liệu — nhận hoa hồng cao</h2>
          <p>Biết nhà xưởng, công trình, kho bãi hoặc doanh nghiệp đang cần thanh lý phế liệu? Kết nối cho chúng tôi, bạn được ghi nhận rõ ràng và chi hoa hồng xứng đáng theo giá trị lô hàng.</p>
          <div class="referral-actions">
            <a class="btn btn-light btn-lg" href="/hoa-hong">
              <i class="bi bi-percent" aria-hidden="true"></i>Xem mức hoa hồng
            </a>
            <a class="btn btn-outline-light btn-lg" href="@Model.Chrome.HotlineHref">
              <i class="bi bi-telephone-fill" aria-hidden="true"></i>Gọi trao đổi ngay
            </a>
          </div>
        </div>
        <div class="referral-panel reveal" aria-label="Lợi ích khi giới thiệu nguồn phế liệu">
          <div class="referral-rate">
            <span>Hoa hồng</span>
            <strong>Cao theo lô</strong>
            <small>Áp dụng cho nguồn hàng nhà xưởng, công trình, kho bãi, thanh lý số lượng lớn</small>
          </div>
          <div class="referral-points">
            <span><i class="bi bi-patch-check-fill" aria-hidden="true"></i>Ghi nhận người giới thiệu minh bạch</span>
            <span><i class="bi bi-cash-stack" aria-hidden="true"></i>Chi hoa hồng nhanh sau khi hoàn tất thu mua</span>
            <span><i class="bi bi-shield-check" aria-hidden="true"></i>Bảo mật thông tin đối tác giới thiệu</span>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ REFERRAL BAND END ============================ -->

  <!-- ============================ STORY START ============================ -->
  <section class="section section--surface story-block" aria-labelledby="story-title">
    <div class="container">
      <div class="row row-editorial align-items-center">
        <div class="col-lg-5 story-copy reveal">
          <span class="sec-label">Về chúng tôi</span>
          <h2 id="story-title">Chúng tôi không chỉ thu mua phế liệu.<br>Chúng tôi xử lý cả những lô hàng khó.</h2>
          <p>
            Nhà xưởng cần dọn dây chuyền cũ, công trình cần tháo dỡ kết cấu thép,
            kho hàng tồn bo mạch lỗi dòng… — những lô hàng mà người thu mua nhỏ
            không đủ năng lực lấy, chúng tôi làm được.
          </p>
          <ul class="list-dash story-points">
            <li>Đội xe tải nhiều tải trọng, có cẩu đi cùng phục vụ tháo dỡ.</li>
            <li>Nhân sự kỹ thuật biết tháo máy móc, tủ điện an toàn.</li>
            <li>Quy trình rõ ràng: khảo sát — chốt giá — thu gom — thanh toán.</li>
          </ul>
          <div class="story-metrics" aria-label="Năng lực xử lý lô hàng">
            <span>
              <strong>24h</strong>
              <small>Khảo sát nhanh</small>
            </span>
            <span>
              <strong>3+</strong>
              <small>Khu vực chính</small>
            </span>
            <span>
              <strong>100%</strong>
              <small>Cân minh bạch</small>
            </span>
          </div>
          <a class="btn btn-dark" href="/gioi-thieu">Tìm hiểu về công ty</a>
        </div>
        <div class="col-lg-7 story-media reveal">
          <div class="story-img story-img-main">
            <img src="@AssetHelper.NormalizePath(Model.Chrome.AboutImageMain)" alt="Sân kho phân loại phế liệu của công ty" width="1200" height="800" loading="lazy">
            <span class="story-img-caption">
              <strong>Sân kho</strong>
              <small>Phân loại rõ từng nhóm vật liệu trước khi chốt giá</small>
            </span>
          </div>
          <div class="story-img story-img-2">
            <img src="@AssetHelper.NormalizePath(Model.Chrome.AboutImageTruck)" alt="Đội xe tải thu gom phế liệu" width="1200" height="800" loading="lazy">
            <span class="story-img-caption">
              <strong>Đội xe</strong>
              <small>Điều phối xe tải, nhân công và thiết bị tháo dỡ</small>
            </span>
          </div>
          <div class="story-img story-img-3">
            <img src="@AssetHelper.NormalizePath(Model.Chrome.AboutImageScale)" alt="Khu cân điện tử minh bạch" width="1200" height="800" loading="lazy">
            <span class="story-img-caption">
              <strong>Cân điện tử</strong>
              <small>Cân tại chỗ, đối chiếu rõ ràng trước thanh toán</small>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ STORY END ============================ -->

  <!-- ============================ STATS BAND START ============================ -->
  <section class="section section--md stats-band stats-band--orange" aria-label="Năng lực qua số liệu">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-cell">
          <span class="num-display" data-count="10" data-count-suffix="+">10+</span>
          <span class="stat-label">Năm kinh nghiệm</span>
          <span class="stat-desc">Hoạt động trong ngành thu mua phế liệu</span>
        </div>
        <div class="stat-cell">
          <span class="num-display" data-count="500" data-count-suffix="+">500+</span>
          <span class="stat-label">Dự án thu mua</span>
          <span class="stat-desc">Nhà xưởng, công trình, doanh nghiệp</span>
        </div>
        <div class="stat-cell">
          <span class="num-display" data-count="5" data-count-suffix="">5</span>
          <span class="stat-label">Tỉnh thành phủ sóng</span>
          <span class="stat-desc">Đồng Nai, TP.HCM, Bình Dương, BR-VT, Long An</span>
        </div>
        <div class="stat-cell">
          <span class="num-display" data-count="15" data-count-suffix="">15</span>
          <span class="stat-label">Phương tiện vận tải</span>
          <span class="stat-desc">Xe tải nhiều tải trọng, có xe cẩu</span>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ STATS BAND END ============================ -->

  <!-- ============================ WHY CHOOSE US START ============================ -->
  <section class="section section--surface" aria-labelledby="why-title">
    <div class="container">
      <div class="row row-editorial">
        <div class="col-lg-4 reveal">
          <div class="sec-head">
            <span class="sec-label">Lý do chọn chúng tôi</span>
            <h2 class="sec-title" id="why-title">Bán phế liệu cho chúng tôi, bạn được gì?</h2>
            <p class="sec-desc">Bốn cam kết trong mỗi giao dịch — từ lô dây điện vài chục ký đến hợp đồng thanh lý nhà xưởng.</p>
          </div>
          <a class="btn btn-outline-dark" href="@Model.Chrome.HotlineHref"><i class="bi bi-telephone-fill" aria-hidden="true"></i>Gọi hỏi giá ngay</a>
        </div>
        <div class="col-lg-8">
          <div class="why-list reveal">
            <div class="why-item">
              <span class="why-no" aria-hidden="true">01</span>
              <div class="why-body">
                <h3>Giá thu mua cạnh tranh</h3>
                <p>Theo dõi giá thị trường hàng ngày, báo giá sát giá thực nhận — không ép giá khi đến nơi.</p>
              </div>
            </div>
            <div class="why-item">
              <span class="why-no" aria-hidden="true">02</span>
              <div class="why-body">
                <h3>Cân đo minh bạch</h3>
                <p>Cân điện tử chuẩn đo lượng trước mặt khách, có phiếu cân — số liệu rõ ràng từng lô.</p>
              </div>
            </div>
            <div class="why-item">
              <span class="why-no" aria-hidden="true">03</span>
              <div class="why-body">
                <h3>Thu gom tận nơi</h3>
                <p>Xe tải và nhân công đến kho, nhà xưởng, công trình của bạn — kể cả tầng lầu có thang máy.</p>
              </div>
            </div>
            <div class="why-item">
              <span class="why-no" aria-hidden="true">04</span>
              <div class="why-body">
                <h3>Thanh toán nhanh</h3>
                <p>Tiền mặt ngay sau khi cân xong, hoặc chuyển khoản trong ngày — có hóa đơn VAT nếu cần.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ WHY CHOOSE US END ============================ -->

  <!-- ============================ PROJECT SHOWCASE START ============================ -->
  <section class="section section--paper section--bordered" aria-labelledby="showcase-title">
    <div class="container">
      <div class="sec-head sec-head--row reveal">
        <div>
          <span class="sec-label">Dự án tiêu biểu</span>
          <h2 class="sec-title" id="showcase-title">Dự án thu mua gần đây</h2>
        </div>
        <a class="link-arrow" href="/du-an">Xem tất cả dự án <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>

      <div class="showcase-grid reveal">
        <a class="show-item show-main" href="/du-an/thanh-ly-nha-xuong-bien-hoa">
          <img src="@AssetHelper.NormalizePath(Model.Chrome.ProjectImage1)" alt="Tháo dỡ và thu mua nhà xưởng 2.000m² tại Biên Hòa" width="1280" height="800" loading="lazy">
          <span class="show-overlay"></span>
          <span class="show-info">
            <span class="show-cat">Nhà xưởng</span>
            <h3>Tháo dỡ — thanh lý nhà xưởng 2.000m²</h3>
            <span class="show-loc"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Biên Hòa, Đồng Nai</span>
            <span class="show-view">Xem dự án <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
          </span>
        </a>
        <div class="show-col">
          <a class="show-item" href="/du-an/thanh-ly-nha-xuong-bien-hoa">
            <img src="@AssetHelper.NormalizePath(Model.Chrome.ProjectImage2)" alt="Thu gom sắt thép công trình tại Quận 9" width="1280" height="800" loading="lazy">
            <span class="show-overlay"></span>
            <span class="show-info">
              <span class="show-cat">Công trình</span>
              <h3>Thu gom 40 tấn sắt công trình</h3>
              <span class="show-loc"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Thủ Đức, TP.HCM</span>
              <span class="show-view">Xem dự án <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
            </span>
          </a>
          <a class="show-item" href="/du-an/thanh-ly-nha-xuong-bien-hoa">
            <img src="@AssetHelper.NormalizePath(Model.Chrome.ProjectImage3)" alt="Mua lại dây chuyền máy móc sản xuất tại Dĩ An" width="1280" height="800" loading="lazy">
            <span class="show-overlay"></span>
            <span class="show-info">
              <span class="show-cat">Máy móc</span>
              <h3>Mua dây chuyền sản xuất đã qua sử dụng</h3>
              <span class="show-loc"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Dĩ An, Bình Dương</span>
              <span class="show-view">Xem dự án <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ PROJECT SHOWCASE END ============================ -->

  <!-- ============================ PROCESS START ============================ -->
  <section class="section section--surface" aria-labelledby="process-title">
    <div class="container">
      <div class="sec-head reveal">
        <span class="sec-label">Quy trình</span>
        <h2 class="sec-title" id="process-title">Thu mua phế liệu 6 bước — rõ ràng từng công đoạn</h2>
      </div>
      <ol class="process-steps list-unstyled reveal">
        <li class="step-item">
          <span class="step-no" aria-hidden="true">01</span>
          <h3>Tiếp nhận</h3>
          <p>Gọi điện, Zalo hoặc gửi hình qua form báo giá.</p>
        </li>
        <li class="step-item">
          <span class="step-no" aria-hidden="true">02</span>
          <h3>Báo giá</h3>
          <p>Báo giá tham khảo nhanh qua hình ảnh, điện thoại.</p>
        </li>
        <li class="step-item">
          <span class="step-no" aria-hidden="true">03</span>
          <h3>Khảo sát</h3>
          <p>Đến tận nơi xem hàng, đo lượng với lô lớn.</p>
        </li>
        <li class="step-item">
          <span class="step-no" aria-hidden="true">04</span>
          <h3>Chốt giá</h3>
          <p>Thống nhất giá cuối cùng theo thực tế từng loại.</p>
        </li>
        <li class="step-item">
          <span class="step-no" aria-hidden="true">05</span>
          <h3>Thu gom</h3>
          <p>Xe và nhân công phân loại, vận chuyển khỏi mặt bằng.</p>
        </li>
        <li class="step-item">
          <span class="step-no" aria-hidden="true">06</span>
          <h3>Thanh toán</h3>
          <p>Cân minh bạch, trả tiền ngay tại chỗ.</p>
        </li>
      </ol>
    </div>
  </section>
  <!-- ============================ PROCESS END ============================ -->

  <!-- ============================ LOCATION DIRECTORY START ============================ -->
  <section class="section section--paper section--bordered" aria-labelledby="loc-title">
    <div class="container">
      <div class="sec-head sec-head--row reveal">
        <div>
          <span class="sec-label">Khu vực hoạt động</span>
          <h2 class="sec-title" id="loc-title">Chúng tôi thu mua tại các khu vực sau</h2>
        </div>
        <a class="link-arrow" href="/khu-vuc">Xem tất cả khu vực <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>

      <div class="loc-directory reveal">
        <div class="loc-group">
          <h3 class="loc-province">Đồng Nai <span class="loc-province-note">phủ toàn tỉnh</span></h3>
          <div class="loc-districts">
            @foreach (var area in Model.Chrome.PurchaseAreas.Take(6))
            {
              <a href="/khu-vuc"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>@area</a>
            }
          </div>
        </div>
        <div class="loc-group">
          <h3 class="loc-province">TP. Hồ Chí Minh</h3>
          <div class="loc-districts">
            <a href="/khu-vuc"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Thủ Đức</a>
            <a href="/khu-vuc"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Quận 7</a>
            <a href="/khu-vuc"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Quận 12</a>
            <a href="/khu-vuc"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Bình Tân</a>
            <a href="/khu-vuc"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Hóc Môn</a>
            <a href="/khu-vuc"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Củ Chi</a>
          </div>
        </div>
        <div class="loc-group">
          <h3 class="loc-province">Bình Dương</h3>
          <div class="loc-districts">
            <a href="/khu-vuc"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Dĩ An</a>
            <a href="/khu-vuc"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Thuận An</a>
            <a href="/khu-vuc"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Bến Cát</a>
            <a href="/khu-vuc"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Tân Uyên</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ LOCATION DIRECTORY END ============================ -->

  <!-- ============================ NEWS START ============================ -->
  <section class="section section--paper" aria-labelledby="news-title">
    <div class="container">
      <div class="sec-head sec-head--row reveal">
        <div>
          <span class="sec-label">Tin tức — kiến thức</span>
          <h2 class="sec-title" id="news-title">Cập nhật giá &amp; kinh nghiệm bán phế liệu</h2>
        </div>
        <a class="link-arrow" href="/tin-tuc">Xem tất cả bài viết <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>

      <div class="news-editorial reveal">
        <a class="news-feature news-feature--image-only" href="@PostUrl(0, "/tin-tuc")" aria-label="@PostTitle(0, "Bảng giá phế liệu hôm nay")">
          <span class="news-feature-media">
            <img src="@PostImage(0, "/assets/images/imported/brand/seo-og-image.png")" alt="@PostTitle(0, "Bảng giá phế liệu hôm nay")" width="1200" height="675" loading="lazy">
          </span>
        </a>
        <div class="news-side">
          @foreach (var post in latestPosts.Skip(1).Take(5))
          {
            <a class="news-row" href="/tin-tuc/@post.Slug">
              <span class="news-row-media">
                <img src="@AssetHelper.NormalizePath(post.CoverImage ?? "/assets/images/imported/brand/seo-og-image.png")" alt="@post.Title" width="1200" height="675" loading="lazy">
              </span>
              <span>
                <h3>@post.Title</h3>
                <span class="news-meta">@post.CategoryName · @post.PublishedAt.ToString("dd/MM/yyyy")</span>
              </span>
            </a>
          }
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ NEWS END ============================ -->

  <!-- ============================ FAQ START ============================ -->
  <section class="section section--surface" aria-labelledby="faq-title">
    <div class="container">
      <div class="row row-editorial">
        <div class="col-lg-4 reveal">
          <div class="sec-head">
            <span class="sec-label">Câu hỏi thường gặp</span>
            <h2 class="sec-title" id="faq-title">Khách hàng hay hỏi chúng tôi</h2>
            <p class="sec-desc">Không tìm thấy câu trả lời? Gọi <a href="@Model.Chrome.HotlineHref">@Model.Chrome.Hotline</a> hoặc chat Zalo để được tư vấn nhanh.</p>
          </div>
        </div>
        <div class="col-lg-8">
          @await Html.PartialAsync("~/Views/Shared/Partials/Public/_FaqAccordion.cshtml", Model.Faq)
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ FAQ END ============================ -->

  <!-- ============================ FINAL CTA START ============================ -->
  <section class="cta-final" aria-labelledby="cta-title">
    <div class="cta-final-bg" aria-hidden="true">
      <img src="@AssetHelper.NormalizePath(Model.Chrome.FinalCtaImage)" alt="" width="1280" height="800" loading="lazy">
    </div>
    <div class="container">
      <div class="cta-final-inner">
        <span class="tech-label">Bán phế liệu ngay hôm nay</span>
        <h2 id="cta-title">Bạn đang có phế liệu cần thanh lý?</h2>
        <p>Gửi hình cho chúng tôi để nhận báo giá nhanh — hoặc gọi điện, chat Zalo nếu cần gấp.</p>
        <div class="cta-actions">
          <button class="btn btn-primary btn-lg" type="button" data-quote-open>
            <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình nhận giá
          </button>
          <a class="btn btn-outline-light btn-lg" href="@Model.Chrome.HotlineHref">
            <i class="bi bi-telephone-fill" aria-hidden="true"></i>@Model.Chrome.Hotline
          </a>
          <a class="btn btn-outline-light btn-lg" href="@Model.Chrome.ZaloHref" target="_blank" rel="noopener">
            <i class="bi bi-chat-dots-fill" aria-hidden="true"></i>Chat Zalo
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ FINAL CTA END ============================ -->

</main>
