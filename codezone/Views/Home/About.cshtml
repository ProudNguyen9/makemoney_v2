@{
    ViewData["Title"] = "Giới thiệu";
}

<main>

  <!-- ============================ PAGE HERO START ============================ -->
  <section class="page-hero" aria-labelledby="about-hero-title">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="~/assets/images/company/company-yard.svg" alt="" width="1600" height="900" fetchpriority="high">
    </div>
    <div class="container">
      <div class="page-hero-inner">
        <span class="tech-label">Giới thiệu</span>
        <h1 id="about-hero-title">Người thu mua phế liệu được doanh nghiệp tin cậy</h1>
        <p class="page-hero-desc">
          Hơn 10 năm gắn với nghề thu mua phế liệu, chúng tôi đi từ một xe tải nhỏ lên đội xe 15 phương tiện,
          phục vụ 5 tỉnh thành Đồng Nai — TP.HCM — Bình Dương và lân cận.
          Trang này kể lại hành trình đó, cùng những nguyên tắc chưa từng đổi: cân minh bạch, thu gom đúng hẹn, thanh toán đúng lời.
        </p>
        <ol class="breadcrumb-line">
          <li><a href="/">Trang chủ</a></li>
          <li aria-current="page">Giới thiệu</li>
        </ol>
      </div>
    </div>
  </section>
  <!-- ============================ PAGE HERO END ============================ -->

  <!-- ============================ COMPANY STORY START ============================ -->
  <section class="section section--surface" aria-labelledby="story-title">
    <div class="container">
      <div class="story-block row row-editorial align-items-center">
        <div class="col-lg-5 story-copy reveal">
          <span class="sec-label">Câu chuyện</span>
          <h2 id="story-title">Từ một xe tải nhỏ đến đội xe 15 phương tiện</h2>
          <p>
            Năm 2014, chúng tôi khởi đầu bằng một xe tải nhỏ, chạy khắp các con hẻm quanh Biên Hòa
            để thu mua đồng, sắt vụn và dây điện cũ. Hôm may mắn, xe chở đầy về kho trước giờ tối;
            hôm ít hàng, chủ xe vẫn tình nguyện chạy thêm một vòng nữa mới chịu quay về.
          </p>
          <p>
            Khách hàng thời đó phần lớn là các hộ làm cơ khí. Họ giữ số điện thoại của chúng tôi
            vì một lý do rất đơn giản: cái cân không bao giờ lệch. Nhà xưởng này giới thiệu sang nhà xưởng kia,
            sổ ghi chép dần dày lên — không một đơn hàng nào đến từ quảng cáo, chỉ toàn lời giới thiệu của người đã bán hàng cho chúng tôi.
          </p>
          <p>
            Năm 2026, 5 tỉnh thành đều có xe của chúng tôi chạy qua mỗi tuần. Máy móc, kho bãi,
            nhân sự đều đã khác ngày đầu, nhưng nguyên tắc giữ nguyên vẹn: <strong>cân đâu giá đó</strong> —
            cân trước mặt khách, trả tiền ngay sau khi cân.
          </p>
        </div>
        <div class="col-lg-7 story-media reveal">
          <div class="story-img story-img-main">
            <img src="~/assets/images/company/company-truck.svg" alt="Xe tải thu mua phế liệu của công ty" width="1200" height="800" loading="lazy">
          </div>
          <div class="story-img story-img-2">
            <img src="~/assets/images/company/company-team.svg" alt="Đội ngũ nhân sự phân loại phế liệu tại kho" width="1200" height="800" loading="lazy">
          </div>
          <div class="story-img story-img-3">
            <img src="~/assets/images/company/company-warehouse.svg" alt="Kho tập kết phế liệu trước khi xuất hàng" width="1200" height="800" loading="lazy">
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ COMPANY STORY END ============================ -->

  <!-- ============================ MISSION VISION VALUES START ============================ -->
  <section class="section section--paper" aria-labelledby="mvv-title">
    <div class="container">
      <div class="row row-editorial">
        <div class="col-lg-4 reveal">
          <div class="sec-head">
            <span class="sec-label">Định hướng</span>
            <h2 class="sec-title" id="mvv-title">Ba điều giữ nguyên suốt hơn 10 năm</h2>
            <p class="sec-desc">Không phải khẩu hiệu treo tường — mỗi điều đều được đối chiếu lại trong từng hợp đồng, với từng khách hàng.</p>
          </div>
          <a class="btn btn-outline-dark" href="/nang-luc">Xem năng lực vận hành</a>
        </div>
        <div class="col-lg-8">
          <div class="mvv-block reveal">
            <div class="mvv-item">
              <span class="mvv-icon"><i class="bi bi-bullseye" aria-hidden="true"></i></span>
              <div>
                <h3>Sứ mệnh</h3>
                <p>Giúp doanh nghiệp thanh lý phế liệu nhanh — gọn — đúng giá.</p>
              </div>
            </div>
            <div class="mvv-item">
              <span class="mvv-icon"><i class="bi bi-eye-fill" aria-hidden="true"></i></span>
              <div>
                <h3>Tầm nhìn</h3>
                <p>Trở thành đối tác thu mua phế liệu tin cậy nhất miền Đông Nam Bộ.</p>
              </div>
            </div>
            <div class="mvv-item">
              <span class="mvv-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
              <div>
                <h3>Giá trị cốt lõi</h3>
                <p>Minh bạch trong cân đo — đúng hẹn trong thu gom — đúng lời trong thanh toán.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ MISSION VISION VALUES END ============================ -->

  <!-- ============================ TIMELINE START ============================ -->
  <section class="section section--surface" aria-labelledby="timeline-title">
    <div class="container">
      <div class="sec-head reveal">
        <span class="sec-label">Hành trình</span>
        <h2 class="sec-title" id="timeline-title">Chặng đường hơn 10 năm — khởi phát từ Biên Hòa</h2>
      </div>
      <div class="row row-editorial">
        <div class="col-lg-7">
          <div class="timeline reveal">
            <div class="tl-item">
              <span class="tl-year">2014</span>
              <h3>Thành lập tại Biên Hòa</h3>
              <p>Khởi đầu bằng một xe tải nhỏ, đi thu mua đồng và sắt vụn quanh các xưởng cơ khí trong tỉnh.</p>
            </div>
            <div class="tl-item">
              <span class="tl-year">2016</span>
              <h3>Mở kho đầu tiên</h3>
              <p>Có mặt bằng tập kết và cân điện tử riêng — khách gần kho mang hàng đến cân bán trực tiếp.</p>
            </div>
            <div class="tl-item">
              <span class="tl-year">2019</span>
              <h3>Mở rộng đội xe và nhóm tháo dỡ</h3>
              <p>Bổ sung xe tải nhiều tải trọng, nhận thêm mảng tháo dỡ nhà xưởng, máy móc và tủ điện công nghiệp.</p>
            </div>
            <div class="tl-item">
              <span class="tl-year">2022</span>
              <h3>Phủ sóng TP.HCM, Bình Dương</h3>
              <p>Ký các hợp đồng thu mua định kỳ với nhà xưởng tại Thủ Đức, Dĩ An, Thuận An.</p>
            </div>
            <div class="tl-item">
              <span class="tl-year">2026</span>
              <h3>Vận hành ổn định tại 5 tỉnh thành</h3>
              <p>15 phương tiện, 20 nhân sự, phục vụ Đồng Nai, TP.HCM, Bình Dương, Bà Rịa - Vũng Tàu và Long An — vẫn cân trước mặt khách như ngày đầu tiên.</p>
            </div>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="loc-gallery timeline-gallery reveal">
            <div class="loc-gitem loc-gitem-wide">
              <img src="~/assets/images/company/company-warehouse.svg" alt="Kho phế liệu tập kết, phân loại và ép kiện trước khi xuất đi" width="1200" height="800" loading="lazy">
            </div>
          </div>
          <p class="small text-body-secondary mt-2 mb-0 reveal">Kho tập kết tại Biên Hòa — hàng được phân loại, ép kiện rồi mới xuất đi cho xưởng tái chế.</p>
          <div class="timeline-media-note reveal">
            <h3>Quy trình giữ hàng rõ ràng</h3>
            <p>Mỗi lô hàng vào kho đều được cân, phân loại theo nhóm vật liệu và ghi nhận trước khi ép kiện hoặc chuyển về xưởng tái chế. Khách cần đối chiếu có thể nhận phiếu cân, hình ảnh hiện trường và lịch thanh toán trong ngày.</p>
            <ul>
              <li>Cân điện tử tại kho hoặc cân trực tiếp tại công trình.</li>
              <li>Tách riêng đồng, nhôm, sắt thép, inox, dây cáp và máy móc.</li>
              <li>Điều xe theo khối lượng thực tế để giảm thời gian chờ.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ TIMELINE END ============================ -->

  <!-- ============================ STATS BAND START ============================ -->
  <section class="section--dark section section--md stats-band" aria-label="Năng lực qua số liệu">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-cell">
          <span class="num-display" data-count="10" data-count-suffix="+">10+</span>
          <span class="stat-label">Năm kinh nghiệm</span>
          <span class="stat-desc">Hoạt động trong ngành thu mua phế liệu</span>
        </div>
        <div class="stat-cell">
          <span class="num-display" data-count="500" data-count-suffix="+">500+</span>
          <span class="stat-label">Dự án thu mua</span>
          <span class="stat-desc">Nhà xưởng, công trình, doanh nghiệp</span>
        </div>
        <div class="stat-cell">
          <span class="num-display" data-count="5" data-count-suffix="">5</span>
          <span class="stat-label">Tỉnh thành phủ sóng</span>
          <span class="stat-desc">Đồng Nai, TP.HCM, Bình Dương, BR-VT, Long An</span>
        </div>
        <div class="stat-cell">
          <span class="num-display" data-count="15" data-count-suffix="">15</span>
          <span class="stat-label">Phương tiện vận tải</span>
          <span class="stat-desc">Xe tải nhiều tải trọng, có xe cẩu</span>
        </div>
      </div>
     
    </div>
  </section>
  <!-- ============================ STATS BAND END ============================ -->

  <!-- ============================ OPERATION TEAMS START ============================ -->
  <section class="section section--paper section--bordered" aria-labelledby="teams-title">
    <div class="container">
      <div class="sec-head reveal">
        <span class="sec-label">Đội ngũ vận hành</span>
        <h2 class="sec-title" id="teams-title">Ai là người trực tiếp làm việc với khách hàng?</h2>
        <p class="sec-desc">Ba bộ phận ghép thành một chuyến hàng: người báo giá, người lái xe, người cầm đồ nghề.</p>
      </div>
      <div class="row row-editorial">
        <div class="col-lg-7">
          <div class="fleet-list reveal">
            <div class="fleet-row">
              <div class="fleet-media">
                <img src="~/assets/images/company/company-truck.svg" alt="Xe tải chở phế liệu tại công trình" width="1200" height="800" loading="lazy">
              </div>
              <div class="fleet-body">
                <div>
                  <h3>Đội xe tải</h3>
                  <p>Nhiều mức tải trọng 1–15 tấn — điều xe theo lượng hàng thực tế, không bắt khách chờ ghép chuyến.</p>
                </div>
                <span class="fleet-qty">15<small>phương tiện</small></span>
              </div>
            </div>
            <div class="fleet-row">
              <div class="fleet-media">
                <img src="~/assets/images/projects/project-01-cover.svg" alt="Đội tháo dỡ làm việc tại nhà xưởng" width="1200" height="800" loading="lazy">
              </div>
              <div class="fleet-body">
                <div>
                  <h3>Nhóm tháo dỡ</h3>
                  <p>Nhận giải phóng mặt bằng nhà xưởng: tháo mái tôn, khung thép, dây chuyền máy móc.</p>
                </div>
                <span class="fleet-qty">8<small>thợ kỹ thuật</small></span>
              </div>
            </div>
            <div class="fleet-row">
              <div class="fleet-media">
                <img src="~/assets/images/company/company-team.svg" alt="Nhân viên mua hàng kiểm tra hình ảnh khách gửi" width="1200" height="800" loading="lazy">
              </div>
              <div class="fleet-body">
                <div>
                  <h3>Nhân viên mua hàng</h3>
                  <p>Dựa vào hình ảnh khách gửi để báo giá nhanh, xếp lịch xe và điều phối người đến khảo sát.</p>
                </div>
                <span class="fleet-qty">12<small>nhân viên</small></span>
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-5">
          <span class="tech-label d-block mb-3 reveal">Bốn cam kết giữ nguyên từ ngày đầu</span>
          <div class="why-list reveal">
            <div class="why-item">
              <span class="why-no" aria-hidden="true">01</span>
              <div class="why-body">
                <h3>Giá thu mua cạnh tranh</h3>
                <p>Theo dõi giá thị trường hàng ngày, báo giá sát giá thực nhận — không ép giá khi đến nơi.</p>
              </div>
            </div>
            <div class="why-item">
              <span class="why-no" aria-hidden="true">02</span>
              <div class="why-body">
                <h3>Cân đo minh bạch</h3>
                <p>Cân điện tử chuẩn đo lượng trước mặt khách, có phiếu cân — số liệu rõ ràng từng lô.</p>
              </div>
            </div>
            <div class="why-item">
              <span class="why-no" aria-hidden="true">03</span>
              <div class="why-body">
                <h3>Thu gom tận nơi</h3>
                <p>Xe tải và nhân công đến kho, nhà xưởng, công trình của bạn — kể cả tầng lầu có thang máy.</p>
              </div>
            </div>
            <div class="why-item">
              <span class="why-no" aria-hidden="true">04</span>
              <div class="why-body">
                <h3>Thanh toán nhanh</h3>
                <p>Tiền mặt ngay sau khi cân xong, hoặc chuyển khoản trong ngày — có hóa đơn VAT nếu cần.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ OPERATION TEAMS END ============================ -->

  <!-- ============================ LOCATION DIRECTORY START ============================ -->
  <section class="section section--paper section--bordered" aria-labelledby="loc-title">
    <div class="container">
      <div class="sec-head sec-head--row reveal">
        <div>
          <span class="sec-label">Khu vực hoạt động</span>
          <h2 class="sec-title" id="loc-title">Chúng tôi đang phục vụ tại 5 tỉnh thành</h2>
        </div>
        <a class="link-arrow" href="/khu-vuc">Xem tất cả khu vực <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>

      <div class="loc-directory reveal">
        <div class="loc-group">
          <h3 class="loc-province">Đồng Nai <span class="loc-province-note">nơi khởi đầu</span></h3>
          <div class="loc-districts">
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Biên Hòa</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Long Thành</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Nhơn Trạch</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Trảng Bom</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Vĩnh Cửu</a>
          </div>
        </div>
        <div class="loc-group">
          <h3 class="loc-province">TP. Hồ Chí Minh</h3>
          <div class="loc-districts">
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Thủ Đức</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Quận 12</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Bình Tân</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Củ Chi</a>
          </div>
        </div>
        <div class="loc-group">
          <h3 class="loc-province">Bình Dương</h3>
          <div class="loc-districts">
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Dĩ An</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Thuận An</a>
            <a href="/khu-vuc/dong-nai"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Bến Cát</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ LOCATION DIRECTORY END ============================ -->

  <!-- ============================ FINAL CTA START ============================ -->
  <section class="cta-final" aria-labelledby="cta-title">
    <div class="cta-final-bg" aria-hidden="true">
      <img src="~/assets/images/hero/hero-02.svg" alt="" width="1280" height="800" loading="lazy">
    </div>
    <div class="container">
      <div class="cta-final-inner">
        <span class="tech-label">Bán phế liệu ngay hôm nay</span>
        <h2 id="cta-title">Bạn đang có phế liệu cần thanh lý?</h2>
        <p>Gửi hình cho chúng tôi để nhận báo giá nhanh — hoặc gọi điện, chat Zalo nếu cần gấp.</p>
        <div class="cta-actions">
          <button class="btn btn-primary btn-lg" type="button" data-quote-open>
            <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình nhận giá
          </button>
          <a class="btn btn-outline-light btn-lg" href="tel:[HOTLINE]">
            <i class="bi bi-telephone-fill" aria-hidden="true"></i>[HOTLINE]
          </a>
          <a class="btn btn-outline-light btn-lg" href="https://zalo.me/[ZALO]" target="_blank" rel="noopener">
            <i class="bi bi-chat-dots-fill" aria-hidden="true"></i>Chat Zalo
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ FINAL CTA END ============================ -->

</main>
