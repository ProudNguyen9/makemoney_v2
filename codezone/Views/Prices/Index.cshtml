@model ScrapWebsite.ViewModels.PriceBoardViewModel
@{
    ViewData["Title"] = "Bảng giá";
    var updatedText = Model.LastUpdatedAt?.ToString("dd/MM/yyyy") ?? DateTime.Today.ToString("dd/MM/yyyy");
    var allRows = Model.Groups
        .SelectMany(group => group.Rows.Select(row => new { Group = group, Row = row }))
        .ToList();
}

<main class="price-page">

  <!-- ============================ PAGE HERO START ============================ -->
  <section class="page-hero" aria-labelledby="prices-hero-title">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="~/assets/images/company/company-scale.svg" alt="" width="1600" height="900" fetchpriority="high">
    </div>
    <div class="container">
      <div class="page-hero-inner">
        <span class="tech-label">Bảng giá thu mua</span>
        <h1 id="prices-hero-title">Bảng giá phế liệu hôm nay</h1>
        <p class="page-hero-desc">
          Giá thu mua tham khảo cập nhật @updatedText cho phế liệu đồng, sắt, nhôm, inox và vật liệu khác.
          Gửi hình để nhận giá chính xác theo lô hàng của bạn.
        </p>
        <ol class="breadcrumb-line">
          <li><a href="/">Trang chủ</a></li>
          <li aria-current="page">Bảng giá</li>
        </ol>
      </div>
    </div>
  </section>
  <!-- ============================ PAGE HERO END ============================ -->

  <!-- ============================ PRICE NOTICE START ============================ -->
  <section class="section section--sm" aria-label="Lưu ý về bảng giá">
    <div class="container">
      <div class="price-notice">
        <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
        <p class="mb-0">
          Giá mang tính tham khảo, biến động theo thị trường. Giá chốt cuối cùng phụ thuộc độ sạch, số lượng
          và khu vực — gọi <a href="/lien-he"><strong>hotline</strong></a> hoặc gửi hình để nhận báo giá chính xác.
        </p>
      </div>
    </div>
  </section>
  <!-- ============================ PRICE NOTICE END ============================ -->

  <!-- ============================ PRICE TABLE START ============================ -->
  <section class="section section--md" aria-label="Bảng giá phế liệu tổng hợp">
    <div class="container">

      @if (allRows.Count > 0)
      {
        <div class="price-board price-board--all">
          <div class="price-board-head reveal">
            <div>
              <span class="sec-label">Bảng giá tổng hợp</span>
              <h2 class="sec-title mb-0">Tất cả giá thu mua phế liệu</h2>
            </div>
            <span class="price-updated">
              <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
              Cập nhật <strong>@updatedText</strong> — @allRows.Count dòng giá
            </span>
          </div>

          <div class="table-scroll reveal">
            <table class="table table-price align-middle">
              <caption class="visually-hidden">Bảng giá thu mua tất cả loại phế liệu</caption>
              <thead>
                <tr>
                  <th scope="col">Loại phế liệu</th>
                  <th scope="col">Phân loại</th>
                  <th scope="col" class="text-end">Giá thu mua</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var group in Model.Groups)
                {
                  <tr class="price-section-row">
                    <th scope="rowgroup" colspan="3">
                      <span>@group.Name</span>
                      <small>@group.Rows.Count dòng giá</small>
                    </th>
                  </tr>
                  @foreach (var row in group.Rows)
                  {
                    <tr>
                      <td class="mat-name">
                        <span class="mat-thumb">
                          <img src="@AssetHelper.NormalizePath(row.ImageUrl)" alt="@row.ItemName" width="72" height="54" loading="lazy">
                        </span>
                        <span class="mat-name-text">
                          <strong>@row.ItemName</strong>
                        </span>
                      </td>
                      <td class="mat-type">@(string.IsNullOrWhiteSpace(row.ShortDescription) ? "Liên hệ mô tả hàng để báo giá chính xác." : row.ShortDescription)</td>
                      <td class="text-end">
                        <span class="price-value">@row.PriceText</span>
                        @if (!string.IsNullOrWhiteSpace(row.Note))
                        {
                          <span class="price-note">@row.Note</span>
                        }
                      </td>
                    </tr>
                  }
                }
              </tbody>
            </table>
          </div>

          <div class="d-flex flex-wrap align-items-center gap-3 mt-4 reveal">
            <button class="btn btn-primary" type="button" data-quote-open>
              <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình để nhận giá chính xác
            </button>
            <a class="link-arrow" href="/phe-lieu">Xem danh mục loại phế liệu <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
          </div>
        </div>
      }
      else
      {
        <div class="alert alert-info">Bảng giá đang được cập nhật — vui lòng quay lại sau hoặc gọi hotline để được báo giá trực tiếp.</div>
      }

    </div>
  </section>
  <!-- ============================ PRICE TABLE END ============================ -->

  <!-- ============================ PRICE FACTORS START ============================ -->
  <section class="section section--surface section--bordered" aria-labelledby="pf-title">
    <div class="container">
      <div class="sec-head reveal">
        <span class="sec-label">Yếu tố ảnh hưởng giá</span>
        <h2 class="sec-title" id="pf-title">Vì sao cùng một loại phế liệu mà giá khác nhau?</h2>
        <p class="sec-desc">Sáu yếu tố quyết định mức giá cuối cùng bạn nhận được — hiểu rõ để chuẩn bị hàng đúng cách và bán được giá cao nhất.</p>
      </div>
      <div class="price-factors reveal">
        <div class="pf-item">
          <span class="pf-no" aria-hidden="true">01</span>
          <div>
            <h3>Độ sạch — tỷ lệ tạp chất</h3>
            <p>Hàng bóc tách sạch, không lẫn đất cát, ốc vít, nhựa hay bê tông sẽ được định giá theo mức cao của khung giá.</p>
          </div>
        </div>
        <div class="pf-item">
          <span class="pf-no" aria-hidden="true">02</span>
          <div>
            <h3>Số lượng lô hàng</h3>
            <p>Lô càng lớn giá càng tốt — trên 1 tấn đồng hoặc 5 tấn sắt, chúng tôi cộng thêm mức giá theo bậc khối lượng.</p>
          </div>
        </div>
        <div class="pf-item">
          <span class="pf-no" aria-hidden="true">03</span>
          <div>
            <h3>Đã phân loại hay để chung</h3>
            <p>Tách riêng từng loại trước khi bán giúp tiết kiệm công phân loại ở kho — phần chi phí đó được cộng lại vào giá cho bạn.</p>
          </div>
        </div>
        <div class="pf-item">
          <span class="pf-no" aria-hidden="true">04</span>
          <div>
            <h3>Khu vực và khoảng cách vận chuyển</h3>
            <p>Điểm hàng xa trục chính, đường xe tải không vào được sẽ tính thêm chi phí điều xe — càng gần kho giá càng sát trần.</p>
          </div>
        </div>
        <div class="pf-item">
          <span class="pf-no" aria-hidden="true">05</span>
          <div>
            <h3>Biến động thị trường</h3>
            <p>Giá kim loại thế giới và tỷ giá USD/VND thay đổi hằng ngày, khung giá trong bảng này cũng điều chỉnh theo từng phiên.</p>
          </div>
        </div>
        <div class="pf-item">
          <span class="pf-no" aria-hidden="true">06</span>
          <div>
            <h3>Yêu cầu hồ sơ — hóa đơn</h3>
            <p>Doanh nghiệp cần hóa đơn VAT, phiếu cân và biên bản thanh lý đầy đủ sẽ có quy trình riêng, giá tính theo hợp đồng.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ PRICE FACTORS END ============================ -->

  <!-- ============================ QUOTE CTA BAND START ============================ -->
  <section class="referral-band" aria-labelledby="quote-cta-title">
    <div class="referral-img" aria-hidden="true">
      <img src="~/assets/images/company/company-truck.svg" alt="" width="1200" height="800" loading="lazy">
    </div>
    <div class="container">
      <div class="referral-inner">
        <div class="reveal">
          <span class="tech-label">Báo giá nhanh</span>
          <h2 id="quote-cta-title">Cần giá chính xác cho lô hàng của bạn?</h2>
          <p>Gửi hình phế liệu — nhân viên báo giá trong [30 phút].</p>
        </div>
        <button class="btn btn-primary btn-lg reveal" type="button" data-quote-open>
          <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình nhận báo giá
        </button>
      </div>
    </div>
  </section>
  <!-- ============================ QUOTE CTA BAND END ============================ -->

  <!-- ============================ SEO CONTENT START ============================ -->
  <section class="section section--surface" aria-labelledby="seo-title">
    <div class="container">
      <div class="container-narrow mx-auto article-body">
        <h2 id="seo-title">Đọc bảng giá phế liệu đúng cách</h2>
        <p>
          Bảng giá trên trang này là mức thu mua tham khảo chúng tôi tổng hợp mỗi sáng, dựa trên giá kim loại thế giới,
          tỷ giá và tình hình giao dịch thực tế tại các kho thuộc Đồng Nai, TP.HCM và Bình Dương. Mỗi lô hàng có đặc điểm
          riêng về độ sạch, khối lượng và cách bảo quản, vì vậy mức giá cuối cùng luôn được chốt sau khi nhân viên
          xem hình hoặc khảo sát trực tiếp — không có chuyện báo một giá rồi ép xuống khi đến nơi.
        </p>
        <p>
          Nếu bạn lần đầu bán phế liệu, hãy dành vài phút phân loại trước: bóc vỏ dây điện, tách nhôm thanh khỏi khung,
          nhặt ốc vít và đất cát ra khỏi đống sắt. Cùng một lượng hàng, chỉ việc phân loại đúng có thể tăng giá trị
          bán ra từ 10 đến 40%. Chi tiết cách phân loại từng loại đã được tổng hợp
          tại trang <a href="/phe-lieu/danh-muc">phế liệu đồng</a> và các nhóm chất liệu khác.
        </p>
        <p>
          Chúng tôi nhận thu gom tận nơi tại 5 tỉnh thành miền Đông Nam Bộ với đội xe tải nhiều tải trọng,
          có xe cẩu đi kèm phục vụ tháo dỡ nhà xưởng và công trình. Danh sách huyện thị được phủ sóng chi tiết
          xem tại trang <a href="/khu-vuc">khu vực thu mua phế liệu</a> — chọn khu vực của bạn
          để xem thời gian xe tới dự kiến và bảng giá áp dụng tại chỗ.
        </p>
        <h2>Vì sao giá phế liệu thay đổi hàng ngày?</h2>
        <p>
          Phế liệu sau khi thu mua được gia công lại và bán cho nhà máy tái chế, nên giá thu mua bám sát giá nguyên liệu
          đầu vào. Giá đồng, nhôm, thép trên sàn giao dịch quốc tế tăng thì giá phế liệu trong nước tăng theo sau vài ngày;
          tỷ giá USD/VND mạnh lên cũng kéo giá các kim loại nhập khẩu đi lên. Ngược lại, khi công trình xây dựng giảm,
          lượng sắt thép thải dỡ xuống thấp, nguồn cung khan hiếm cũng đẩy giá thu mua lên.
        </p>
        <p>
          Vì biến động là điều bình thường của ngành, bảng giá này chỉ nên dùng để so sánh giữa các đơn vị thu mua
          và ước tính giá trị lô hàng của bạn. Khi cần con số chính xác để quyết định, hãy chụp vài tấm ảnh gần loại
          phế liệu gửi qua Zalo hoặc form báo giá — chúng tôi phản hồi trong [30 phút] làm việc
          với mức giá cụ thể theo đúng hình ảnh bạn gửi.
        </p>
      </div>
    </div>
  </section>
  <!-- ============================ SEO CONTENT END ============================ -->

  <!-- ============================ FINAL CTA START ============================ -->
  <section class="cta-final" aria-labelledby="cta-title">
    <div class="cta-final-bg" aria-hidden="true">
      <img src="~/assets/images/hero/hero-02.svg" alt="" width="1280" height="800" loading="lazy">
    </div>
    <div class="container">
      <div class="cta-final-inner">
        <span class="tech-label">Bán phế liệu ngay hôm nay</span>
        <h2 id="cta-title">Bạn đang có phế liệu cần thanh lý?</h2>
        <p>Gửi hình cho chúng tôi để nhận báo giá nhanh — hoặc gọi điện, chat Zalo nếu cần gấp.</p>
        <div class="cta-actions">
          <button class="btn btn-primary btn-lg" type="button" data-quote-open>
            <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình nhận giá
          </button>
          <a class="btn btn-outline-light btn-lg" href="tel:[HOTLINE]">
            <i class="bi bi-telephone-fill" aria-hidden="true"></i>[HOTLINE]
          </a>
          <a class="btn btn-outline-light btn-lg" href="https://zalo.me/[ZALO]" target="_blank" rel="noopener">
            <i class="bi bi-chat-dots-fill" aria-hidden="true"></i>Chat Zalo
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ FINAL CTA END ============================ -->

</main>
