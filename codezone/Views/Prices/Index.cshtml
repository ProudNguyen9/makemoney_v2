              </tr>
              <tr>
                <td class="mat-name"><span class="mat-swatch" aria-hidden="true" style="background:#D97B29"></span>Đồng super blank</td>
                <td class="mat-type">Tấm đồng sạch, không lẫn tạp chất</td>
                <td class="text-end"><span class="price-value">100.000 – 115.000</span></td>
                <td class="text-end"><span class="price-trend up"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i>+3%</span></td>
