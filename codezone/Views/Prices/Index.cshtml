@{
    ViewData["Title"] = "Bảng giá";
}

<main class="price-page">

  <!-- ============================ PAGE HERO START ============================ -->
  <section class="page-hero" aria-labelledby="prices-hero-title">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="~/assets/images/company/company-scale.svg" alt="" width="1600" height="900" fetchpriority="high">
    </div>
    <div class="container">
      <div class="page-hero-inner">
        <span class="tech-label">Bảng giá thu mua</span>
        <h1 id="prices-hero-title">Bảng giá phế liệu hôm nay</h1>
        <p class="page-hero-desc">
          Giá thu mua tham khảo cập nhật [DD/MM/YYYY] cho phế liệu đồng, sắt, nhôm, inox và vật liệu khác.
          Gửi hình để nhận giá chính xác theo lô hàng của bạn.
        </p>
        <ol class="breadcrumb-line">
          <li><a href="/">Trang chủ</a></li>
          <li aria-current="page">Bảng giá</li>
        </ol>
      </div>
    </div>
  </section>
  <!-- ============================ PAGE HERO END ============================ -->

  <!-- ============================ PRICE NOTICE START ============================ -->
  <section class="section section--sm" aria-label="Lưu ý về bảng giá">
    <div class="container">
      <div class="price-notice">
        <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
        <p class="mb-0">
          Giá mang tính tham khảo, biến động theo thị trường. Giá chốt cuối cùng phụ thuộc độ sạch, số lượng
          và khu vực — gọi <a href="tel:[HOTLINE]"><strong>[HOTLINE]</strong></a> hoặc gửi hình để nhận báo giá chính xác.
        </p>
      </div>
    </div>
  </section>
  <!-- ============================ PRICE NOTICE END ============================ -->

  <!-- ============================ ANCHOR NAV START ============================ -->
  <nav class="anchor-nav" aria-label="Điều hướng nhóm bảng giá">
    <div class="container">
      <div class="nav-scroll">
        <a href="#gia-dong" class="active">Đồng</a>
        <a href="#gia-sat">Sắt thép</a>
        <a href="#gia-nhom">Nhôm</a>
        <a href="#gia-inox">Inox</a>
        <a href="#gia-khac">Vật liệu khác</a>
      </div>
    </div>
  </nav>
  <!-- ============================ ANCHOR NAV END ============================ -->

  <!-- ============================ PRICE GROUPS START ============================ -->
