                <th scope="col" class="text-end">Xu hướng</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="mat-name"><span class="mat-swatch" aria-hidden="true" style="background:#B87333"></span>Đồng đỏ sạch</td>
                <td class="mat-type">Đồng đỏ bóc vỏ, không lẫn chì thiếc</td>
                <td class="text-end"><span class="price-value">75.000 – 95.000</span></td>
                <td class="text-end"><span class="price-trend up"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i>+2%</span></td>
              </tr>
              <tr>
                <td class="mat-name"><span class="mat-swatch" aria-hidden="true" style="background:#DAA520"></span>Đồng vàng</td>
                <td class="mat-type">Đồng thau, cây đồng vàng nguyên trạng</td>
                <td class="text-end"><span class="price-value">55.000 – 65.000</span></td>
                <td class="text-end"><span class="price-trend flat"><i class="bi bi-dash-lg" aria-hidden="true"></i>Ổn định</span></td>
              </tr>
              <tr>
                <td class="mat-name"><span class="mat-swatch" aria-hidden="true" style="background:#8E5A3B"></span>Đồng cáp</td>
                <td class="mat-type">Cáp đồng đa sợi đã bọc tách sẵn</td>
                <td class="text-end"><span class="price-value">50.000 – 60.000</span></td>
                <td class="text-end"><span class="price-trend up"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i>+1%</span></td>
              </tr>
              <tr>
                <td class="mat-name"><span class="mat-swatch" aria-hidden="true" style="background:#C08552"></span>Dây điện bọc nhựa</td>
                <td class="mat-type">Mua nguyên trạng theo ký, chưa bóc vỏ</td>
                <td class="text-end"><span class="price-value">30.000 – 40.000</span></td>
                <td class="text-end"><span class="price-trend flat"><i class="bi bi-dash-lg" aria-hidden="true"></i>Ổn định</span></td>
              </tr>
              <tr>
                <td class="mat-name"><span class="mat-swatch" aria-hidden="true" style="background:#B06E3B"></span>Đồng máy lạnh</td>
