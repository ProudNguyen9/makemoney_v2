@{
    ViewData["Title"] = "Không tìm thấy";
}

<main>

  <!-- ============================ ERROR 404 START ============================ -->
  <section class="error-404" aria-labelledby="err-title">
    <div class="container">
      <span class="err-code">404</span>
      <h1 id="err-title">Không tìm thấy trang bạn yêu cầu</h1>
      <p>Trang có thể đã bị xóa, đổi đường dẫn hoặc bạn gõ sai địa chỉ. Thử một trong các cách dưới đây.</p>
      <div class="cta-actions">
        <a class="btn btn-primary btn-lg" href="/">
          <i class="bi bi-house-door" aria-hidden="true"></i>Về trang chủ
        </a>
        <a class="btn btn-outline-light btn-lg" href="/lien-he">
          <i class="bi bi-envelope" aria-hidden="true"></i>Liên hệ
        </a>
      </div>
    </div>
  </section>
  <!-- ============================ ERROR 404 END ============================ -->

</main>
