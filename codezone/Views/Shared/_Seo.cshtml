@model SeoDto?
<meta name="description" content="@(Model?.Description ?? "Website thu mua phe lieu.")" />
@if (!string.IsNullOrWhiteSpace(Model?.Keywords))
{
    <meta name="keywords" content="@Model.Keywords" />
}
@if (!string.IsNullOrWhiteSpace(Model?.CanonicalUrl))
{
    <link rel="canonical" href="@Model.CanonicalUrl" />
}
<meta name="robots" content="@((Model?.RobotsIndex ?? true) ? "index" : "noindex"),@((Model?.RobotsFollow ?? true) ? "follow" : "nofollow")" />
<meta property="og:type" content="@(Model?.OgType ?? "website")" />
<meta property="og:title" content="@(Model?.OgTitle ?? Model?.Title ?? "ScrapWebsite")" />
<meta property="og:description" content="@(Model?.OgDescription ?? Model?.Description ?? "Website thu mua phe lieu.")" />
@if (!string.IsNullOrWhiteSpace(Model?.OgImage))
{
    <meta property="og:image" content="@Model.OgImage" />
}
