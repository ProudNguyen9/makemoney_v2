@model codezone.ViewModels.Shared.QuickQuoteFormViewModel

@if (Model.ShowTitle)
{
    <h3 class="quote-panel-title">@Model.Title</h3>
    <p class="quote-panel-sub">@Model.Subtitle</p>
}

<form class="js-quote-form" action="/contact/quick-quote" method="post" enctype="multipart/form-data" novalidate>
  @Html.AntiForgeryToken()
  <div class="quote-form-body row g-3">
    <div class="col-md-6">
      <div class="form-field">
        <label class="form-label-tech" for="qq-name-@Model.IdSuffix">Họ tên</label>
        <input class="form-control" type="text" id="qq-name-@Model.IdSuffix" name="name" placeholder="Nguyễn Văn A">
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-field">
        <label class="form-label-tech" for="qq-phone-@Model.IdSuffix">Số điện thoại <span class="required-mark">*</span></label>
        <input class="form-control" type="tel" id="qq-phone-@Model.IdSuffix" name="phone" placeholder="09xx xxx xxx" required>
        <div class="invalid-feedback">Vui lòng nhập số điện thoại hợp lệ.</div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-field">
        <label class="form-label-tech" for="qq-zalo-@Model.IdSuffix">Zalo</label>
        <input class="form-control" type="text" id="qq-zalo-@Model.IdSuffix" name="zalo" placeholder="Số Zalo (nếu khác)">
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-field">
        <label class="form-label-tech" for="qq-scrap-@Model.IdSuffix">Loại phế liệu <span class="required-mark">*</span></label>
        <select class="form-select" id="qq-scrap-@Model.IdSuffix" name="scrap" required>
          <option value="">— Chọn loại phế liệu —</option>
          <option>Đồng / dây điện</option>
          <option>Sắt thép</option>
          <option>Nhôm</option>
          <option>Inox</option>
          <option>Máy móc — motor</option>
          <option>Bo mạch — điện tử</option>
          <option>Nhà xưởng — công trình</option>
          <option>Khác (ghi rõ ở ghi chú)</option>
        </select>
        <div class="invalid-feedback">Vui lòng chọn loại phế liệu.</div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-field">
        <label class="form-label-tech" for="qq-qty-@Model.IdSuffix">Số lượng (ước tính)</label>
        <input class="form-control" type="text" id="qq-qty-@Model.IdSuffix" name="quantity" placeholder="VD: khoảng 2 tấn sắt">
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-field">
        <label class="form-label-tech" for="qq-area-@Model.IdSuffix">Khu vực <span class="required-mark">*</span></label>
        <select class="form-select" id="qq-area-@Model.IdSuffix" name="area" required>
          <option value="">— Chọn khu vực —</option>
          <option>Đồng Nai</option>
          <option>TP. Hồ Chí Minh</option>
          <option>Bình Dương</option>
          <option>Bà Rịa – Vũng Tàu</option>
          <option>Tỉnh khác</option>
        </select>
        <div class="invalid-feedback">Vui lòng chọn khu vực.</div>
      </div>
    </div>
    <div class="col-12">
      <div class="form-field">
        <span class="form-label-tech">Hình ảnh phế liệu</span>
        <div class="upload-drop" role="button" tabindex="0" aria-label="Tải ảnh phế liệu lên">
          <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
          <p class="upload-title mb-0">Kéo thả ảnh vào đây hoặc bấm chọn file</p>
          <p class="upload-hint">Tối đa 3 ảnh JPG/PNG — chụp gần loại phế liệu để báo giá chính xác</p>
          <input type="file" name="Images" accept="image/*" multiple hidden>
        </div>
        <div class="upload-previews" aria-live="polite"></div>
      </div>
    </div>
    <div class="col-12">
      <div class="form-field">
        <label class="form-label-tech" for="qq-note-@Model.IdSuffix">Ghi chú</label>
        <textarea class="form-control" id="qq-note-@Model.IdSuffix" name="note" rows="2" placeholder="Mô tả thêm: tình trạng, thời gian mong muốn thu gom…"></textarea>
      </div>
    </div>
    <div class="col-12 d-flex flex-wrap align-items-center gap-3">
      <button class="btn btn-primary btn-lg" type="submit">
        <i class="bi bi-send-fill" aria-hidden="true"></i>Gửi nhận báo giá
      </button>
      <span class="text-muted-2 small">Hoặc gọi ngay <a href="@Model.HotlineHref" class="fw-semibold">@Model.Hotline</a></span>
    </div>
  </div>
  <div class="quote-state" aria-live="polite"></div>
</form>
