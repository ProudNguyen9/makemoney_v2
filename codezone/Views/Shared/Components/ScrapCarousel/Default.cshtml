@model IReadOnlyList<ScrapItem>
<section class="section-block">
    <div class="section-title">
        <h2>Mat hang phe lieu</h2>
        <a asp-controller="Scrap" asp-action="Index">Xem tat ca</a>
    </div>
    <div class="card-grid">
        @foreach (var item in Model)
        {
            <article class="content-card">
                <img src="@AssetHelper.NormalizePath(item.PrimaryImage)" alt="@item.Name" />
                <h3>@item.Name</h3>
                <p>@item.ShortDescription</p>
                <a asp-controller="Scrap" asp-action="Detail" asp-route-slug="@item.Slug">Chi tiet</a>
            </article>
        }
    </div>
</section>
