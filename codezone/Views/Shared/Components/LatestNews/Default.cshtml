@model IReadOnlyList<Post>
<section class="section-block">
    <div class="section-title">
        <h2>Tin moi</h2>
        <a asp-area="" asp-controller="News" asp-action="Index">Xem tin tuc</a>
    </div>
    <div class="card-grid">
        @foreach (var post in Model)
        {
            <article class="content-card">
                <img src="@AssetHelper.NormalizePath(post.CoverImage)" alt="@post.Title" />
                <h3>@post.Title</h3>
                <p>@post.Excerpt</p>
                <a asp-area="" asp-controller="News" asp-action="Detail" asp-route-slug="@post.Slug">Doc tiep</a>
            </article>
        }
    </div>
</section>
