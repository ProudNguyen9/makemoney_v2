<!-- ============================================================================
     PARTIAL: Footer + Floating contact + Mobile contact bar + Back-to-top
     + Quote Modal (QuickQuoteForm)
     Convert sang Razor: Views/Shared/_Footer.cshtml, _FloatingContact.cshtml,
     _MobileBar.cshtml, _QuoteModal.cshtml
     ============================================================================ -->
@model codezone.ViewModels.Shared.SiteChromeViewModel

<!-- FOOTER START -->
<footer class="footer-site">
  <!-- CTA band trên footer -->
  <div class="footer-cta-band">
    <div class="container">
      <div class="footer-cta-inner">
        <div class="fcb-text">
          <i class="bi bi-camera-fill" aria-hidden="true"></i>
          <span>
            <strong>Gửi hình — nhận báo giá trong [30 phút]</strong>
            <small>Chụp ảnh phế liệu, gửi cho chúng tôi để nhận giá thu mua chính xác.</small>
          </span>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <button class="btn btn-light" type="button" data-quote-open>
            <i class="bi bi-upload" aria-hidden="true"></i>Gửi hình
          </button>
          <a class="btn btn-outline-light" href="@Model.HotlineHref">
            <i class="bi bi-telephone-fill" aria-hidden="true"></i>@Model.Hotline
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-top">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-4 col-md-6 footer-brand">
          <img class="brand-logo" src="@Model.FooterLogoUrl" asp-append-version="true" alt="Logo @Model.CompanyName" width="1137" height="566" loading="lazy">
          <p>Thu mua phế liệu đồng, sắt, nhôm, inox tận nơi cho cá nhân, công trình và doanh nghiệp. Cân đo minh bạch, thanh toán ngay.</p>
          <div class="footer-cert">
            <span class="cert-chip"><i class="bi bi-patch-check-fill" aria-hidden="true"></i>MST: @Model.TaxCode</span>
            <span class="cert-chip"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>Kho: @Model.WarehouseAddress</span>
          </div>
        </div>

        <nav class="col-lg-2 col-md-6 col-6 footer-col" aria-label="Phế liệu thu mua">
          <h2 class="footer-col-title">Phế liệu</h2>
          <ul class="footer-links">
            <li><a href="/phe-lieu/nhom/dong">Phế liệu đồng</a></li>
            <li><a href="/phe-lieu/nhom/sat-thep">Phế liệu sắt thép</a></li>
            <li><a href="/phe-lieu/nhom/nhom">Phế liệu nhôm</a></li>
            <li><a href="/phe-lieu/nhom/inox">Phế liệu inox</a></li>
            <li><a href="/phe-lieu/nhom/giay-nhua">Giấy — nhựa</a></li>
            <li><a href="/phe-lieu/nhom/may-moc-dien-tu">Máy móc — điện tử</a></li>
            <li><a href="/phe-lieu">Xem tất cả</a></li>
          </ul>
        </nav>

        <nav class="col-lg-2 col-md-6 col-6 footer-col" aria-label="Dịch vụ">
          <h2 class="footer-col-title">Dịch vụ</h2>
          <ul class="footer-links">
            <li><a href="/dich-vu/thu-mua-tan-noi">Thu mua tận nơi</a></li>
            <li><a href="/dich-vu/thu-mua-tan-noi">Thanh lý nhà xưởng</a></li>
            <li><a href="/dich-vu/thu-mua-tan-noi">Thu mua công trình</a></li>
            <li><a href="/dich-vu/thu-mua-tan-noi">Thu mua máy móc</a></li>
            <li><a href="/hoa-hong">Chính sách hoa hồng</a></li>
          </ul>
        </nav>

        <nav class="col-lg-2 col-md-6 col-6 footer-col" aria-label="Khu vực">
          <h2 class="footer-col-title">Khu vực</h2>
          <ul class="footer-links">
            <li><a href="/khu-vuc">Đồng Nai</a></li>
            <li><a href="/khu-vuc">TP. Hồ Chí Minh</a></li>
            <li><a href="/khu-vuc">Bình Dương</a></li>
            <li><a href="/khu-vuc">Bà Rịa – Vũng Tàu</a></li>
            <li><a href="/khu-vuc">Xem tất cả</a></li>
          </ul>
        </nav>

        <div class="col-lg-2 col-md-6 footer-col">
          <h2 class="footer-col-title">Liên hệ</h2>
          <ul class="footer-contact">
            <li>
              <i class="bi bi-telephone-fill" aria-hidden="true"></i>
              <span><a href="@Model.HotlineHref"><strong>@Model.Hotline</strong></a><br><span>Zalo: @Model.Zalo</span></span>
            </li>
            <li>
              <i class="bi bi-envelope-fill" aria-hidden="true"></i>
              <span><a href="mailto:@Model.Email">@Model.Email</a></span>
            </li>
            <li>
              <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
              <span>@Model.Address</span>
            </li>
          </ul>
          <div class="footer-hours">
            <i class="bi bi-clock-fill" aria-hidden="true"></i>
            Thứ 2 – Chủ nhật: @Model.WorkingHours
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <div class="footer-bottom-inner">
        <span>© <span data-year>2026</span> @Model.CompanyName. Giữ toàn quyền.</span>
        <nav aria-label="Liên kết phụ">
          <a href="/hoa-hong">Chính sách hoa hồng</a> ·
          <a href="/gioi-thieu">Giới thiệu</a> ·
          <a href="/lien-he">Liên hệ</a>
        </nav>
      </div>
    </div>
  </div>
</footer>
<!-- FOOTER END -->

<!-- FLOATING CONTACT (desktop) START -->
<div class="floating-contact" aria-label="Liên hệ nhanh">
  <a class="fc-phone" href="@Model.HotlineHref" aria-label="Gọi hotline"><i class="bi bi-telephone-fill" aria-hidden="true"></i></a>
  <a class="fc-messenger" href="@Model.MessengerHref" target="@(Model.MessengerHref == "#" ? null : "_blank")" rel="noopener" aria-label="Chat Messenger"><i class="bi bi-messenger" aria-hidden="true"></i></a>
  <a class="fc-zalo" href="@Model.ZaloHref" target="_blank" rel="noopener" aria-label="Chat Zalo">Zalo</a>
</div>
<!-- FLOATING CONTACT END -->

<!-- MOBILE CONTACT BAR START -->
<div class="mobile-bar" aria-label="Liên hệ nhanh">
  <a href="@Model.HotlineHref"><i class="bi bi-telephone-fill" aria-hidden="true"></i>Gọi ngay</a>
  <a href="@Model.ZaloHref" target="_blank" rel="noopener"><i class="bi bi-chat-dots-fill" aria-hidden="true"></i>Zalo</a>
  <a class="mobile-bar-cta" href="javascript:void(0)" data-quote-open><i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình báo giá</a>
</div>
<!-- MOBILE CONTACT BAR END -->

<!-- BACK TO TOP START -->
<button class="back-top" type="button" aria-label="Về đầu trang">
  <i class="bi bi-arrow-up" aria-hidden="true"></i>
</button>
<!-- BACK TO TOP END -->

<!-- QUOTE MODAL START (QuickQuoteForm) -->
<div class="modal fade" id="quoteModal" tabindex="-1" aria-labelledby="quoteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-bottom">
        <h2 class="modal-title fs-5 text-uppercase" id="quoteModalLabel">Gửi hình — nhận báo giá</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
      </div>
      <div class="modal-body">
        <!-- QUICK QUOTE FORM START -->
            @await Html.PartialAsync("~/Views/Shared/Partials/Public/_QuickQuoteForm.cshtml", new codezone.ViewModels.Shared.QuickQuoteFormViewModel(IdSuffix: "modal", ShowTitle: false, Hotline: Model.Hotline, HotlineHref: Model.HotlineHref))
            <!-- QUICK QUOTE FORM END -->
      </div>
    </div>
  </div>
</div>
<!-- QUOTE MODAL END -->
