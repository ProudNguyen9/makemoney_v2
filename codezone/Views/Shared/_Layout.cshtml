@inject ScrapWebsite.Services.Interfaces.ISiteChromeService SiteChromeService
@{
    var seo = ViewData["Seo"] as SeoDto;
    var title = seo?.Title ?? ViewData["Title"]?.ToString() ?? "ScrapWebsite";
    var chrome = await SiteChromeService.GetAsync(Context.RequestAborted);
    // SEO-002: hậu tố tiêu đề lấy từ setting seo.site_title (fallback: tên công ty), không hardcode.
    var siteTitle = string.IsNullOrWhiteSpace(chrome.SiteTitle) ? chrome.CompanyName : chrome.SiteTitle;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_Seo" model="seo" />
    <title>@title - @siteTitle</title>
    <link rel="icon" href="@chrome.FaviconUrl" type="image/png" />
    <link rel="apple-touch-icon" href="~/assets/images/imported/brand/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/assets/vendor/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/assets/vendor/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/assets/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/responsive.css" asp-append-version="true" />
</head>
<body class="has-mobilebar @(ViewData["BodyClass"] ?? "")">
    @await Component.InvokeAsync("Header")

    @RenderBody()

    @await Component.InvokeAsync("Footer")

    <script src="~/assets/vendor/bootstrap.min.js"></script>
    <script src="~/assets/vendor/swiper-bundle.min.js"></script>
    <script src="~/assets/js/gallery.js" asp-append-version="true"></script>
    <script src="~/assets/js/main.js" asp-append-version="true"></script>
    <script src="~/assets/js/navigation.js" asp-append-version="true"></script>
    <script src="~/assets/js/quote-form.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
