@{
    ViewData["Title"] = "Chi tiết dự án";
    var project = (ScrapWebsite.Controllers.ProjectDetailDto)(ViewData["Project"]
        ?? new ScrapWebsite.Controllers.ProjectDetailDto(0, "Dự án", "", null, null, null, null, null, null, null, null, []));
}

<main>

  <!-- ============================ ARTICLE HEAD START ============================ -->
  <div class="article-head">
    <div class="container">
      <ol class="breadcrumb-line">
        <li><a href="/">Trang chủ</a></li>
        <li><a href="/du-an">Dự án</a></li>
        <li aria-current="page">@project.Title</li>
      </ol>
      @if (!string.IsNullOrWhiteSpace(project.ProjectType))
      {
        <span class="tag-min tag-min--dark">@project.ProjectType</span>
      }
      <h1>@project.Title</h1>
      <div class="article-meta">
        @if (project.CompletedAt.HasValue)
        {
          <span><i class="bi bi-calendar3" aria-hidden="true"></i>@project.CompletedAt.Value.ToString("dd/MM/yyyy")</span>
        }
        @if (!string.IsNullOrWhiteSpace(project.LocationText))
        {
          <span><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>@project.LocationText</span>
        }
      </div>
    </div>
  </div>
  <!-- ============================ ARTICLE HEAD END ============================ -->

  <!-- ============================ ARTICLE COVER START ============================ -->
  <div class="container">
    <div class="article-cover">
      <img src="@(string.IsNullOrWhiteSpace(project.CoverImage) ? "/assets/images/projects/project-01-cover.svg" : project.CoverImage)" alt="@project.Title" width="1600" height="900" loading="lazy">
    </div>
  </div>
  <!-- ============================ ARTICLE COVER END ============================ -->

  <!-- ============================ PROJECT INFO BAR START ============================ -->
  <div class="project-info-bar">
    <div class="container">
      <div class="pib-grid">
        <div class="pib-item">
          <small>Địa điểm</small>
          <strong>@(string.IsNullOrWhiteSpace(project.LocationText) ? "—" : project.LocationText)</strong>
        </div>
        <div class="pib-item">
          <small>Loại dự án</small>
          <strong>@(string.IsNullOrWhiteSpace(project.ProjectType) ? "—" : project.ProjectType)</strong>
        </div>
        <div class="pib-item">
          <small>Khối lượng</small>
          <strong>@(string.IsNullOrWhiteSpace(project.QuantityText) ? "—" : project.QuantityText)</strong>
        </div>
        <div class="pib-item">
          <small>Thời gian</small>
          <strong>@(string.IsNullOrWhiteSpace(project.DurationText) ? "—" : project.DurationText)</strong>
        </div>
      </div>
    </div>
  </div>
  <!-- ============================ PROJECT INFO BAR END ============================ -->

  <!-- ============================ PROJECT STORY START ============================ -->
  <section class="section section--paper" aria-label="Chi tiết dự án">
    <div class="container">
      <div class="row row-editorial">
        <div class="col-lg-8 article-body reveal">
          @if (!string.IsNullOrWhiteSpace(project.ContentHtml))
          {
            @Html.Raw(project.ContentHtml)
          }
          else if (!string.IsNullOrWhiteSpace(project.Excerpt))
          {
            <p>@project.Excerpt</p>
          }
          else
          {
            <p>Nội dung dự án đang được cập nhật.</p>
          }
        </div>
      </div>

      @if (project.Images.Count > 0)
      {
        <!-- PROJECT GALLERY START -->
        <div class="scope-grid reveal mt-5">
          @foreach (var image in project.Images)
          {
            <figure class="scope-item m-0">
              <img src="@image.ImageUrl" alt="@(string.IsNullOrWhiteSpace(image.AltText) ? project.Title : image.AltText)" width="800" height="600" loading="lazy" style="width:100%;height:auto;border-radius:8px;">
            </figure>
          }
        </div>
        <!-- PROJECT GALLERY END -->
      }
    </div>
  </section>
  <!-- ============================ PROJECT STORY END ============================ -->

  <!-- ============================ FINAL CTA START ============================ -->
  <section class="cta-final" aria-labelledby="cta-title">
    <div class="cta-final-bg" aria-hidden="true">
      <img src="~/assets/images/hero/hero-02.svg" alt="" width="1280" height="800" loading="lazy">
    </div>
    <div class="container">
      <div class="cta-final-inner">
        <span class="tech-label">Bán phế liệu ngay hôm nay</span>
        <h2 id="cta-title">Bạn cũng có hạng mục tương tự cần thanh lý?</h2>
        <p>Gửi hình cho chúng tôi để nhận báo giá nhanh — hoặc gọi điện, chat Zalo nếu cần gấp.</p>
        <div class="cta-actions">
          <button class="btn btn-primary btn-lg" type="button" data-quote-open>
            <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình nhận giá
          </button>
          <a class="btn btn-outline-light btn-lg" href="/lien-he">
            <i class="bi bi-envelope-fill" aria-hidden="true"></i>Liên hệ ngay
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ FINAL CTA END ============================ -->

</main>
