          <div class="swiper-slide">
            <img src="~/assets/images/projects/project-03-cover.svg" alt="Máy móc cũ được tháo rời khỏi nền bê tông" width="1280" height="800" loading="lazy">
          </div>
          <div class="swiper-slide">
