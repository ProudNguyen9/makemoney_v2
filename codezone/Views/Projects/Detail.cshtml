    <div class="article-cover">
      <img src="~/assets/images/projects/project-01-cover.svg" alt="Toàn cảnh nhà xưởng 2.000m² tại Biên Hòa trước khi tháo dỡ" width="1600" height="900" loading="lazy">
    </div>
  </div>
  <!-- ============================ ARTICLE COVER END ============================ -->

  <!-- ============================ PROJECT INFO BAR START ============================ -->
  <div class="project-info-bar">
    <div class="container">
      <div class="pib-grid">
        <div class="pib-item">
          <small>Địa điểm</small>
          <strong>Biên Hòa, Đồng Nai</strong>
        </div>
        <div class="pib-item">
          <small>Phạm vi</small>
          <strong>Tháo dỡ + thu mua trọn gói</strong>
        </div>
        <div class="pib-item">
          <small>Loại phế liệu</small>
          <strong>Sắt thép, tôn, dây điện</strong>
        </div>
