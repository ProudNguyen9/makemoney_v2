@{
    ViewData["Title"] = "Dự án";
    var projects = (IReadOnlyList<ScrapWebsite.Controllers.ProjectCardDto>)(ViewData["Projects"] ?? Array.Empty<ScrapWebsite.Controllers.ProjectCardDto>());
    var projectTypes = (List<string>)(ViewData["ProjectTypes"] ?? new List<string>());
}

<main>

  <!-- ============================ PAGE HERO START ============================ -->
  <section class="page-hero" aria-labelledby="projects-hero-title">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="~/assets/images/projects/project-03-cover.svg" alt="" width="1600" height="900" fetchpriority="high">
    </div>
    <div class="container">
      <div class="page-hero-inner">
        <span class="tech-label">Dự án</span>
        <h1 id="projects-hero-title">Dự án thu mua đã thực hiện</h1>
        <p class="page-hero-desc">
          Các hợp đồng tiêu biểu: thanh lý nhà xưởng, thu gom công trình,
          mua máy móc và dây chuyền sản xuất. Mỗi dự án đều có khối lượng, thời gian
          và khu vực cụ thể — không phóng đại, không làm đẹp số liệu.
        </p>
        <ol class="breadcrumb-line">
          <li><a href="/">Trang chủ</a></li>
          <li aria-current="page">Dự án</li>
        </ol>
      </div>
    </div>
  </section>
  <!-- ============================ PAGE HERO END ============================ -->

  <!-- ============================ PROJECT LIST START ============================ -->
  <section class="section section--paper" aria-label="Danh sách dự án thu mua">
    <div class="container">

      @if (projectTypes.Count > 0)
      {
        <!-- FILTER BAR START -->
        <div class="filter-bar" role="group" aria-label="Lọc dự án theo loại">
          <span class="filter-label">Lọc theo loại</span>
          @foreach (var type in projectTypes)
          {
            <span class="filter-link">@type</span>
          }
        </div>
        <!-- FILTER BAR END -->
      }

      @if (projects.Count == 0)
      {
        <div class="alert alert-info">Danh sách dự án đang được cập nhật.</div>
      }

      <div class="project-rows">
        @foreach (var project in projects.Select((item, index) => new { item, index }))
        {
          var flip = project.index % 2 == 1;
          <!-- PROJECT ROW @(project.index + 1) START -->
          <article class="project-row reveal @(flip ? "project-row--flip" : null)">
            <div class="project-row-media">
              <img src="@(string.IsNullOrWhiteSpace(project.item.CoverImage) ? "/assets/images/projects/project-01-cover.svg" : project.item.CoverImage)" alt="@project.item.Title" width="1200" height="750" loading="lazy">
              @if (!string.IsNullOrWhiteSpace(project.item.ProjectType))
              {
                <span class="pr-badge tag-min tag-min--dark">@project.item.ProjectType</span>
              }
            </div>
            <div class="project-row-body">
              <div class="project-meta">
                @if (!string.IsNullOrWhiteSpace(project.item.LocationText))
                {
                  <span><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>@project.item.LocationText</span>
                }
                @if (project.item.CompletedAt.HasValue)
                {
                  <span><i class="bi bi-calendar3" aria-hidden="true"></i>@project.item.CompletedAt.Value.ToString("dd/MM/yyyy")</span>
                }
              </div>
              <h2>@project.item.Title</h2>
              @if (!string.IsNullOrWhiteSpace(project.item.Excerpt))
              {
                <p>@project.item.Excerpt</p>
              }
              <div class="project-specs">
                @if (!string.IsNullOrWhiteSpace(project.item.QuantityText))
                {
                  <div class="ps-item">
                    <strong>@project.item.QuantityText</strong>
                    <small>Khối lượng</small>
                  </div>
                }
                @if (!string.IsNullOrWhiteSpace(project.item.DurationText))
                {
                  <div class="ps-item">
                    <strong>@project.item.DurationText</strong>
                    <small>Thời gian</small>
                  </div>
                }
              </div>
              <a class="link-arrow" href="/du-an/@project.item.Slug">Xem dự án <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
          </article>
          <!-- PROJECT ROW @(project.index + 1) END -->
        }
      </div>
    </div>
  </section>
  <!-- ============================ PROJECT LIST END ============================ -->

  <!-- ============================ FINAL CTA START ============================ -->
  <section class="cta-final" aria-labelledby="cta-title">
    <div class="cta-final-bg" aria-hidden="true">
      <img src="~/assets/images/hero/hero-02.svg" alt="" width="1280" height="800" loading="lazy">
    </div>
    <div class="container">
      <div class="cta-final-inner">
        <span class="tech-label">Bán phế liệu ngay hôm nay</span>
        <h2 id="cta-title">Dự án tiếp theo là của bạn?</h2>
        <p>Gửi hình cho chúng tôi để nhận báo giá nhanh — hoặc gọi điện, chat Zalo nếu cần gấp.</p>
        <div class="cta-actions">
          <button class="btn btn-primary btn-lg" type="button" data-quote-open>
            <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình nhận giá
          </button>
          <a class="btn btn-outline-light btn-lg" href="/lien-he">
            <i class="bi bi-envelope-fill" aria-hidden="true"></i>Liên hệ ngay
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ FINAL CTA END ============================ -->

</main>
