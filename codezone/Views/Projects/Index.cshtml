@inject ScrapWebsite.Services.Interfaces.ISiteChromeService SiteChromeService
@{
    ViewData["Title"] = "Dự án";
    var projects = (IReadOnlyList<ScrapWebsite.Controllers.ProjectCardDto>)(ViewData["Projects"] ?? Array.Empty<ScrapWebsite.Controllers.ProjectCardDto>());
    var projectTypes = (List<string>)(ViewData["ProjectTypes"] ?? new List<string>());
    var chrome = await SiteChromeService.GetAsync(Context.RequestAborted);
}

<main>

  <!-- ============================ PAGE HERO START ============================ -->
  <section class="page-hero" aria-labelledby="projects-hero-title">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="~/assets/images/projects/project-03-cover.svg" alt="" width="1600" height="900" fetchpriority="high">
    </div>
    <div class="container">
      <div class="page-hero-inner">
        <span class="tech-label">Dự án</span>
        <h1 id="projects-hero-title">Dự án thu mua đã thực hiện</h1>
        <p class="page-hero-desc">
          Các hợp đồng tiêu biểu: thanh lý nhà xưởng, thu gom công trình,
          mua máy móc và dây chuyền sản xuất. Mỗi dự án đều có khối lượng, thời gian
          và khu vực cụ thể — không phóng đại, không làm đẹp số liệu.
        </p>
        <ol class="breadcrumb-line">
          <li><a href="/">Trang chủ</a></li>
          <li aria-current="page">Dự án</li>
        </ol>
      </div>
    </div>
  </section>
  <!-- ============================ PAGE HERO END ============================ -->

  <!-- ============================ PROJECT LIST START ============================ -->
  <section class="section section--paper" aria-label="Danh sách dự án thu mua">
    <div class="container">

      <!-- Filter dự án - đồng bộ -->
      <div class="cat-filter-bar reveal" style="display:flex; gap:0.6rem; flex-wrap:wrap; align-items:center; background:linear-gradient(180deg,#FFFFFF 0%,#FFFBF5 100%); border:1px solid #F0E6D8; border-radius:12px; padding:0.75rem 0.9rem; box-shadow:0 8px 20px rgba(228,87,15,0.06); margin-bottom:1.25rem;">
        <div style="position:relative; flex:7 1 0; min-width:0;">
          <i class="bi bi-search" style="position:absolute; left:0.85rem; top:50%; transform:translateY(-50%); color:#9AA3AE;"></i>
          <input id="projectSearch" type="search" class="form-control" placeholder="Tìm dự án: nhà xưởng, công trình..." style="padding-left:2.4rem; height:40px; border-radius:10px; border:1px solid #E8E0D6; width:100%;">
        </div>
        <select id="projectTypeFilter" class="form-select" style="flex:3 1 0; min-width:0; height:40px; border-radius:10px; border:1px solid #E8E0D6;">
          <option value="">Tất cả</option>
          @foreach (var type in projectTypes)
          {
            <option value="@type.ToLower()">@type</option>
          }
        </select>
        <button id="projectFilterBtn" class="btn btn-primary" type="button" style="height:40px; padding:0 1.2rem; border-radius:10px;"><i class="bi bi-funnel-fill"></i> Lọc</button>
      </div>

      @if (projects.Count == 0)
      {
        <div class="alert alert-info">Danh sách dự án đang được cập nhật.</div>
      }

      <div class="project-rows" id="projectRows">
        @foreach (var project in projects.Select((item, index) => new { item, index }))
        {
          var flip = project.index % 2 == 1;
          var shortExcerpt = string.IsNullOrWhiteSpace(project.item.Excerpt) ? "" : (project.item.Excerpt.Length>110 ? project.item.Excerpt.Substring(0,110).Trim()+"…": project.item.Excerpt);
          <!-- PROJECT ROW @(project.index + 1) START -->
          <article class="project-row reveal @(flip ? "project-row--flip" : null)" data-name="@project.item.Title.ToLower()" data-type="@(project.item.ProjectType?.ToLower() ?? "")">
            <div class="project-row-media">
              <img src="@(string.IsNullOrWhiteSpace(project.item.CoverImage) ? "/assets/images/projects/project-01-cover.svg" : project.item.CoverImage)" alt="@project.item.Title" width="1200" height="750" loading="lazy">
              <partial name="~/Views/Shared/Partials/Public/_MediaHotlineOverlay.cshtml" model="chrome.Hotline" />
              @if (!string.IsNullOrWhiteSpace(project.item.ProjectType))
              {
                <span class="pr-badge tag-min tag-min--dark">@project.item.ProjectType</span>
              }
            </div>
            <div class="project-row-body">
              <div class="project-meta">
                @if (!string.IsNullOrWhiteSpace(project.item.LocationText))
                {
                  <span><i class="bi bi-geo-alt-fill" aria-hidden="true"></i>@project.item.LocationText</span>
                }
                @if (project.item.CompletedAt.HasValue)
                {
                  <span><i class="bi bi-calendar3" aria-hidden="true"></i>@project.item.CompletedAt.Value.ToString("dd/MM/yyyy")</span>
                }
              </div>
              <h2 style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">@project.item.Title</h2>
              @if (!string.IsNullOrWhiteSpace(shortExcerpt))
              {
                <p style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">@shortExcerpt</p>
              }
              <div class="project-specs">
                @if (!string.IsNullOrWhiteSpace(project.item.QuantityText))
                {
                  <div class="ps-item">
                    <strong>@project.item.QuantityText</strong>
                    <small>Khối lượng</small>
                  </div>
                }
                @if (!string.IsNullOrWhiteSpace(project.item.DurationText))
                {
                  <div class="ps-item">
                    <strong>@project.item.DurationText</strong>
                    <small>Thời gian</small>
                  </div>
                }
              </div>
              <a class="link-arrow" href="/du-an/@project.item.Slug">Xem dự án <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
          </article>
          <!-- PROJECT ROW @(project.index + 1) END -->
        }
      </div>
    </div>
  </section>
  <script>
  (function(){
    var s=document.getElementById('projectSearch');
    var sel=document.getElementById('projectTypeFilter');
    var btn=document.getElementById('projectFilterBtn');
    function filter(){
      var q=(s.value||'').toLowerCase().trim();
      var t=(sel.value||'').toLowerCase().trim();
      document.querySelectorAll('#projectRows .project-row').forEach(function(r){
        var name=r.getAttribute('data-name')||'';
        var type=r.getAttribute('data-type')||'';
        var okName=!q||name.indexOf(q)!==-1;
        var okType=!t||type.indexOf(t)!==-1;
        r.style.display=(okName&&okType)?'':'none';
      });
    }
    if(btn) btn.addEventListener('click',filter);
    if(s) s.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();filter();}});
    if(s) s.addEventListener('input',function(){if(!s.value) filter();});
    if(sel) sel.addEventListener('change',filter);
  })();
  </script>
  <!-- ============================ PROJECT LIST END ============================ -->

  <!-- ============================ FINAL CTA START ============================ -->
  <section class="cta-final" aria-labelledby="cta-title">
    <div class="cta-final-bg" aria-hidden="true">
      <img src="~/assets/images/hero/hero-02.svg" alt="" width="1280" height="800" loading="lazy">
    </div>
    <div class="container">
      <div class="cta-final-inner">
        <span class="tech-label">Bán phế liệu ngay hôm nay</span>
        <h2 id="cta-title">Dự án tiếp theo là của bạn?</h2>
        <p>Gửi hình cho chúng tôi để nhận báo giá nhanh — hoặc gọi điện, chat Zalo nếu cần gấp.</p>
        <div class="cta-actions">
          <button class="btn btn-primary btn-lg" type="button" data-quote-open>
            <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình nhận giá
          </button>
          <a class="btn btn-outline-light btn-lg" href="/lien-he">
            <i class="bi bi-envelope-fill" aria-hidden="true"></i>Liên hệ ngay
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ FINAL CTA END ============================ -->

</main>
