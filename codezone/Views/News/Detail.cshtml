@model NewsDetailViewModel?
@{
    ViewData["Title"] = Model?.Seo.Title ?? "Chi tiết bài viết";
}

@if (Model is null)
{
  <main>
    <section class="section">
      <div class="container">
        <h1>Không tìm thấy bài viết</h1>
        <a class="link-arrow" href="/tin-tuc">Quay lại tin tức <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
    </section>
  </main>
  return;
}

<main>
  <section class="article-head">
    <div class="container">
      <ol class="breadcrumb-line">
        <li><a href="/">Trang chủ</a></li>
        <li><a href="/tin-tuc">Tin tức</a></li>
        <li aria-current="page">@Model.Post.Title</li>
      </ol>
      <h1>@Model.Post.Title</h1>
      <div class="article-meta">
        <span class="article-cat">@Model.Post.CategoryName</span>
        <span><i class="bi bi-calendar3" aria-hidden="true"></i> <time datetime="@Model.Post.PublishedAt.ToString("yyyy-MM-dd")">@Model.Post.PublishedAt.ToString("dd/MM/yyyy")</time></span>
        <span><i class="bi bi-person-fill" aria-hidden="true"></i> @Model.Post.AuthorName</span>
      </div>
    </div>
  </section>

  <article class="section section--paper pt-0">
    <div class="container container-narrow mx-auto">
      <div class="article-body">
        @Html.Raw(Model.Post.ContentHtml ?? $"<p>{Model.Post.Excerpt}</p>")
      </div>
    </div>
  </article>

  @if (Model.LinkedProducts.Count > 0)
  {
    <section class="section section--surface section--bordered" aria-labelledby="linked-products-title">
      <div class="container">
        <div class="sec-head reveal">
          <span class="sec-label">SEO</span>
          <h2 class="sec-title" id="linked-products-title">Sản phẩm liên kết</h2>
        </div>
        <div class="linked-products reveal">
          @foreach (var product in Model.LinkedProducts)
          {
            <a class="lp-item" href="/phe-lieu/@product.Slug">
              <span class="lp-media">
                <img src="@AssetHelper.NormalizePath(product.ImageUrl)" alt="@product.Name" width="600" height="450" loading="lazy">
              </span>
              <span class="lp-body">
                <span class="news-meta">@product.CategoryName</span>
                <h3>@product.Name</h3>
                @if (!string.IsNullOrWhiteSpace(product.PriceText))
                {
                  <strong class="lp-price">@product.PriceText</strong>
                }
                @if (!string.IsNullOrWhiteSpace(product.ShortDescription))
                {
                  <p>@product.ShortDescription</p>
                }
              </span>
            </a>
          }
        </div>
      </div>
    </section>
  }

  @if (Model.RelatedPosts.Count > 0)
  {
    <section class="section section--surface section--bordered" aria-labelledby="related-title">
      <div class="container">
        <div class="sec-head reveal">
          <span class="sec-label">Đọc tiếp</span>
          <h2 class="sec-title" id="related-title">Bài viết liên quan</h2>
        </div>
        <div class="related-posts reveal">
          @foreach (var post in Model.RelatedPosts)
          {
            <a class="rp-item" asp-area="" asp-controller="News" asp-action="Detail" asp-route-slug="@post.Slug">
              <span class="rp-media">
                <img src="@AssetHelper.NormalizePath(post.CoverImage)" alt="@post.Title" width="600" height="375" loading="lazy">
              </span>
              <span class="rp-body">
                <span class="news-meta">@post.CategoryName · @post.PublishedAt.ToString("dd/MM/yyyy")</span>
                <h3>@post.Title</h3>
              </span>
            </a>
          }
        </div>
      </div>
    </section>
  }
</main>
