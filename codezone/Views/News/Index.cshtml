@model NewsIndexViewModel
@inject ScrapWebsite.Services.Interfaces.ISiteChromeService SiteChromeService
@{
    ViewData["Title"] = Model.Seo.Title;
    var chrome = await SiteChromeService.GetAsync(Context.RequestAborted);
    var featured = Model.Page.Items.FirstOrDefault();
    var rest = Model.Page.Items.ToList();
    if (rest.Count > 0)
    {
        rest.RemoveAt(0);
    }
}

<main>
  @* <section class="page-hero" aria-labelledby="news-hero-title">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="@AssetHelper.NormalizePath(Model.Chrome.HeroImage)" alt="" width="1600" height="900" fetchpriority="high">
    </div>
    <div class="container">
      <div class="page-hero-inner">
        <span class="tech-label">Tin tức</span>
        <h1 id="news-hero-title">@Model.Chrome.HeroTitle</h1>
        <p class="page-hero-desc">@Model.Chrome.HeroDescription</p>
        <ol class="breadcrumb-line">
          <li><a href="/">Trang chủ</a></li>
          <li aria-current="page">Tin tức</li>
        </ol>
      </div>
    </div>
  </section> *@

  <section class="section section--paper" aria-label="Danh sách bài viết">
    <div class="container">
      <!-- Tìm kiếm tin tức - đồng bộ -->
      <div class="cat-filter-bar reveal" style="display:flex; gap:0.6rem; flex-wrap:wrap; align-items:center; background:linear-gradient(180deg,#FFFFFF 0%,#FFFBF5 100%); border:1px solid #F0E6D8; border-radius:12px; padding:0.75rem 0.9rem; box-shadow:0 8px 20px rgba(228,87,15,0.06); margin-bottom:1.25rem;">
        <div style="position:relative; flex:7 1 0; min-width:0;">
          <i class="bi bi-search" style="position:absolute; left:0.85rem; top:50%; transform:translateY(-50%); color:#9AA3AE;"></i>
          <input id="newsSearch" type="search" class="form-control" placeholder="Tìm tin tức: giá phế liệu, kinh nghiệm..." style="padding-left:2.4rem; height:40px; border-radius:10px; border:1px solid #E8E0D6; width:100%;">
        </div>
        <select id="newsCategoryFilter" class="form-select" style="flex:3 1 0; min-width:0; height:40px; border-radius:10px; border:1px solid #E8E0D6;">
          <option value="">Tất cả</option>
          <option value="Bảng giá">Bảng giá</option>
          <option value="Kiến thức">Kiến thức</option>
          <option value="Kinh nghiệm">Kinh nghiệm</option>
        </select>
        <button id="newsFilterBtn" class="btn btn-primary" type="button" style="height:40px; padding:0 1.2rem; border-radius:10px;"><i class="bi bi-funnel-fill"></i> Lọc</button>
      </div>
      @if (featured is not null)
      {
        <a class="news-feature-hero reveal mb-5" asp-area="" asp-controller="News" asp-action="Detail" asp-route-slug="@featured.Slug" data-name="@featured.Title.ToLower()" data-category="@featured.CategoryName.ToLower()">
          <span class="nfh-media">
            <img src="@AssetHelper.NormalizePath(featured.CoverImage)" alt="@featured.Title" width="1200" height="675" loading="lazy">
            <partial name="~/Views/Shared/Partials/Public/_MediaHotlineOverlay.cshtml" model="chrome.Hotline" />
          </span>
          <span class="nfh-body">
            <span class="news-meta">
              <span class="news-cat">@featured.CategoryName</span>
              <span class="news-dot" aria-hidden="true"></span>
              <time datetime="@featured.PublishedAt.ToString("yyyy-MM-dd")">@featured.PublishedAt.ToString("dd/MM/yyyy")</time>
            </span>
            <h2 style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">@(featured.Title.Length>70? featured.Title.Substring(0,70).Trim()+"…": featured.Title)</h2>
            <p style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">@(string.IsNullOrWhiteSpace(featured.Excerpt)?"": (featured.Excerpt.Length>120? featured.Excerpt.Substring(0,120).Trim()+"…": featured.Excerpt))</p>
            <span class="link-arrow">Đọc bài đầy đủ <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
          </span>
        </a>
      }

      <div class="row">
        <div class="col-lg-8">
          <div class="news-rows reveal">
            @foreach (var post in rest)
            {
              var shortTitle = post.Title.Length>55 ? post.Title.Substring(0,55).Trim()+"…": post.Title;
              var shortExcerpt = string.IsNullOrWhiteSpace(post.Excerpt) ? "" : (post.Excerpt.Length>90 ? post.Excerpt.Substring(0,90).Trim()+"…": post.Excerpt);
              <a class="news-row" asp-area="" asp-controller="News" asp-action="Detail" asp-route-slug="@post.Slug" data-name="@post.Title.ToLower()" data-category="@post.CategoryName.ToLower()">
                <span class="news-row-media" style="width:100%; aspect-ratio:16/10; min-height:78px; overflow:hidden; border-radius:8px;">
                  <img src="@AssetHelper.NormalizePath(post.CoverImage)" alt="@post.Title" width="600" height="338" loading="lazy" style="width:100%; height:100%; object-fit:cover; display:block;">
                </span>
                <span class="news-row-body">
                  <span class="news-meta">
                    <span class="news-cat">@post.CategoryName</span>
                    <span aria-hidden="true">·</span>
                    <time datetime="@post.PublishedAt.ToString("yyyy-MM-dd")">@post.PublishedAt.ToString("dd/MM/yyyy")</time>
                  </span>
                  <h3 style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; font-size:1rem; line-height:1.35;">@shortTitle</h3>
                  <p style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; font-size:0.88rem; color:#66707A;">@shortExcerpt</p>
                </span>
              </a>
            }
          </div>
        </div>
        <aside class="col-lg-4">
          <div class="side-col">
            <div class="side-box">
              <h2 class="side-box-title">Bài mới nhất</h2>
              <ul class="side-list">
                @foreach (var post in Model.SidebarPosts)
                {
                  <li>
                    <a asp-area="" asp-controller="News" asp-action="Detail" asp-route-slug="@post.Slug">
                      <img src="@AssetHelper.NormalizePath(post.CoverImage)" alt="" width="144" height="90" loading="lazy">
                      <span>
                        <strong>@post.Title</strong>
                        <small>@post.PublishedAt.ToString("dd/MM/yyyy")</small>
                      </span>
                    </a>
                  </li>
                }
              </ul>
            </div>
            <div class="side-box side-cta">
              <h2 class="side-box-title">Có phế liệu cần bán?</h2>
              <p>Chụp hình phế liệu của bạn gửi cho chúng tôi để nhận báo giá nhanh.</p>
              <button class="btn btn-primary" type="button" data-quote-open><i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình nhận giá</button>
            </div>
          </div>
        </aside>
      </div>
  <script>
  (function(){
    var s=document.getElementById('newsSearch');
    var sel=document.getElementById('newsCategoryFilter');
    var btn=document.getElementById('newsFilterBtn');
    function filter(){
      var q=(s.value||'').toLowerCase().trim();
      var cat=(sel.value||'').toLowerCase().trim();
      document.querySelectorAll('.news-row, .news-feature-hero').forEach(function(el){
        var name=el.getAttribute('data-name')||'';
        var ccat=el.getAttribute('data-category')||'';
        var okName=!q||name.indexOf(q)!==-1;
        var okCat=!cat||ccat.indexOf(cat)!==-1;
        el.style.display=(okName&&okCat)?'':'none';
      });
    }
    if(btn) btn.addEventListener('click',filter);
    if(s) s.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();filter();}});
    if(s) s.addEventListener('input',function(){if(!s.value) filter();});
    if(sel) sel.addEventListener('change',filter);
  })();
  </script>
      @if (Model.Page.Links.Count > 0)
      {
        <nav class="pagination-wrap mt-4" aria-label="Phân trang tin tức">
          <ul class="pagination-industrial">
            @foreach (var link in Model.Page.Links)
            {
              if (link.IsCurrent)
              {
                <li class="page-item active"><span class="page-link" aria-current="page">@link.Label</span></li>
              }
              else if (link.IsDisabled)
              {
                <li class="page-item disabled"><span class="page-link">@link.Label</span></li>
              }
              else
              {
                <li class="page-item">
                  <a class="page-link" asp-area="" asp-controller="News" asp-action="Index" asp-route-cursor="@link.Cursor" asp-route-previousCursor="@link.PreviousCursor" asp-route-page="@link.PageNumber" asp-route-pageSize="@Model.PageSize" rel="@link.Rel">@link.Label</a>
                </li>
              }
            }
          </ul>
        </nav>
      }
    </div>
  </section>
</main>
