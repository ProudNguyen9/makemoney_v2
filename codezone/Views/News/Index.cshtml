@model NewsIndexViewModel
@{
    ViewData["Title"] = Model.Seo.Title;
    var featured = Model.Page.Items.FirstOrDefault();
    var rest = Model.Page.Items.ToList();
    if (rest.Count > 0)
    {
        rest.RemoveAt(0);
    }
}

<main>
  @* <section class="page-hero" aria-labelledby="news-hero-title">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="@AssetHelper.NormalizePath(Model.Chrome.HeroImage)" alt="" width="1600" height="900" fetchpriority="high">
    </div>
    <div class="container">
      <div class="page-hero-inner">
        <span class="tech-label">Tin tức</span>
        <h1 id="news-hero-title">@Model.Chrome.HeroTitle</h1>
        <p class="page-hero-desc">@Model.Chrome.HeroDescription</p>
        <ol class="breadcrumb-line">
          <li><a href="/">Trang chủ</a></li>
          <li aria-current="page">Tin tức</li>
        </ol>
      </div>
    </div>
  </section> *@

  <section class="section section--paper" aria-label="Danh sách bài viết">
    <div class="container">
      @if (featured is not null)
      {
        <a class="news-feature-hero reveal mb-5" asp-area="" asp-controller="News" asp-action="Detail" asp-route-slug="@featured.Slug">
          <span class="nfh-media">
            <img src="@AssetHelper.NormalizePath(featured.CoverImage)" alt="@featured.Title" width="1200" height="675" loading="lazy">
          </span>
          <span class="nfh-body">
            <span class="news-meta">
              <span class="news-cat">@featured.CategoryName</span>
              <span class="news-dot" aria-hidden="true"></span>
              <time datetime="@featured.PublishedAt.ToString("yyyy-MM-dd")">@featured.PublishedAt.ToString("dd/MM/yyyy")</time>
            </span>
            <h2>@featured.Title</h2>
            <p>@featured.Excerpt</p>
            <span class="link-arrow">Đọc bài đầy đủ <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
          </span>
        </a>
      }

      <div class="row">
        <div class="col-lg-8">
          <div class="news-rows reveal">
            @foreach (var post in rest)
            {
              <a class="news-row" asp-area="" asp-controller="News" asp-action="Detail" asp-route-slug="@post.Slug">
                <span class="news-row-media">
                  <img src="@AssetHelper.NormalizePath(post.CoverImage)" alt="@post.Title" width="600" height="338" loading="lazy">
                </span>
                <span class="news-row-body">
                  <span class="news-meta">
                    <span class="news-cat">@post.CategoryName</span>
                    <span aria-hidden="true">·</span>
                    <time datetime="@post.PublishedAt.ToString("yyyy-MM-dd")">@post.PublishedAt.ToString("dd/MM/yyyy")</time>
                  </span>
                  <h3>@post.Title</h3>
                  <p>@post.Excerpt</p>
                </span>
              </a>
            }
          </div>
        </div>
        <aside class="col-lg-4">
          <div class="side-col">
            <div class="side-box">
              <h2 class="side-box-title">Bài mới nhất</h2>
              <ul class="side-list">
                @foreach (var post in Model.SidebarPosts)
                {
                  <li>
                    <a asp-area="" asp-controller="News" asp-action="Detail" asp-route-slug="@post.Slug">
                      <img src="@AssetHelper.NormalizePath(post.CoverImage)" alt="" width="144" height="90" loading="lazy">
                      <span>
                        <strong>@post.Title</strong>
                        <small>@post.PublishedAt.ToString("dd/MM/yyyy")</small>
                      </span>
                    </a>
                  </li>
                }
              </ul>
            </div>
            <div class="side-box side-cta">
              <h2 class="side-box-title">Có phế liệu cần bán?</h2>
              <p>Chụp hình phế liệu của bạn gửi cho chúng tôi để nhận báo giá nhanh.</p>
              <button class="btn btn-primary" type="button" data-quote-open><i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình nhận giá</button>
            </div>
          </div>
        </aside>
      </div>
      @if (Model.Page.Links.Count > 0)
      {
        <nav class="pagination-wrap mt-4" aria-label="Phân trang tin tức">
          <ul class="pagination-industrial">
            @foreach (var link in Model.Page.Links)
            {
              if (link.IsCurrent)
              {
                <li class="page-item active"><span class="page-link" aria-current="page">@link.Label</span></li>
              }
              else if (link.IsDisabled)
              {
                <li class="page-item disabled"><span class="page-link">@link.Label</span></li>
              }
              else
              {
                <li class="page-item">
                  <a class="page-link" asp-area="" asp-controller="News" asp-action="Index" asp-route-cursor="@link.Cursor" asp-route-previousCursor="@link.PreviousCursor" asp-route-page="@link.PageNumber" asp-route-pageSize="@Model.PageSize" rel="@link.Rel">@link.Label</a>
                </li>
              }
            }
          </ul>
        </nav>
      }
    </div>
  </section>
</main>
