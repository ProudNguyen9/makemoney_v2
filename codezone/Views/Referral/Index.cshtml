@{
    ViewData["Title"] = "Chính sách hoa hồng";
}

<main>

  <!-- ============================ PAGE HERO START ============================ -->
  <section class="page-hero" aria-labelledby="ref-hero-title">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="~/assets/images/hero/hero-01.svg" alt="" width="1600" height="900" fetchpriority="high">
    </div>
    <div class="container">
      <div class="page-hero-inner">
        <span class="tech-label">Hoa hồng giới thiệu</span>
        <h1 id="ref-hero-title">Có nguồn phế liệu? Nhận hoa hồng khi giới thiệu</h1>
        <p class="page-hero-desc">
          Bạn biết nhà xưởng, công trình, doanh nghiệp cần thanh lý phế liệu?
          Giới thiệu cho chúng tôi — nhận hoa hồng theo giá trị lô hàng thực tế.
        </p>
        <ol class="breadcrumb-line">
          <li><a href="/">Trang chủ</a></li>
          <li aria-current="page">Chính sách hoa hồng</li>
        </ol>
      </div>
    </div>
  </section>
  <!-- ============================ PAGE HERO END ============================ -->

  <!-- ============================ COMMISSION TABLE START ============================ -->
  <section class="section" aria-labelledby="ref-rate-title">
    <div class="container">
      <div class="sec-head reveal">
        <span class="sec-label">Mức chi trả</span>
        <h2 class="sec-title" id="ref-rate-title">Mức hoa hồng theo giá trị lô hàng</h2>
        <p class="sec-desc">
          Hoa hồng tính trên giá trị lô hàng thực tế nhận sau khi cân — lô càng lớn,
          mức chi trả càng cao. Không giới hạn số nguồn bạn giới thiệu trong tháng.
        </p>
      </div>

      <div class="price-board reveal">
        <div class="table-scroll">
          <table class="commission-table">
            <caption class="visually-hidden">Mức hoa hồng giới thiệu áp dụng theo giá trị lô hàng thu mua</caption>
            <thead>
              <tr>
                <th scope="col">Giá trị lô hàng</th>
                <th scope="col">Mức hoa hồng</th>
                <th scope="col">Ghi chú</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Dưới 10 triệu</td>
                <td><span class="pct">0,5%</span></td>
                <td>Thanh toán sau khi hoàn tất thu gom</td>
              </tr>
              <tr>
                <td>10 – 50 triệu</td>
                <td><span class="pct">1%</span></td>
                <td>Thanh toán sau khi hoàn tất thu gom</td>
              </tr>
              <tr>
                <td>50 – 200 triệu</td>
                <td><span class="pct">1,5%</span></td>
                <td>Thanh toán sau khi hoàn tất thu gom</td>
              </tr>
              <tr>
                <td>Trên 200 triệu</td>
                <td><span class="pct">2%</span></td>
                <td>Thỏa thuận riêng từng hợp đồng</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <p class="small text-muted-2 mt-3 mb-0 reveal">
        * Số liệu mức % là placeholder — backend cập nhật chính sách thật.
      </p>
    </div>
  </section>
  <!-- ============================ COMMISSION TABLE END ============================ -->

  <!-- ============================ REFERRAL PROCESS START ============================ -->
  <section class="section section--surface" aria-labelledby="ref-process-title">
    <div class="container">
      <div class="sec-head reveal">
        <span class="sec-label">Quy trình</span>
        <h2 class="sec-title" id="ref-process-title">Quy trình nhận hoa hồng</h2>
        <p class="sec-desc">Từ lúc gửi thông tin đến khi nhận tiền — tối đa vài ngày làm việc với lô hàng thông thường.</p>
      </div>

      <ol class="process-steps list-unstyled reveal">
        <li class="step-item">
          <span class="step-no" aria-hidden="true">01</span>
          <h3>Giới thiệu</h3>
          <p>Gửi thông tin nguồn hàng qua Zalo [ZALO] hoặc form cuối trang này.</p>
        </li>
        <li class="step-item">
          <span class="step-no" aria-hidden="true">02</span>
          <h3>Tiếp cận</h3>
          <p>Chúng tôi gọi và ra khảo sát — bạn có thể đi cùng để nghe báo giá trực tiếp.</p>
        </li>
        <li class="step-item">
          <span class="step-no" aria-hidden="true">03</span>
          <h3>Chốt giá</h3>
          <p>Thống nhất giá trị lô hàng với bên có phế liệu theo thực tế từng loại.</p>
        </li>
        <li class="step-item">
          <span class="step-no" aria-hidden="true">04</span>
          <h3>Thu gom</h3>
          <p>Hoàn tất cân — vận chuyển — thanh toán cho khách có phế liệu.</p>
        </li>
        <li class="step-item">
          <span class="step-no" aria-hidden="true">05</span>
          <h3>Nhận hoa hồng</h3>
          <p>Chuyển khoản hoa hồng cho bạn trong [3] ngày làm việc.</p>
        </li>
      </ol>
    </div>
  </section>
  <!-- ============================ REFERRAL PROCESS END ============================ -->

  <!-- ============================ TERMS + MINI FORM START ============================ -->
  <section class="section" aria-labelledby="ref-terms-title">
    <div class="container">
      <div class="row row-editorial align-items-start">
        <div class="col-lg-6 reveal">
          <div class="sec-head">
            <span class="sec-label">Quy định</span>
            <h2 class="sec-title" id="ref-terms-title">Điều kiện áp dụng</h2>
            <p class="sec-desc">Năm điều kiện đơn giản để hoa hồng được ghi nhận và chi trả đúng hẹn.</p>
          </div>
          <ul class="list-dash">
            <li>Nguồn hàng chưa từng làm việc với công ty chúng tôi.</li>
            <li>Thông tin nguồn đúng — lô hàng có thật, có quyền quyết định bán.</li>
            <li>Hoa hồng tính trên giá trị thực nhận sau khi cân, không tính trên báo giá ban đầu.</li>
            <li>Một nguồn nhiều lần giới thiệu vẫn được tính cho lần giao dịch đầu tiên.</li>
            <li>Không áp dụng cho nhân viên và đối tác nội bộ của công ty.</li>
          </ul>
          <p class="small text-muted-2 mb-0">
            Có thắc mắc về điều kiện? Gọi <a href="tel:[HOTLINE]">[HOTLINE]</a> — chúng tôi giải thích rõ trước khi bạn gửi giới thiệu.
          </p>
        </div>

        <div class="col-lg-6 reveal">
          <div class="quote-panel">
            <h3 class="quote-panel-title">Giới thiệu nguồn hàng</h3>
            <p class="quote-panel-sub">Điền ba thông tin — nhân viên liên hệ lại trong [30 phút].</p>
            <form action="#" novalidate>
              <div class="form-field mb-3">
                <label class="form-label-tech" for="ref-name">Họ tên</label>
                <input class="form-control" type="text" id="ref-name" name="ref_name" placeholder="Tên người nhận hoa hồng">
              </div>
              <div class="form-field mb-3">
                <label class="form-label-tech" for="ref-phone">Số điện thoại</label>
                <input class="form-control" type="tel" id="ref-phone" name="ref_phone" placeholder="09xx xxx xxx">
              </div>
              <div class="form-field mb-3">
                <label class="form-label-tech" for="ref-source">Mô tả nguồn hàng</label>
                <textarea class="form-control" id="ref-source" name="ref_source" rows="2" placeholder="VD: xưởng cơ khí ở Biên Hòa, đang thanh lý khoảng 3 tấn sắt + vài tủ điện cũ"></textarea>
              </div>
              <button class="btn btn-primary" type="submit">
                <i class="bi bi-send-fill" aria-hidden="true"></i>Gửi giới thiệu
              </button>
              <p class="small text-muted-2 mb-0 mt-3">
                Hoặc nhắn Zalo trực tiếp: <a href="https://zalo.me/[ZALO]" class="fw-semibold">[ZALO]</a>
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ TERMS + MINI FORM END ============================ -->

  <!-- ============================ FAQ START ============================ -->
  <section class="section section--surface" aria-labelledby="ref-faq-title">
    <div class="container">
      <div class="row row-editorial">
        <div class="col-lg-4 reveal">
          <div class="sec-head">
            <span class="sec-label">Hỏi đáp</span>
            <h2 class="sec-title" id="ref-faq-title">Câu hỏi về hoa hồng giới thiệu</h2>
            <p class="sec-desc">Chưa rõ chỗ nào? Gọi <a href="tel:[HOTLINE]">[HOTLINE]</a> — trả lời thẳng, không vòng vo.</p>
          </div>
        </div>
        <div class="col-lg-8">
          <!-- FAQ LIST START -->
          <div class="accordion faq-accordion reveal" id="faqReferral">
            <div class="accordion-item">
              <h3 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqRef1" aria-expanded="true" aria-controls="faqRef1">
                  Khi nào tôi nhận được hoa hồng?
                </button>
              </h3>
              <div id="faqRef1" class="accordion-collapse collapse show" data-bs-parent="#faqReferral">
                <div class="accordion-body">
                  Sau khi lô hàng hoàn tất thu gom và chúng tôi đã thanh toán cho bên bán,
                  hoa hồng được chuyển khoản cho bạn trong [3] ngày làm việc. Với hợp đồng lớn có nhiều đợt thu gom,
                  hoa hồng chi trả theo từng đợt tương ứng.
                </div>
              </div>
            </div>
            <div class="accordion-item">
              <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqRef2" aria-expanded="false" aria-controls="faqRef2">
                  Hoa hồng nhận bằng hình thức nào?
                </button>
              </h3>
              <div id="faqRef2" class="accordion-collapse collapse" data-bs-parent="#faqReferral">
                <div class="accordion-body">
                  Mặc định chuyển khoản về số tài khoản bạn cung cấp. Nếu bạn ở gần kho,
                  có thể nhận tiền mặt trực tiếp tại văn phòng — báo trước qua Zalo để chúng tôi chuẩn bị.
                </div>
              </div>
            </div>
            <div class="accordion-item">
              <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqRef3" aria-expanded="false" aria-controls="faqRef3">
                  Tôi có phải đi cùng khi khảo sát không?
                </button>
              </h3>
              <div id="faqRef3" class="accordion-collapse collapse" data-bs-parent="#faqReferral">
                <div class="accordion-body">
                  Không bắt buộc. Nhưng nếu đi cùng, bạn nghe trực tiếp báo giá và chứng kiến cả quá trình cân —
                  số tiền hoa hồng rõ ràng ngay từ đầu, không phải chờ đối chiếu lại sau.
                </div>
              </div>
            </div>
            <div class="accordion-item">
              <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqRef4" aria-expanded="false" aria-controls="faqRef4">
                  Giới thiệu nhiều lần cùng một nguồn tính sao?
                </button>
              </h3>
              <div id="faqRef4" class="accordion-collapse collapse" data-bs-parent="#faqReferral">
                <div class="accordion-body">
                  Tính cho lần giao dịch đầu tiên. Từ lần sau, nguồn hàng đó đã nằm trong hệ thống khách hàng của công ty —
                  bạn hãy giữ liên hệ, chúng tôi ưu tiên chia sẻ nguồn mới cho người giới thiệu lâu năm.
                </div>
              </div>
            </div>
          </div>
          <!-- FAQ LIST END -->
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ FAQ END ============================ -->

  <!-- ============================ FINAL CTA START ============================ -->
  <section class="cta-final" aria-labelledby="ref-cta-title">
    <div class="cta-final-bg" aria-hidden="true">
      <img src="~/assets/images/hero/hero-02.svg" alt="" width="1280" height="800" loading="lazy">
    </div>
    <div class="container">
      <div class="cta-final-inner">
        <span class="tech-label">Giới thiệu — nhận hoa hồng</span>
        <h2 id="ref-cta-title">Có nguồn hàng ngay bây giờ?</h2>
        <p>Nhắn Zalo [ZALO] kèm thông tin nguồn — phản hồi trong [30 phút].</p>
        <div class="cta-actions">
          <a class="btn btn-primary btn-lg" href="https://zalo.me/[ZALO]" target="_blank" rel="noopener">
            <i class="bi bi-chat-dots-fill" aria-hidden="true"></i>Nhắn Zalo ngay
          </a>
          <a class="btn btn-outline-light btn-lg" href="tel:[HOTLINE]">
            <i class="bi bi-telephone-fill" aria-hidden="true"></i>[HOTLINE]
          </a>
          <button class="btn btn-outline-light btn-lg" type="button" data-quote-open>
            <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình nhận giá
          </button>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ FINAL CTA END ============================ -->

</main>
