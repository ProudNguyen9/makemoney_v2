@{
    ViewData["Title"] = "Chi tiết dịch vụ";
    var service = (ScrapWebsite.Controllers.ServiceDetailDto)(ViewData["Service"]
        ?? new ScrapWebsite.Controllers.ServiceDetailDto(0, "Dịch vụ", "", null, null, null));
    var serviceFaq = (codezone.ViewModels.Shared.FaqAccordionViewModel)(ViewData["Faq"] ?? new codezone.ViewModels.Shared.FaqAccordionViewModel("faqServiceDetail", []));
}

<main>

  <!-- ============================ PAGE HERO START ============================ -->
  <section class="page-hero" aria-labelledby="service-hero-title">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="@(string.IsNullOrWhiteSpace(service.CoverImage) ? "/assets/images/projects/project-01-cover.svg" : service.CoverImage)" alt="" width="1600" height="900" fetchpriority="high">
    </div>
    <div class="container">
      <div class="page-hero-inner">
        <span class="tech-label">Dịch vụ</span>
        <h1 id="service-hero-title">@service.Title</h1>
        @if (!string.IsNullOrWhiteSpace(service.Excerpt))
        {
          <p class="page-hero-desc">@service.Excerpt</p>
        }
        <ol class="breadcrumb-line">
          <li><a href="/">Trang chủ</a></li>
          <li><a href="/dich-vu">Dịch vụ</a></li>
          <li aria-current="page">@service.Title</li>
        </ol>
      </div>
    </div>
  </section>
  <!-- ============================ PAGE HERO END ============================ -->

  <!-- ============================ SERVICE CONTENT START ============================ -->
  <section class="section section--paper" aria-label="Chi tiết dịch vụ">
    <div class="container">
      <div class="row row-editorial">
        <div class="col-lg-8 article-body reveal">
          @if (!string.IsNullOrWhiteSpace(service.ContentHtml))
          {
            @Html.Raw(service.ContentHtml)
          }
          else if (!string.IsNullOrWhiteSpace(service.Excerpt))
          {
            <p>@service.Excerpt</p>
          }
          else
          {
            <p>Nội dung dịch vụ đang được cập nhật. Vui lòng liên hệ hotline để được tư vấn trực tiếp.</p>
          }
          <p class="mt-4">
            <a class="btn btn-outline-dark" href="/lien-he"><i class="bi bi-envelope-fill" aria-hidden="true"></i>Nhận báo giá dịch vụ này</a>
          </p>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ SERVICE CONTENT END ============================ -->

  <!-- ============================ FAQ START ============================ -->
  <section class="section section--surface" aria-labelledby="faq-title">
    <div class="container">
      <div class="row row-editorial">
        <div class="col-lg-4 reveal">
          <div class="sec-head">
            <span class="sec-label">Câu hỏi thường gặp</span>
            <h2 class="sec-title" id="faq-title">Khách thường hỏi gì?</h2>
            <p class="sec-desc">Câu của bạn không có trong danh sách — gọi hotline hoặc gửi form liên hệ để được trả lời nhanh.</p>
          </div>
        </div>
        <div class="col-lg-8">
          @await Html.PartialAsync("~/Views/Shared/Partials/Public/_FaqAccordion.cshtml", serviceFaq)
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ FAQ END ============================ -->

  <!-- ============================ FINAL CTA START ============================ -->
  <section class="cta-final" aria-labelledby="cta-title">
    <div class="cta-final-bg" aria-hidden="true">
      <img src="~/assets/images/hero/hero-02.svg" alt="" width="1280" height="800" loading="lazy">
    </div>
    <div class="container">
      <div class="cta-final-inner">
        <span class="tech-label">@service.Title</span>
        <h2 id="cta-title">Cần báo giá cho dịch vụ này?</h2>
        <p>Gửi hình hiện trạng hoặc gọi trực tiếp — chúng tôi phản hồi với mức giá cụ thể trong [30 phút].</p>
        <div class="cta-actions">
          <button class="btn btn-primary btn-lg" type="button" data-quote-open>
            <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình nhận giá
          </button>
          <a class="btn btn-outline-light btn-lg" href="/lien-he">
            <i class="bi bi-envelope-fill" aria-hidden="true"></i>Liên hệ ngay
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ FINAL CTA END ============================ -->

</main>
