@{
    ViewData["Title"] = "Dịch vụ";
    var serviceFaq = (codezone.ViewModels.Shared.FaqAccordionViewModel)(ViewData["Faq"] ?? new codezone.ViewModels.Shared.FaqAccordionViewModel("faqServices", []));
}

<main>

  <!-- ============================ PAGE HERO START ============================ -->
  <section class="page-hero" aria-labelledby="services-hero-title">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="~/assets/images/hero/hero-01.svg" alt="" width="1600" height="900" fetchpriority="high">
    </div>
    <div class="container">
      <div class="page-hero-inner">
        <span class="tech-label">Dịch vụ</span>
        <h1 id="services-hero-title">Dịch vụ thu mua phế liệu chuyên nghiệp</h1>
        <p class="page-hero-desc">
          Sáu nhóm dịch vụ phục vụ cá nhân, doanh nghiệp và công trình — từ lô nhỏ tại nhà
          đến giải phóng mặt bằng nhà xưởng trọn gói.
        </p>
        <ol class="breadcrumb-line">
          <li><a href="/">Trang chủ</a></li>
          <li aria-current="page">Dịch vụ</li>
        </ol>
      </div>
    </div>
  </section>
  <!-- ============================ PAGE HERO END ============================ -->

  <!-- ============================ SERVICE LIST START ============================ -->
  <section class="section section--paper" aria-labelledby="service-list-title">
    <div class="container">
      <div class="sec-head reveal">
        <span class="sec-label">Chọn dịch vụ phù hợp</span>
        <h2 class="sec-title" id="service-list-title">Chúng tôi làm được những gì?</h2>
        <p class="sec-desc">
          Cùng một chữ "thu mua" nhưng mỗi khách hàng cần một cách làm khác nhau.
          Chọn đúng nhóm bên dưới để đọc chi tiết cách thức, quy trình và điều kiện của từng dịch vụ.
        </p>
      </div>

      <div class="service-rows">
        <!-- SERVICE ROW 01 START -->
        <article class="service-row reveal">
          <div class="service-row-copy">
            <span class="service-no">01</span>
            <h2>Thu mua phế liệu tận nơi</h2>
            <p>
              Dành cho cá nhân và hộ kinh doanh có phế liệu tồn tại nhà, tại cửa hàng —
              bạn chụp hình gửi qua Zalo, chúng tôi điều xe và nhân công đến cân tại chỗ.
            </p>
            <ul class="list-dash">
              <li>Nhận lô từ vài chục ký — không ép mua lô lớn</li>
              <li>Có xe tải và nhân công xếp hàng đến tận nơi</li>
              <li>Cân điện tử trước mặt, giao dịch xong trong một buổi</li>
            </ul>
            <a class="link-arrow" href="/dich-vu/thu-mua-tan-noi">Xem chi tiết <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
          </div>
          <div class="service-row-media">
            <img src="~/assets/images/hero/hero-02.svg" alt="Nhân công thu gom và cân phế liệu tận nơi tại nhà khách" width="1200" height="750" loading="lazy">
          </div>
        </article>
        <!-- SERVICE ROW 01 END -->

        <!-- SERVICE ROW 02 START -->
        <article class="service-row service-row--flip reveal">
          <div class="service-row-copy">
            <span class="service-no">02</span>
            <h2>Thu mua phế liệu doanh nghiệp</h2>
            <p>
              Hợp đồng định kỳ cho nhà máy, xưởng cơ khí, doanh nghiệp sản xuất —
              đầy đủ hóa đơn, đối chiếu số liệu theo từng đợt thu gom.
            </p>
            <ul class="list-dash">
              <li>Ký hợp đồng thu mua định kỳ theo tháng hoặc theo quý</li>
              <li>Xuất hóa đơn, chứng từ mua phế liệu đầy đủ</li>
              <li>Đối tác tại các khu công nghiệp Đồng Nai, Bình Dương, TP.HCM</li>
            </ul>
            <a class="link-arrow" href="/dich-vu/thu-mua-tan-noi">Xem chi tiết <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
          </div>
          <div class="service-row-media">
            <img src="~/assets/images/company/company-warehouse.svg" alt="Kho phế liệu của doanh nghiệp chờ thu gom theo hợp đồng" width="1200" height="750" loading="lazy">
          </div>
        </article>
        <!-- SERVICE ROW 02 END -->

        <!-- SERVICE ROW 03 START -->
        <article class="service-row reveal">
          <div class="service-row-copy">
            <span class="service-no">03</span>
            <h2>Thu mua &amp; thanh lý nhà xưởng</h2>
            <p>
              Giải phóng mặt bằng trọn gói: định giá tổng thể, tháo dỡ kết cấu, thu mua phế liệu
              phát sinh và bàn giao mặt bằng sạch trong một hợp đồng duy nhất.
            </p>
            <ul class="list-dash">
              <li>Tháo dỡ và thu mua diễn ra cùng một đội — không qua trung gian</li>
              <li>Giải phóng mặt bằng đúng tiến độ bàn giao cho chủ đất</li>
              <li>Có xe cẩu phục vụ dỡ khung thép, máy móc nặng</li>
            </ul>
            <a class="link-arrow" href="/dich-vu/thu-mua-tan-noi">Xem chi tiết <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
          </div>
          <div class="service-row-media">
            <img src="~/assets/images/projects/project-01-cover.svg" alt="Tháo dỡ và thanh lý nhà xưởng lấy mặt bằng" width="1200" height="750" loading="lazy">
          </div>
        </article>
        <!-- SERVICE ROW 03 END -->

        <!-- SERVICE ROW 04 START -->
        <article class="service-row service-row--flip reveal">
          <div class="service-row-copy">
            <span class="service-no">04</span>
            <h2>Thu mua phế liệu công trình</h2>
            <p>
              Nhận kết cấu thép, tôn lợp, giàn giáo, cây số và phế liệu phát sinh
              từ công trình xây dựng — sửa chữa — cải tạo.
            </p>
            <ul class="list-dash">
              <li>Nhận kết cấu thép, tôn lợp, giàn giáo đủ loại kích thước</li>
              <li>Cắt chia theo yêu cầu của chủ đầu tư trước khi vận chuyển</li>
              <li>Tiến độ thu gom bám theo nhịp công trường, làm ngoài giờ nếu cần</li>
            </ul>
            <a class="link-arrow" href="/dich-vu/thu-mua-tan-noi">Xem chi tiết <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
          </div>
          <div class="service-row-media">
            <img src="~/assets/images/projects/project-02-cover.svg" alt="Thu gom sắt thép phế liệu tại công trình xây dựng" width="1200" height="750" loading="lazy">
          </div>
        </article>
        <!-- SERVICE ROW 04 END -->

        <!-- SERVICE ROW 05 START -->
        <article class="service-row reveal">
          <div class="service-row-copy">
            <span class="service-no">05</span>
            <h2>Thu mua máy móc cũ</h2>
            <p>
              Mua lại motor, máy sản xuất, dây chuyền đã qua sử dụng —
              định giá theo tình trạng máy, có kỹ thuật viên đến kiểm tra và tháo lắp.
            </p>
            <ul class="list-dash">
              <li>Nhận motor, máy sản xuất, dây chuyền, tủ điện nguyên chiếc</li>
              <li>Kỹ thuật định giá theo tình trạng vận hành thực tế</li>
              <li>Tháo lắp an toàn, có bảo hiểm lao động đầy đủ</li>
            </ul>
            <a class="link-arrow" href="/dich-vu/thu-mua-tan-noi">Xem chi tiết <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
          </div>
          <div class="service-row-media">
            <img src="~/assets/images/scrap/scrap-motor.svg" alt="Máy móc cũ và motor chờ định giá thu mua" width="1200" height="750" loading="lazy">
          </div>
        </article>
        <!-- SERVICE ROW 05 END -->

        <!-- SERVICE ROW 06 START -->
        <article class="service-row service-row--flip reveal">
          <div class="service-row-copy">
            <span class="service-no">06</span>
            <h2>Thu gom phế liệu định kỳ</h2>
            <p>
              Lịch thu gom cố định cho nhà máy, văn phòng, chung cư —
              đặt thùng chứa tại chỗ, nhân viên đến đúng hẹn theo tuần hoặc theo tháng.
            </p>
            <ul class="list-dash">
              <li>Lịch thu gom cố định — tuần hoặc tháng, không cần gọi từng lần</li>
              <li>Đặt thùng chứa tại chỗ cho giấy, nhôm, dây điện…</li>
              <li>Bảng báo giá cập nhật gửi khách hàng mỗi tuần</li>
            </ul>
            <a class="link-arrow" href="/dich-vu/thu-mua-tan-noi">Xem chi tiết <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
          </div>
          <div class="service-row-media">
            <img src="~/assets/images/company/company-yard.svg" alt="Sân kho tập kết phế liệu thu gom định kỳ" width="1200" height="750" loading="lazy">
          </div>
        </article>
        <!-- SERVICE ROW 06 END -->
      </div>
    </div>
  </section>
  <!-- ============================ SERVICE LIST END ============================ -->

  <!-- ============================ FAQ START ============================ -->
  <section class="section section--surface" aria-labelledby="faq-title">
    <div class="container">
      <div class="row row-editorial">
        <div class="col-lg-4 reveal">
          <div class="sec-head">
            <span class="sec-label">Câu hỏi thường gặp</span>
            <h2 class="sec-title" id="faq-title">Trước khi dùng dịch vụ</h2>
            <p class="sec-desc">Bốn câu hỏi khách thường hỏi trước khi chốt dịch vụ. Cần trả lời nhanh hơn — gọi <a href="tel:[HOTLINE]">[HOTLINE]</a>.</p>
          </div>
        </div>
        <div class="col-lg-8">
          @await Html.PartialAsync("~/Views/Shared/Partials/Public/_FaqAccordion.cshtml", serviceFaq)
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ FAQ END ============================ -->

  <!-- ============================ FINAL CTA START ============================ -->
  <section class="cta-final" aria-labelledby="cta-title">
    <div class="cta-final-bg" aria-hidden="true">
      <img src="~/assets/images/hero/hero-02.svg" alt="" width="1280" height="800" loading="lazy">
    </div>
    <div class="container">
      <div class="cta-final-inner">
        <span class="tech-label">Bán phế liệu ngay hôm nay</span>
        <h2 id="cta-title">Bạn đang có phế liệu cần thanh lý?</h2>
        <p>Gửi hình cho chúng tôi để nhận báo giá nhanh — hoặc gọi điện, chat Zalo nếu cần gấp.</p>
        <div class="cta-actions">
          <button class="btn btn-primary btn-lg" type="button" data-quote-open>
            <i class="bi bi-camera-fill" aria-hidden="true"></i>Gửi hình nhận giá
          </button>
          <a class="btn btn-outline-light btn-lg" href="tel:[HOTLINE]">
            <i class="bi bi-telephone-fill" aria-hidden="true"></i>[HOTLINE]
          </a>
          <a class="btn btn-outline-light btn-lg" href="https://zalo.me/[ZALO]" target="_blank" rel="noopener">
            <i class="bi bi-chat-dots-fill" aria-hidden="true"></i>Chat Zalo
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- ============================ FINAL CTA END ============================ -->

</main>
